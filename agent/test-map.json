{
  "version": 1,
  "routes": [
    {
      "paths": [
        "crates/jeryu-cache-core/**",
        "crates/jeryu-cache-service/**",
        "crates/jeryu-cache-cli/**",
        "crates/jeryu-cache-adversary/**",
        "crates/jeryu-cache/**",
        "config/**",
        "policies/**"
      ],
      "commands": [
        "cargo test -p jeryu-cache-core -p jeryu-cache-service -p jeryu-cache-adversary",
        "cargo test -p jeryu-cache-cli",
        "./tests/cache_poisoning_matrix.sh"
      ],
      "proof_lane": "cache-law"
    },
    {
      "paths": [
        "crates/jeryu-gitd/**",
        "configs/**"
      ],
      "commands": [
        "cargo test -p jeryu-gitd",
        "./ops/git-oracle/smoke.sh"
      ],
      "proof_lane": "git-oracle"
    },
    {
      "paths": [
        "crates/jeryu-core/**",
        "crates/jeryu-api/**",
        "web/**"
      ],
      "commands": [
        "cargo test -p jeryu-core -p jeryu-api"
      ],
      "proof_lane": "api-compat"
    },
    {
      "paths": [
        "crates/jeryu-ci-ir/**",
        "crates/jeryu-ci-compiler/**",
        "crates/jeryu-ci-scheduler/**",
        "crates/jeryu-cache-policy/**",
        "crates/jeryu-artifact-metadata/**",
        "bins/jeryu-ci-bin/**"
      ],
      "commands": [
        "cargo test -p jeryu-ci-ir -p jeryu-ci-compiler -p jeryu-ci-scheduler -p jeryu-cache-policy -p jeryu-artifact-metadata",
        "cargo test -p jeryu-ci-bin"
      ],
      "proof_lane": "jeryu-ci-ir"
    },
    {
      "paths": [
        "crates/jeryu-runner-core/**",
        "crates/jeryu-runner-native/**",
        "crates/jeryu-runner-microvm/**",
        "crates/jeryu-runner-oci/**",
        "crates/jeryu-runner-protocol/**",
        "crates/jeryu-runnerd/**"
      ],
      "commands": [
        "cargo test -p jeryu-runner-core -p jeryu-runner-native -p jeryu-runner-microvm -p jeryu-runner-oci -p jeryu-runner-protocol -p jeryu-runnerd",
        "./tests/sandbox_escape_matrix.sh"
      ],
      "proof_lane": "runner-sandbox"
    },
    {
      "paths": [
        "crates/jeryu-rustjet/**",
        "crates/jeryu-rustjet-cli/**",
        "fixtures/**"
      ],
      "commands": [
        "cargo test -p jeryu-rustjet -p jeryu-rustjet-cli",
        "./scripts/check-fixtures.py"
      ],
      "proof_lane": "jeryu-rustjet"
    },
    {
      "paths": [
        "crates/jeryu-proof/**",
        "crates/jeryu-agentbridge/**",
        "agent/**"
      ],
      "commands": [
        "cargo test -p jeryu-proof -p jeryu-agentbridge",
        "./scripts/check-agent-maps.py"
      ],
      "proof_lane": "jankurai-proof"
    },
    {
      "paths": [
        "crates/jeryu-signrail/**"
      ],
      "commands": [
        "cargo test -p jeryu-signrail"
      ],
      "proof_lane": "release-provenance"
    },
    {
      "paths": [
        "crates/jeryu-mirror/**",
        "crates/jeryu-mirror-cli/**"
      ],
      "commands": [
        "cargo test -p jeryu-mirror -p jeryu-mirror-cli"
      ],
      "proof_lane": "migration-replay"
    },
    {
      "paths": [
        "crates/jeryu-bench/**",
        "crates/jeryu-obs/**",
        "dashboards/**"
      ],
      "commands": [
        "cargo test -p jeryu-bench -p jeryu-obs"
      ],
      "proof_lane": "benchmark-receipts"
    },
    {
      "paths": [
        "crates/jeryu-enterprise/**",
        "crates/jeryu-phase11-core/**",
        "crates/jeryu-phase11-audit/**",
        "crates/jeryu-ops/**",
        "crates/jeryu-compliance-export/**",
        "crates/jeryu-lifecycle/**",
        "crates/jeryu-tenant/**",
        "crates/jeryu-replay-verifier/**",
        "crates/jeryu-kernel/**",
        "bins/jeryu-phase11-bin/**"
      ],
      "commands": [
        "cargo test -p jeryu-enterprise -p jeryu-phase11-core -p jeryu-phase11-audit -p jeryu-ops -p jeryu-compliance-export -p jeryu-lifecycle -p jeryu-tenant -p jeryu-replay-verifier -p jeryu-kernel",
        "cargo test -p jeryu-phase11-bin"
      ],
      "proof_lane": "enterprise-ops"
    },
    {
      "paths": [
        "ops/**",
        "scripts/**",
        "tests/**",
        "examples/**",
        "Justfile",
        "Cargo.toml",
        "rust-toolchain.toml"
      ],
      "commands": [
        "./scripts/ci-doctor.sh",
        "./scripts/check-owner-test-map.py"
      ],
      "proof_lane": "devex"
    },
    {
      "paths": [
        "docs/**",
        "README.md",
        "AGENTS.md"
      ],
      "commands": [
        "./scripts/check-docs.py"
      ],
      "proof_lane": "docs"
    },
    {
      "paths": [
        "bins/**"
      ],
      "commands": [
        "cargo test -p jeryu-ci-bin -p jeryu-phase11-bin"
      ],
      "proof_lane": "tooling"
    },
    {
      "paths": [
        "crates/**"
      ],
      "commands": [
        "cargo test --workspace"
      ],
      "proof_lane": "workspace"
    },
    {
      "paths": [
        "config/**"
      ],
      "commands": [
        "./scripts/ci-doctor.sh"
      ],
      "proof_lane": "policy-config"
    },
    {
      "paths": [
        "configs/**"
      ],
      "commands": [
        "./scripts/ci-doctor.sh"
      ],
      "proof_lane": "runtime-config"
    },
    {
      "paths": [
        "policies/**"
      ],
      "commands": [
        "./scripts/ci-doctor.sh",
        "./scripts/render-policy-docs.sh"
      ],
      "proof_lane": "policy-docs"
    },
    {
      "paths": [
        "fixtures/**"
      ],
      "commands": [
        "./scripts/check-fixtures.py"
      ],
      "proof_lane": "fixtures"
    },
    {
      "paths": [
        "examples/**"
      ],
      "commands": [
        "./scripts/ci-doctor.sh"
      ],
      "proof_lane": "examples"
    },
    {
      "paths": [
        "tests/**"
      ],
      "commands": [
        "./scripts/ci-doctor.sh"
      ],
      "proof_lane": "tests"
    }
  ]
}
