{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.neverhuman.org/jeryu/jeryu-tool/schemas/security-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "checks", "artifacts", "findings"],
  "properties": {
    "schema_version": { "const": "jeryu.tool.security/v1" },
    "status": { "enum": ["pass", "fail"] },
    "checks": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sbom"],
      "properties": {
        "sbom": { "const": "target/security/sbom.spdx.json" }
      }
    },
    "findings": { "type": "array" }
  }
}
