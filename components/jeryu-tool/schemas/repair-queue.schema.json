{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jankurai.dev/schemas/repair-queue.schema.json",
  "title": "Jankurai repair queue item",
  "description": "One JSONL record emitted by the pinned Jankurai repair queue for a bounded agent rerun.",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "priority", "task", "why"],
  "properties": {
    "path": { "type": "string", "minLength": 1 },
    "priority": { "type": "string", "minLength": 1 },
    "rule_id": { "type": "string" },
    "tlr": { "type": "string" },
    "lane": { "type": "string" },
    "owner": { "type": "string" },
    "task": { "type": "string", "minLength": 1 },
    "why": { "type": "string", "minLength": 1 }
  }
}
