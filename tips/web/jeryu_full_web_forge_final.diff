### 3.9 Add `src/web/ws.rs`

```rust
use axum::{extract::{ws::{Message, WebSocket, WebSocketUpgrade}, State}, response::IntoResponse};
use futures_util::{SinkExt, StreamExt};

use super::state::WebState;

pub async fn events_ws(State(state): State<WebState>, ws: WebSocketUpgrade) -> impl IntoResponse {
    ws.on_upgrade(move |socket| handle_socket(state, socket))
}

async fn handle_socket(state: WebState, socket: WebSocket) {
    let (mut sender, mut receiver) = socket.split();
    let mut events = state.activity.subscribe();

    let hello = serde_json::json!({
        "type": "hello",
        "server_time": chrono::Utc::now().to_rfc3339(),
    });
    let _ = sender.send(Message::Text(hello.to_string().into())).await;

    loop {
        tokio::select! {
            Ok(event) = events.recv() => {
                let msg = serde_json::json!({ "type": "event", "event": event });
                if sender.send(Message::Text(msg.to_string().into())).await.is_err() {
                    break;
                }
            }
            incoming = receiver.next() => {
                match incoming {
                    Some(Ok(Message::Text(text))) if text == "ping" => {
                        let _ = sender.send(Message::Text("pong".into())).await;
                    }
                    Some(Ok(Message::Close(_))) | None => break,
                    _ => {}
                }
            }
        }
    }
}
```

