```rust
use ammonia::Builder;
use anyhow::Result;
use serde::Serialize;

#[derive(Debug, Clone)]
pub struct RenderContext<'a> {
    pub owner: &'a str,
    pub repo: &'a str,
    pub ref_name: &'a str,
    pub base_path: &'a str,
}

#[derive(Debug, Clone, Serialize)]
pub struct TocItem {
    pub level: u8,
    pub id: String,
    pub title: String,
}

#[derive(Debug, Clone, Serialize)]
pub struct ResolvedLink {
    pub href: String,
    pub resolved: String,
}

#[derive(Debug, Clone, Serialize)]
pub struct RenderedMarkdown {
    pub html: String,
    pub toc: Vec<TocItem>,
    pub links: Vec<ResolvedLink>,
}

pub fn render_markdown(input: &str, ctx: RenderContext<'_>) -> Result<RenderedMarkdown> {
    let mut options = comrak::Options::default();
    options.extension.table = true;
    options.extension.strikethrough = true;
    options.extension.tasklist = true;
    options.extension.autolink = true;
    options.extension.header_ids = Some(String::new());
    options.render.unsafe_ = false;

    let raw = comrak::markdown_to_html(input, &options);
    let clean = Builder::default()
        .add_tags(["article", "section", "details", "summary", "input"])
        .add_tag_attributes("input", ["type", "checked", "disabled"])
        .clean(&raw)
        .to_string();

    let html = format!("<article class=\"markdown-body\" data-owner=\"{}\" data-repo=\"{}\" data-ref=\"{}\">{}</article>",
        html_escape(ctx.owner), html_escape(ctx.repo), html_escape(ctx.ref_name), clean);

    Ok(RenderedMarkdown { html, toc: vec![], links: vec![] })
}

fn html_escape(value: &str) -> String {
    value.replace('&', "&amp;").replace('<', "&lt;").replace('>', "&gt;").replace('"', "&quot;")
}
```

