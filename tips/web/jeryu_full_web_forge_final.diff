  if (readme.isError) return <EmptyState title="No README rendered" description="Add README.md to show project documentation here." />;

  return <MarkdownHtml html={readme.data.html} />;
}
```

### 5.8 Add `apps/web/src/realtime/ActivitySocketProvider.tsx`

```tsx
import { QueryClient } from '@tanstack/react-query';
import { createContext, useEffect, useMemo, useState } from 'react';

type ActivitySocketContextValue = { connected: boolean };
export const ActivitySocketContext = createContext<ActivitySocketContextValue>({ connected: false });

export function ActivitySocketProvider({ queryClient, children }: { queryClient: QueryClient; children: React.ReactNode }) {
  const [connected, setConnected] = useState(false);

  useEffect(() => {
    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const ws = new WebSocket(`${protocol}//${window.location.host}/api/events/ws?scope=global`);

    ws.onopen = () => setConnected(true);
    ws.onclose = () => setConnected(false);
    ws.onmessage = (message) => {
      const parsed = JSON.parse(message.data);
      if (parsed.type !== 'event') return;
      const topic = parsed.event.topic as string;
      if (topic.startsWith('repo.')) queryClient.invalidateQueries({ queryKey: ['repos'] });
      if (topic.startsWith('mr.')) queryClient.invalidateQueries({ queryKey: ['merge-requests'] });
      if (topic.startsWith('issue.')) queryClient.invalidateQueries({ queryKey: ['issues'] });
      if (topic.startsWith('pipeline.') || topic.startsWith('job.')) queryClient.invalidateQueries({ queryKey: ['pipelines'] });
    };

    return () => ws.close();
  }, [queryClient]);

  const value = useMemo(() => ({ connected }), [connected]);
  return <ActivitySocketContext.Provider value={value}>{children}</ActivitySocketContext.Provider>;
}
```

