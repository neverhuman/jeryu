### 6.1 `src/web/mod.rs`

```rust
//! Owner: Browser Web Gateway
//! Proof: `cargo nextest run -p jeryu -- web` and `npm --workspace apps/web run build`
//! Invariants: UI/API gateway never bypasses typed API models or state::Db boundaries.

pub mod auth;
pub mod errors;
pub mod extractors;
pub mod markdown;
pub mod openapi;
pub mod pagination;
pub mod permissions;
pub mod router;
pub mod sse;
pub mod state;
pub mod static_assets;
pub mod ws;

pub mod handlers;

use anyhow::Result;
use std::net::SocketAddr;
use std::path::PathBuf;

pub async fn serve(
    bind: String,
    dist: Option<PathBuf>,
    api_only: bool,
    open: bool,
    state: state::WebState,
) -> Result<()> {
    let addr: SocketAddr = bind.parse()?;
    let app = router::build_router(state, dist, api_only);

    if open {
        tracing::info!(%bind, "web UI requested browser open");
        // Optional: use `open` crate later; keep no-op first to avoid desktop assumptions.
    }

    let listener = tokio::net::TcpListener::bind(addr).await?;
    tracing::info!(%bind, "starting jeryu web gateway");
    axum::serve(listener, app).await?;
    Ok(())
}
```

### 6.2 `src/web/router.rs`

```rust
use axum::{routing::{get, post, patch, delete}, Router};
use tower_http::{cors::CorsLayer, trace::TraceLayer};

use super::state::WebState;

pub fn build_router(state: WebState, dist: Option<std::path::PathBuf>, api_only: bool) -> Router {
    let api = Router::new()
        .route("/health", get(super::handlers::me::health))
        .route("/me", get(super::handlers::me::me))
        .route("/workspace/overview", get(super::handlers::repos::workspace_overview))
        .route("/repos", get(super::handlers::repos::list_repos).post(super::handlers::repos::create_repo))
        .route("/repos/{owner}/{repo}", get(super::handlers::repos::get_repo).patch(super::handlers::repos::update_repo).delete(super::handlers::repos::delete_repo))
        .route("/repos/{owner}/{repo}/readme", get(super::handlers::markdown::readme))
        .route("/repos/{owner}/{repo}/tree/{ref}/{*path}", get(super::handlers::code::tree))
        .route("/repos/{owner}/{repo}/blob/{ref}/{*path}", get(super::handlers::code::blob))
        .route("/repos/{owner}/{repo}/raw/{ref}/{*path}", get(super::handlers::code::raw))
        .route("/repos/{owner}/{repo}/merge-requests", get(super::handlers::merge_requests::list).post(super::handlers::merge_requests::create))
        .route("/repos/{owner}/{repo}/merge-requests/{iid}", get(super::handlers::merge_requests::get).patch(super::handlers::merge_requests::update))
        .route("/repos/{owner}/{repo}/merge-requests/{iid}/approve", post(super::handlers::reviews::approve))
        .route("/actions/preview", post(super::handlers::actions::preview))
        .route("/actions/execute", post(super::handlers::actions::execute))
        .route("/events", get(super::handlers::events::list))
        .route("/ws", get(super::ws::upgrade))
        .route("/sse", get(super::sse::stream))
        .with_state(state.clone());

    let mut app = Router::new()
        .nest("/api/v1", api)
        .layer(CorsLayer::permissive())
        .layer(TraceLayer::new_for_http());

    if !api_only {
