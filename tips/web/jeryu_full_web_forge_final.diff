pub fn render_markdown(raw: &str, link_base: &MarkdownLinkBase) -> anyhow::Result<RenderedMarkdown> {
    let mut options = pulldown_cmark::Options::empty();
    options.insert(pulldown_cmark::Options::ENABLE_TABLES);
    options.insert(pulldown_cmark::Options::ENABLE_TASKLISTS);
    options.insert(pulldown_cmark::Options::ENABLE_STRIKETHROUGH);
    options.insert(pulldown_cmark::Options::ENABLE_FOOTNOTES);

    let parser = pulldown_cmark::Parser::new_ext(raw, options);
    let mut html = String::new();
    pulldown_cmark::html::push_html(&mut html, parser);

    let html = rewrite_relative_links(&html, link_base)?;
    let html = ammonia::Builder::default()
        .add_tags(["input", "details", "summary"])
        .add_generic_attributes(["class", "id", "aria-label"])
        .clean(&html)
        .to_string();

    Ok(RenderedMarkdown {
        raw: raw.to_string(),
        toc: extract_toc(raw),
        html,
        warnings: vec![],
    })
}
