+import { useQuery } from '@tanstack/react-query';
+import { api } from '../../api/client';
+import type { MarkdownRenderResponse } from '../../api/dto';
+
+export function MarkdownPanel({ owner, repo, refName }: { owner: string; repo: string; refName: string }) {
+  const readme = useQuery({
+    queryKey: ['readme', owner, repo, refName],
+    queryFn: () => api.get<MarkdownRenderResponse>(`/repos/${owner}/${repo}/readme/${refName}`),
+  });
+
+  if (readme.isLoading) return <div className="card">Rendering README…</div>;
+  if (readme.error) return <div className="card danger">README unavailable.</div>;
+  if (!readme.data) return null;
+
+  return (
+    <article className="markdown-card">
+      <div className="markdown-body" dangerouslySetInnerHTML={{ __html: readme.data.html }} />
+    </article>
+  );
+}


