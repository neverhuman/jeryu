--- /dev/null
+++ b/apps/web/src/realtime/socket.ts
@@
+import type { WebEventEnvelope } from '../api/dto';
+
+export type WebSocketState = 'idle' | 'connecting' | 'open' | 'closed' | 'error';
+
+export class RealtimeClient extends EventTarget {
+  private ws?: WebSocket;
+  private topics = new Set<string>();
+  private lastSeq = Number(localStorage.getItem('jeryu:lastSeq') ?? '0');
+
+  connect() {
+    if (this.ws && this.ws.readyState <= WebSocket.OPEN) return;
+    const scheme = location.protocol === 'https:' ? 'wss' : 'ws';
+    this.ws = new WebSocket(`${scheme}://${location.host}/ws?after_seq=${this.lastSeq}`);
+    this.ws.onopen = () => {
+      this.dispatchEvent(new CustomEvent('state', { detail: 'open' }));
+      if (this.topics.size) this.send({ type: 'subscribe', topics: [...this.topics] });
+    };
+    this.ws.onmessage = (message) => {
+      const event = JSON.parse(message.data) as WebEventEnvelope;
+      if (event.type === 'event') {
+        this.lastSeq = Math.max(this.lastSeq, event.seq);
+        localStorage.setItem('jeryu:lastSeq', String(this.lastSeq));
+        this.dispatchEvent(new CustomEvent('event', { detail: event }));
+        this.send({ type: 'ack', seq: this.lastSeq });
+      }
+    };
+    this.ws.onclose = () => {
+      this.dispatchEvent(new CustomEvent('state', { detail: 'closed' }));
+      setTimeout(() => this.connect(), 1200);
+    };
+    this.ws.onerror = () => this.dispatchEvent(new CustomEvent('state', { detail: 'error' }));
+  }
+
+  subscribe(topics: string[]) {
+    topics.forEach((topic) => this.topics.add(topic));
+    this.send({ type: 'subscribe', topics });
+  }
+
+  unsubscribe(topics: string[]) {
+    topics.forEach((topic) => this.topics.delete(topic));
+    this.send({ type: 'unsubscribe', topics });
+  }
+
+  private send(frame: unknown) {
+    if (this.ws?.readyState === WebSocket.OPEN) this.ws.send(JSON.stringify(frame));
+  }
+}
+
+export const realtime = new RealtimeClient();


