+import { useEffect, useState } from 'react';
+import { realtime } from '../realtime/socket';
+import type { WebEventEnvelope } from '../api/dto';
+
+export function ActivityRail() {
+  const [events, setEvents] = useState<WebEventEnvelope[]>([]);
+
+  useEffect(() => {
+    realtime.connect();
+    realtime.subscribe(['global', 'repos', 'runner:*']);
+    const onEvent = (event: Event) => {
+      const detail = (event as CustomEvent<WebEventEnvelope>).detail;
+      setEvents((prev) => [detail, ...prev].slice(0, 50));
+    };
+    realtime.addEventListener('event', onEvent);
+    return () => realtime.removeEventListener('event', onEvent);
+  }, []);
+
+  return (
+    <aside className="activity-rail" aria-label="Live activity">
+      <h2>Live</h2>
+      {events.map((event) => (
+        <article key={event.id} className="activity-item">
+          <strong>{event.kind}</strong>
+          <span>{event.topic}</span>
+        </article>
+      ))}
+    </aside>
+  );
+}


