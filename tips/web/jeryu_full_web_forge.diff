+    Ok(Json(BlobResponse {
+        repo: format!("{owner}/{repo}"),
+        ref_name,
+        path: path.clone(),
+        oid: text.oid,
+        size: text.text.len() as u64,
+        is_binary: false,
+        mime: mime_guess::from_path(&path).first_or_octet_stream().to_string(),
+        text: Some(text.text),
+        raw_url: format!("/api/v1/repos/{owner}/{repo}/raw/HEAD/{path}"),
+    }))
+}
