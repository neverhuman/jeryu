+++ b/src/web/ws.rs
@@
+use axum::{extract::{State, WebSocketUpgrade, ws::{Message, WebSocket}}, response::Response};
+use futures_util::{SinkExt, StreamExt};
+use crate::api::web::ClientWsFrame;
+use super::state::WebState;
+
+pub async fn ws_handler(State(state): State<WebState>, ws: WebSocketUpgrade) -> Response {
+    ws.on_upgrade(move |socket| handle_socket(state, socket))
+}
+
+async fn handle_socket(state: WebState, socket: WebSocket) {
+    let (mut tx, mut rx) = socket.split();
+    let mut events = state.events.subscribe();
+
+    let writer = tokio::spawn(async move {
+        while let Ok(event) = events.recv().await {
+            if let Ok(text) = serde_json::to_string(&event) {
+                if tx.send(Message::Text(text.into())).await.is_err() { break; }
+            }
+        }
+    });
+
+    while let Some(Ok(message)) = rx.next().await {
+        if let Message::Text(text) = message {
+            match serde_json::from_str::<ClientWsFrame>(&text) {
+                Ok(ClientWsFrame::Subscribe { topics }) => tracing::debug!(?topics, "ws subscribe"),
+                Ok(ClientWsFrame::Unsubscribe { topics }) => tracing::debug!(?topics, "ws unsubscribe"),
+                Ok(ClientWsFrame::Ack { seq }) => tracing::debug!(seq, "ws ack"),
+                Ok(ClientWsFrame::Ping { .. }) => {}
+                Err(err) => tracing::debug!(error = %err, "invalid ws frame"),
+            }
+        }
+    }
+    writer.abort();
+}


