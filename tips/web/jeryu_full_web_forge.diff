+//! Owner: Web CLI command dispatch
+//! Proof: `cargo check -p jeryu --message-format=json`
+//! Invariants: CLI dispatch only wires arguments into `jeryu::web`; no business logic here.
+
+use anyhow::Result;
+use crate::cli::{WebCommands, WebServeArgs};
+use jeryu::{docker, gitlab_client, state, web};
+
+pub(crate) async fn execute_web_commands(command: WebCommands) -> Result<i32> {
+    match command {
+        WebCommands::Serve(args) => serve(args).await,
+        WebCommands::BuildSchema(args) => {
+            web::openapi::write_schema(args.json).await?;
+            Ok(0)
+        }
+        WebCommands::Settings(args) => {
+            let settings = jeryu::settings::get();
+            if args.json {
+                println!("{}", serde_json::to_string_pretty(&settings.web)?);
+            } else {
+                println!("web.bind={} static_dir={}", settings.web.bind, settings.web.static_dir);
+            }
+            Ok(0)
+        }
+    }
+}
+
+async fn serve(args: WebServeArgs) -> Result<i32> {
+    jeryu::repo_fleet::ensure_workspace_root_default();
+    let db = state::Db::open().await?;
+    let docker = docker::DockerCtl::connect().unwrap_or_else(|_| docker::DockerCtl::disconnected());
+    let gitlab_url = format!("http://localhost:{}", jeryu::config::GITLAB_HTTP_PORT);
+    let gitlab_token = jeryu::gitlab_auth::load_token_for_url(&gitlab_url).ok().flatten();
+    let client = gitlab_client::GitlabClient::new(&gitlab_url, gitlab_token);
+    let overrides = web::config::WebRuntimeOverrides {
+        bind: args.bind.clone(),
+        static_dir: args.static_dir.clone(),
+        dev_proxy_url: args.dev_proxy_url.clone(),
+        cors_origins: args.cors_origin.clone(),
+    };
+    let config = web::config::WebRuntimeConfig::from_settings_and_overrides(jeryu::settings::get(), &overrides);
+    web::serve(web::WebServerInput { db, docker, client, config, with_engine: args.with_engine }).await?;
+    Ok(0)
+}


