+pub mod releases;
+pub mod repo_files;
+pub mod repository;
+pub mod reviews;
+pub mod router;
+pub mod search;
+pub mod settings;
+pub mod state;
+pub mod static_assets;
+pub mod ws;
+
+use anyhow::Result;
+use crate::{docker::DockerCtl, gitlab_client::GitlabClient, state::Db};
+
+#[derive(Clone)]
+pub struct WebServerInput {
+    pub db: Db,
+    pub docker: DockerCtl,
+    pub client: GitlabClient,
+    pub config: config::WebRuntimeConfig,
+    pub with_engine: bool,
+}
+
+pub async fn serve(input: WebServerInput) -> Result<()> {
+    let state = state::WebState::new(input.db, input.docker, input.client, input.config.clone()).await?;
+    if input.with_engine {
+        let engine_state = state.clone();
+        tokio::spawn(async move {
+            if let Err(err) = crate::engine::run_engine(
+                engine_state.db.clone(),
+                engine_state.docker.clone(),
+                engine_state.gitlab.clone(),
+                String::new(),
+            ).await {
+                tracing::error!(error = %err, "web-managed engine loop failed");
+            }
+        });
+    }
+    let app = router::build_router(state.clone());
+    let listener = tokio::net::TcpListener::bind(&state.config.bind).await?;
+    tracing::info!(addr = %state.config.bind, "starting JeRyu Forge web server");
+    axum::serve(listener, app).await?;
+    Ok(())
+}


