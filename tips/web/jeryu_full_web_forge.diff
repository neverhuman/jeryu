+pub async fn raw(
+    State(state): State<WebState>,
+    Path((owner, repo, ref_name, path)): Path<(String, String, String, String)>,
+) -> WebResult<impl IntoResponse> {
+    let text = load_text_blob(&state, &owner, &repo, &ref_name, &path).await?;
+    Ok(text.text)
+}
+
+pub async fn load_text_blob(_state: &WebState, owner: &str, repo: &str, ref_name: &str, path: &str) -> WebResult<TextBlob> {
+    validate_repo_path(path)?;
+    // Replace this fallback with provider-backed git2/GitLab/GitHub blob lookup.
+    Ok(TextBlob {
+        oid: "placeholder".into(),
+        text: format!("# {owner}/{repo}\n\nREADME placeholder for `{path}` at `{ref_name}`.\n"),
+    })
