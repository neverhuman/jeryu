+use axum::{extract::{Path, State}, Json};
+use chrono::Utc;
+use pulldown_cmark::{html, Options, Parser};
+use crate::api::forge::{MarkdownCacheState, MarkdownRenderResponse, MarkdownTocItem};
+use super::{error::WebResult, state::WebState};
+
+pub async fn readme(
+    State(state): State<WebState>,
+    Path((owner, repo, ref_name)): Path<(String, String, String)>,
+) -> WebResult<Json<MarkdownRenderResponse>> {
+    // MVP lookup order. Later add README.mdx/rst/txt fallback.
+    let source = crate::web::repo_files::load_text_blob(&state, &owner, &repo, &ref_name, "README.md").await?;
+    Ok(Json(render_markdown_response(format!("{owner}/{repo}"), ref_name, "README.md".into(), source.oid, source.text)))
+}
+
+#[derive(serde::Deserialize)]
+pub struct RenderRequest {
+    pub repo: Option<String>,
+    pub ref_name: Option<String>,
+    pub path: Option<String>,
+    pub markdown: String,
+}
+
+pub async fn render(Json(input): Json<RenderRequest>) -> WebResult<Json<MarkdownRenderResponse>> {
+    Ok(Json(render_markdown_response(
+        input.repo.unwrap_or_else(|| "inline".into()),
+        input.ref_name.unwrap_or_else(|| "HEAD".into()),
+        input.path.unwrap_or_else(|| "README.md".into()),
+        "inline".into(),
+        input.markdown,
+    )))
+}
+
+pub fn render_markdown_response(repo: String, ref_name: String, path: String, blob_sha: String, markdown: String) -> MarkdownRenderResponse {
+    let mut options = Options::empty();
+    options.insert(Options::ENABLE_TABLES);
+    options.insert(Options::ENABLE_TASKLISTS);
+    options.insert(Options::ENABLE_STRIKETHROUGH);
+    options.insert(Options::ENABLE_FOOTNOTES);
+    let parser = Parser::new_ext(&markdown, options);
+    let mut html_out = String::new();
+    html::push_html(&mut html_out, parser);
+    let clean = ammonia::Builder::default()
+        .add_tags(["details", "summary", "kbd"])
+        .clean(&html_out)
+        .to_string();
+    MarkdownRenderResponse {
+        repo,
+        ref_name,
+        path,
+        blob_sha,
+        html: clean,
+        toc: Vec::<MarkdownTocItem>::new(),
+        warnings: Vec::new(),
+        rendered_at: Utc::now(),
+        cache: MarkdownCacheState::Miss,
+    }
+}


