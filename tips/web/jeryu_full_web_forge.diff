+use axum::{routing::{get, post, patch, delete}, Router};
+use tower_http::{cors::CorsLayer, trace::TraceLayer};
+use super::state::WebState;
+
+pub fn build_router(state: WebState) -> Router {
+    let api = Router::new()
+        .route("/health", get(super::admin::health))
+        .route("/session", get(super::auth::session))
+        .route("/repos", get(super::repository::list_repos).post(super::repository::create_repo))
+        .route("/repos/import", post(super::repository::import_repo))
+        .route("/repos/:owner/:repo", get(super::repository::get_repo).patch(super::repository::update_repo).delete(super::repository::delete_repo))
+        .route("/repos/:owner/:repo/activity", get(super::repository::activity))
+        .route("/repos/:owner/:repo/tree/:ref/*path", get(super::repo_files::tree))
+        .route("/repos/:owner/:repo/blob/:ref/*path", get(super::repo_files::blob))
+        .route("/repos/:owner/:repo/raw/:ref/*path", get(super::repo_files::raw))
+        .route("/repos/:owner/:repo/readme/:ref", get(super::markdown::readme))
+        .route("/markdown/render", post(super::markdown::render))
+        .route("/repos/:owner/:repo/mrs", get(super::merge_requests::list).post(super::merge_requests::create))
+        .route("/repos/:owner/:repo/mrs/:iid", get(super::merge_requests::detail).patch(super::merge_requests::update))
+        .route("/repos/:owner/:repo/mrs/:iid/diff", get(super::merge_requests::diff))
+        .route("/repos/:owner/:repo/mrs/:iid/blockers", get(super::merge_requests::blockers))
+        .route("/repos/:owner/:repo/mrs/:iid/reviews", post(super::reviews::submit_review))
+        .route("/repos/:owner/:repo/mrs/:iid/approve", post(super::reviews::approve))
+        .route("/repos/:owner/:repo/mrs/:iid/request-changes", post(super::reviews::request_changes))
+        .route("/repos/:owner/:repo/mrs/:iid/merge", post(super::merge_requests::merge))
+        .route("/repos/:owner/:repo/settings/general", get(super::settings::get_general).patch(super::settings::patch_general))
+        .route("/events", get(super::events::list_events))
+        .route("/notifications", get(super::notifications::list))
+        .route("/audit", get(super::audit::list));
+
+    Router::new()
+        .nest("/api/v1", api)
+        .route("/ws", get(super::ws::ws_handler))
+        .fallback(super::static_assets::spa_fallback)
+        .layer(TraceLayer::new_for_http())
+        .layer(CorsLayer::permissive())
+        .with_state(state)
+}


