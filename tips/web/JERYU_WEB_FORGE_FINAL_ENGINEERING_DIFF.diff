+++ b/apps/web/src/api/ws.ts
@@
+import type { WebEvent } from './types';
+
+type Handler = (event: WebEvent) => void;
+
+export class JeryuWebSocket {
+  private socket?: WebSocket;
+  private cursor = Number(localStorage.getItem('jeryu:lastCursor') ?? '0');
+  private topics = new Set<string>();
+  private handlers = new Set<Handler>();
+  private closedByUser = false;
+
+  constructor(private readonly url: string) {}
+
+  connect() {
+    const url = new URL(this.url, window.location.href);
+    if (this.cursor > 0) url.searchParams.set('cursor', String(this.cursor));
+    if (this.topics.size > 0) url.searchParams.set('topics', [...this.topics].join(','));
+
+    this.socket = new WebSocket(url);
+    this.socket.onmessage = (message) => this.handleFrame(JSON.parse(String(message.data)));
+    this.socket.onclose = () => {
+      if (!this.closedByUser) window.setTimeout(() => this.connect(), 1000);
+    };
+  }
+
+  close() {
+    this.closedByUser = true;
+    this.socket?.close();
+  }
+
+  subscribe(topics: string[]) {
+    topics.forEach((topic) => this.topics.add(topic));
+    this.send({ type: 'subscribe', topics });
+  }
+
+  onEvent(handler: Handler) {
+    this.handlers.add(handler);
+    return () => this.handlers.delete(handler);
+  }
+
+  private handleFrame(frame: any) {
+    if (frame.type === 'event') {
+      const event = frame.event as WebEvent;
+      this.cursor = event.seq;
+      localStorage.setItem('jeryu:lastCursor', String(this.cursor));
+      this.handlers.forEach((handler) => handler(event));
+      this.send({ type: 'ack', cursor: this.cursor });
+    } else if (frame.type === 'gap') {
+      window.dispatchEvent(new CustomEvent('jeryu:ws-gap', { detail: frame }));
+    }
+  }
+
+  private send(payload: unknown) {
+    if (this.socket?.readyState === WebSocket.OPEN) this.socket.send(JSON.stringify(payload));
+  }
+}


