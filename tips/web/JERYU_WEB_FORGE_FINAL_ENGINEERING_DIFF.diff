+use axum::{extract::{Path, Query, State}, Json};
+use comrak::{markdown_to_html, Options};
+use serde::Deserialize;
+
+use crate::api::markdown::RenderedMarkdown;
+
+use super::{errors::{WebError, WebResult}, state::WebState};
+
+#[derive(Debug, Deserialize)]
+pub struct RenderQuery { pub r#ref: Option<String>, pub path: Option<String> }
+
+pub async fn readme(State(state): State<WebState>, Path(repo_id): Path<String>) -> WebResult<Json<RenderedMarkdown>> {
+    render_markdown_for_path(&state, &repo_id, "main", "README.md").await.map(Json)
+}
+
+pub async fn rendered_path(State(state): State<WebState>, Path(repo_id): Path<String>, Query(query): Query<RenderQuery>) -> WebResult<Json<RenderedMarkdown>> {
+    let ref_name = query.r#ref.unwrap_or_else(|| "main".into());
+    let path = query.path.unwrap_or_else(|| "README.md".into());
+    render_markdown_for_path(&state, &repo_id, &ref_name, &path).await.map(Json)
+}
+
+pub async fn render_markdown_for_path(_state: &WebState, repo_id: &str, ref_name: &str, path: &str) -> WebResult<RenderedMarkdown> {
+    // Implementation binding points:
+    // 1. Resolve repo/ref/path using repo_browser service.
+    // 2. Read blob bytes and enforce max_bytes.
+    // 3. Check web_markdown_cache by blob_sha+renderer_version.
+    // 4. Render, sanitize, rewrite links, cache, return.
+    let markdown = format!("# {}\n\nREADME rendering is wired; bind this placeholder to git blob content.", path);
+    let mut options = Options::default();
+    options.extension.table = true;
+    options.extension.strikethrough = true;
+    options.extension.tasklist = true;
+    options.extension.autolink = true;
+    let html = markdown_to_html(&markdown, &options);
+    let html = ammonia::Builder::default().clean(&html).to_string();
+    Ok(RenderedMarkdown {
+        repo_id: repo_id.into(),
+        ref_name: ref_name.into(),
+        commit_sha: "HEAD".into(),
+        path: path.into(),
+        blob_sha: "placeholder".into(),
+        html,
+        toc: vec![],
+        links: vec![],
+        warnings: vec![],
+    })
+}
+
+fn reject_path_traversal(path: &str) -> WebResult<()> {
+    if path.contains("..") || path.starts_with('/') { return Err(WebError::BadRequest("invalid path".into())); }
+    Ok(())
+}


