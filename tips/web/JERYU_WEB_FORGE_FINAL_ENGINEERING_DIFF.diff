+++ b/src/web/event_hub.rs
@@
+use std::{collections::VecDeque, sync::{Arc, atomic::{AtomicU64, Ordering}}};
+
+use tokio::sync::{broadcast, RwLock};
+
+use crate::api::web_event::WebEvent;
+
+#[derive(Clone)]
+pub struct EventHub {
+    cursor: Arc<AtomicU64>,
+    retention: usize,
+    tx: broadcast::Sender<WebEvent>,
+    ring: Arc<RwLock<VecDeque<WebEvent>>>,
+}
+
+impl EventHub {
+    pub fn new(settings: crate::settings::RealtimeSettings) -> Self {
+        let (tx, _) = broadcast::channel(settings.max_client_queue.max(128));
+        Self { cursor: Arc::new(AtomicU64::new(0)), retention: settings.replay_window_events.max(1024), tx, ring: Arc::new(RwLock::new(VecDeque::new())) }
+    }
+
+    pub fn current_cursor(&self) -> u64 { self.cursor.load(Ordering::Relaxed) }
+
+    pub async fn publish(&self, mut event: WebEvent) {
+        event.seq = self.cursor.fetch_add(1, Ordering::SeqCst) + 1;
+        let mut ring = self.ring.write().await;
+        ring.push_back(event.clone());
+        while ring.len() > self.retention { ring.pop_front(); }
+        let _ = self.tx.send(event);
+    }
+
+    pub fn subscribe(&self) -> broadcast::Receiver<WebEvent> { self.tx.subscribe() }
+
+    pub async fn replay_after(&self, cursor: u64) -> Vec<WebEvent> {
+        self.ring.read().await.iter().filter(|e| e.seq > cursor).cloned().collect()
+    }
+}


