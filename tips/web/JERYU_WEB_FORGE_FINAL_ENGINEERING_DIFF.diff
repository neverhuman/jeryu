@@
+use axum::{extract::{Query, State, ws::{Message, WebSocket, WebSocketUpgrade}}, response::IntoResponse};
+use chrono::Utc;
+use futures_util::{SinkExt, StreamExt};
+use serde::Deserialize;
+
+use crate::api::web_event::{ClientWsFrame, ServerWsFrame};
+
+use super::state::WebState;
+
+#[derive(Debug, Deserialize)]
+pub struct WsQuery { pub cursor: Option<u64>, pub topics: Option<String> }
+
+pub async fn ws_handler(State(state): State<WebState>, Query(query): Query<WsQuery>, ws: WebSocketUpgrade) -> impl IntoResponse {
+    ws.on_upgrade(move |socket| serve_socket(state, query, socket))
+}
+
+async fn serve_socket(state: WebState, query: WsQuery, socket: WebSocket) {
+    let (mut sender, mut receiver) = socket.split();
+    let connection_id = format!("ws_{}", uuid::Uuid::new_v4());
+    let hello = ServerWsFrame::Hello {
+        connection_id,
+        server_time: Utc::now(),
+        cursor: state.event_hub.current_cursor(),
+        heartbeat_ms: state.settings.realtime.heartbeat_ms,
+        replay_supported: true,
+        max_topics: state.settings.realtime.max_topics_per_connection,
+    };
+    let _ = sender.send(Message::Text(serde_json::to_string(&hello).unwrap())).await;
+
+    if let Some(cursor) = query.cursor {
+        for event in state.event_hub.replay_after(cursor).await {
+            let frame = ServerWsFrame::Event { event };
+            let _ = sender.send(Message::Text(serde_json::to_string(&frame).unwrap())).await;
+        }
+    }
+
+    let mut rx = state.event_hub.subscribe();
+    loop {
+        tokio::select! {
+            Ok(event) = rx.recv() => {
+                let frame = ServerWsFrame::Event { event };
+                if sender.send(Message::Text(serde_json::to_string(&frame).unwrap())).await.is_err() { break; }
+            }
+            Some(Ok(msg)) = receiver.next() => {
+                if let Message::Text(text) = msg {
+                    if let Ok(ClientWsFrame::Ping { nonce }) = serde_json::from_str::<ClientWsFrame>(&text) {
+                        let frame = ServerWsFrame::Pong { nonce, server_time: Utc::now() };
+                        let _ = sender.send(Message::Text(serde_json::to_string(&frame).unwrap())).await;
+                    }
+                }
+            }
+            else => break,
+        }
+    }
+}


