+import DOMPurify from 'dompurify';
+import type { RenderedMarkdown } from '@/api/types';
+
+export function MarkdownView({ markdown }: { markdown: RenderedMarkdown }) {
+  // Server-side sanitization is authoritative. DOMPurify is defense-in-depth
+  // against accidental unsafe regression or proxy corruption.
+  const safe = DOMPurify.sanitize(markdown.html, { USE_PROFILES: { html: true } });
+  return (
+    <article className="markdown-card">
+      <div className="markdown-toolbar">
+        <strong>{markdown.path}</strong>
+        <button>Rendered</button>
+        <button>Source</button>
