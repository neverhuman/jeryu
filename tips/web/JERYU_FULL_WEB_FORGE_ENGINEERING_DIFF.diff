+use axum::{extract::{Path, State}, Json};
+use crate::api::repository::{CreateRepositoryRequest, GitProvider, HealthState, RepoCapabilities, RepoCounts, RepoHealth, RepoVisibility, RepositoryDetail, RepositorySummary};
+use crate::web::{error::{WebError, WebResult}, event_hub, state::WebState};
+
+pub async fn list_repositories(State(_state): State<WebState>) -> WebResult<Json<serde_json::Value>> {
+    let repositories = vec![sample_repo("local", "jeryu")];
+    Ok(Json(serde_json::json!({ "repositories": repositories })))
+}
+
+pub async fn get_repository(Path(repo): Path<String>, State(_state): State<WebState>) -> WebResult<Json<RepositoryDetail>> {
+    let summary = parse_repo_slug(&repo).map(|(owner, name)| sample_repo(&owner, &name))
+        .ok_or_else(|| WebError::BadRequest(format!("invalid repo slug: {repo}")))?;
+    Ok(Json(RepositoryDetail {
+        summary,
+        clone_urls: crate::api::repository::CloneUrls { http: None, ssh: None, local_path: None },
+        counts: RepoCounts { branches: 1, tags: 0, open_merge_requests: 0, open_issues: 0 },
+        capabilities: RepoCapabilities { code_browser: true, merge_requests: true, issues: true, ci: true, agents: true, settings: true },
+    }))
+}
+
+pub async fn create_repository(
+    State(state): State<WebState>,
+    Json(request): Json<CreateRepositoryRequest>,
+) -> WebResult<Json<RepositorySummary>> {
+    let summary = RepositorySummary {
+        id: format!("repo_{}_{}", request.owner, request.name),
+        provider: request.provider,
+        owner: request.owner.clone(),
+        name: request.name.clone(),
+        slug: format!("{}/{}", request.owner, request.name),
+        description: request.description,
+        family: request.family,
+        visibility: request.visibility,
+        default_branch: "main".into(),
+        last_activity_at: Some(chrono::Utc::now()),
+        health: RepoHealth { state: HealthState::Green, score: 100, failing_checks: 0, open_merge_requests: 0, pending_approvals: 0, stale_agents: 0 },
+    };
+    state.events().emit(event_hub::event("repo.created", "global", "repository", &summary.id, serde_json::json!({"slug": summary.slug})));
+    Ok(Json(summary))
+}
+
+pub async fn update_repository(Path(_repo): Path<String>) -> WebResult<Json<serde_json::Value>> {
+    Ok(Json(serde_json::json!({ "ok": true })))
+}
+
+pub async fn import_repository(State(_state): State<WebState>) -> WebResult<Json<serde_json::Value>> {
+    Ok(Json(serde_json::json!({ "job_id": "import_demo" })))
+}
+
+fn parse_repo_slug(slug: &str) -> Option<(String, String)> {
+    let (owner, name) = slug.split_once('/')?;
+    Some((owner.to_string(), name.to_string()))
+}
+
+fn sample_repo(owner: &str, name: &str) -> RepositorySummary {
+    RepositorySummary {
+        id: format!("repo_{owner}_{name}"),
+        provider: GitProvider::Local,
+        owner: owner.into(),
+        name: name.into(),
+        slug: format!("{owner}/{name}"),
+        description: Some("Agent-first Git control plane repository".into()),
+        family: Some(owner.into()),
+        visibility: RepoVisibility::Private,
+        default_branch: "main".into(),
+        last_activity_at: Some(chrono::Utc::now()),
+        health: RepoHealth { state: HealthState::Green, score: 96, failing_checks: 0, open_merge_requests: 0, pending_approvals: 0, stale_agents: 0 },
+    }
+}
