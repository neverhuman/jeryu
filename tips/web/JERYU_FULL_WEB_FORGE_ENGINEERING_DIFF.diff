diff --git a/apps/web/src/design/tokens.css b/apps/web/src/design/tokens.css
new file mode 100644
index 0000000..1779afe
--- /dev/null
+++ b/apps/web/src/design/tokens.css
@@ -0,0 +1,143 @@
+:root {
+  color-scheme: dark light;
+  --bg: #090c10;
+  --panel: #111722;
+  --panel-strong: #18202f;
+  --text: #f4f7fb;
+  --muted: #9aa8bb;
+  --border: #273244;
+  --accent: #7dd3fc;
+  --danger: #fb7185;
+  --success: #86efac;
+  --warning: #facc15;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+
+* { box-sizing: border-box; }
+body { margin: 0; background: var(--bg); color: var(--text); }
+a { color: inherit; }
+.app-shell { min-height: 100vh; display: grid; grid-template-columns: 260px minmax(0, 1fr) 340px; }
+.app-sidebar { border-right: 1px solid var(--border); padding: 20px; background: #080b10; }
+.brand { display: block; font-weight: 800; font-size: 24px; margin-bottom: 24px; text-decoration: none; }
+.app-sidebar nav { display: grid; gap: 8px; }
+.app-sidebar nav a { text-decoration: none; color: var(--muted); padding: 8px 10px; border-radius: 8px; }
+.app-sidebar nav a:hover { background: var(--panel); color: var(--text); }
+.app-main { min-width: 0; }
+.app-topbar { height: 64px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 16px; padding: 0 20px; }
+.app-content { padding: 24px; }
+.activity-rail { border-left: 1px solid var(--border); background: #0c1119; padding: 20px; }
+.page-stack { display: grid; gap: 20px; }
+.page-header, .repo-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
+.page-header h1, .repo-header h1 { margin: 0; font-size: 32px; }
+.page-header p, .repo-header p { margin: 6px 0 0; color: var(--muted); }
+.button { border: 1px solid var(--border); background: var(--panel); color: var(--text); border-radius: 8px; padding: 8px 12px; text-decoration: none; }
+.button-primary { background: var(--accent); color: #071016; border-color: transparent; font-weight: 700; }
+.panel { background: var(--panel); border: 1px solid var(--border); border-radius: 14px; padding: 16px; }
+.panel-danger { border-color: var(--danger); }
+.repo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
+.repo-card { background: var(--panel); border: 1px solid var(--border); border-radius: 14px; padding: 16px; text-decoration: none; display: grid; gap: 10px; }
+.repo-card:hover { border-color: var(--accent); }
+.repo-card-title { font-weight: 700; }
+.repo-card-description { color: var(--muted); min-height: 38px; }
+.repo-card-meta { display: flex; gap: 10px; color: var(--muted); font-size: 12px; }
+.repo-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 20px; }
+.dashboard-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
+.markdown-body { line-height: 1.62; }
+.markdown-body pre { overflow: auto; padding: 14px; background: #06080c; border-radius: 10px; border: 1px solid var(--border); }
+.markdown-body code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
+.markdown-body img { max-width: 100%; }
+.markdown-warnings { border: 1px solid var(--warning); color: var(--warning); padding: 10px; border-radius: 8px; margin-bottom: 14px; }
