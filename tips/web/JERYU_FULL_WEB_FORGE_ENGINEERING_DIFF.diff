@@ -0,0 +1,98 @@
+use axum::{extract::State, Json};
+use pulldown_cmark::{html, Options, Parser};
+use crate::api::markdown_projection::{RenderMarkdownRequest, RenderedMarkdown};
+use crate::web::{error::WebResult, state::WebState};
+
+pub async fn render_markdown_endpoint(
+    State(_state): State<WebState>,
+    Json(request): Json<RenderMarkdownRequest>,
+) -> WebResult<Json<RenderedMarkdown>> {
+    Ok(Json(render_markdown(&request.markdown)))
+}
+
+pub fn render_markdown(markdown: &str) -> RenderedMarkdown {
+    let mut options = Options::empty();
+    options.insert(Options::ENABLE_TABLES);
+    options.insert(Options::ENABLE_FOOTNOTES);
+    options.insert(Options::ENABLE_STRIKETHROUGH);
+    options.insert(Options::ENABLE_TASKLISTS);
+    let parser = Parser::new_ext(markdown, options);
+    let mut raw_html = String::new();
+    html::push_html(&mut raw_html, parser);
+
+    let html = ammonia::Builder::default()
+        .add_tags(["input", "table", "thead", "tbody", "tr", "td", "th"])
+        .add_generic_attributes(["class", "id", "aria-label", "aria-hidden"])
+        .clean(&raw_html)
+        .to_string();
+
+    RenderedMarkdown { html, toc: vec![], warnings: vec![], cache_key: None }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn strips_script_tags() {
+        let rendered = render_markdown("# Hi\n<script>alert(1)</script>");
+        assert!(rendered.html.contains("<h1>Hi</h1>"));
+        assert!(!rendered.html.contains("script"));
+    }
+}
