+-- JeRyu Web Forge core tables
+CREATE TABLE IF NOT EXISTS web_users (
+  id TEXT PRIMARY KEY,
+  login TEXT NOT NULL UNIQUE,
+  display_name TEXT NOT NULL,
+  avatar_url TEXT,
+  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
+);
+
+CREATE TABLE IF NOT EXISTS web_sessions (
+  id TEXT PRIMARY KEY,
+  user_id TEXT NOT NULL REFERENCES web_users(id) ON DELETE CASCADE,
+  token_hash TEXT NOT NULL UNIQUE,
+  expires_at TEXT NOT NULL,
+  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  last_seen_at TEXT
+);
+
+CREATE TABLE IF NOT EXISTS web_repositories (
+  id TEXT PRIMARY KEY,
+  provider TEXT NOT NULL CHECK (provider IN ('local','gitlab','github')),
+  provider_project_id TEXT,
+  owner_slug TEXT NOT NULL,
+  name TEXT NOT NULL,
+  slug TEXT NOT NULL UNIQUE,
+  family TEXT,
+  description TEXT,
+  visibility TEXT NOT NULL CHECK (visibility IN ('private','internal','public')),
+  default_branch TEXT NOT NULL DEFAULT 'main',
+  local_path TEXT,
+  state TEXT NOT NULL DEFAULT 'active' CHECK (state IN ('active','archived','importing','failed','deleting')),
