+use jeryu::web::markdown::render_markdown;
+
+#[test]
+fn markdown_renderer_sanitizes_script_tags() {
+    let rendered = render_markdown("# Hello\n<script>alert('x')</script>");
+    assert!(rendered.html.contains("Hello"));
+    assert!(!rendered.html.contains("script"));
+}
+
+#[test]
+fn markdown_renderer_supports_tables_and_task_lists() {
+    let rendered = render_markdown("| A | B |\n|---|---|\n| 1 | 2 |\n\n- [x] done");
+    assert!(rendered.html.contains("<table>"));
+    assert!(rendered.html.contains("checkbox"));
+}
