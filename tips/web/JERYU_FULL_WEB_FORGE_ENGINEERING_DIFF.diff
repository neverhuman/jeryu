+//! Owner: Browser forge BFF
+//! Proof: `cargo nextest run -p jeryu -- web_`
+//! Invariants:
+//!   - All mutating routes pass through RBAC and action preview/execute.
+//!   - Markdown HTML is sanitized before it reaches the browser.
+//!   - WebSocket fanout never blocks domain writes.
+
+pub mod actions;
+pub mod audit;
+pub mod auth;
+pub mod config;
+pub mod csrf;
+pub mod error;
+pub mod event_hub;
+pub mod issues;
+pub mod markdown;
+pub mod merge_requests;
+pub mod notifications;
+pub mod openapi;
+pub mod rbac;
+pub mod repo_admin;
+pub mod repo_browser;
+pub mod reviews;
+pub mod router;
+pub mod search;
+pub mod settings;
+pub mod state;
+pub mod static_assets;
+pub mod ws;
+
+pub use config::WebConfig;
+pub use state::WebState;
+
+use anyhow::Result;
+
+pub async fn serve(state: WebState) -> Result<()> {
+    let bind = state.config.bind;
+    let app = router::router(state);
+    let listener = tokio::net::TcpListener::bind(bind).await?;
+    tracing::info!(%bind, "starting JeRyu Web");
+    axum::serve(listener, app).await?;
+    Ok(())
+}
