+import { useQuery } from '@tanstack/react-query';
+import { Link } from 'react-router-dom';
+import { webApi } from '../../api/client';
+
+export function RepositoriesPage() {
+  const { data, isLoading, error } = useQuery({
+    queryKey: ['repos'],
+    queryFn: () => webApi.repos(),
+  });
+
+  if (isLoading) return <div className="panel">Loading repositories…</div>;
+  if (error) return <div className="panel panel-danger">Failed to load repositories: {String(error)}</div>;
+
+  return (
+    <section className="page-stack">
+      <header className="page-header">
+        <div>
+          <h1>All repositories</h1>
+          <p>Live fleet view across local, GitLab, and GitHub-backed repositories.</p>
+        </div>
+        <Link className="button button-primary" to="/repos/new">New repository</Link>
+      </header>
+      <div className="repo-grid">
+        {data?.repositories.map((repo) => (
+          <Link className="repo-card" key={repo.id} to={`/${repo.owner}/${repo.name}`}>
+            <div className="repo-card-title">{repo.slug}</div>
+            <div className="repo-card-description">{repo.description ?? 'No description yet'}</div>
+            <div className="repo-card-meta">
+              <span>{repo.provider}</span>
+              <span>{repo.visibility}</span>
+              <span className={`health-${repo.health.state}`}>{repo.health.score}</span>
+            </div>
+          </Link>
+        ))}
+      </div>
+    </section>
+  );
