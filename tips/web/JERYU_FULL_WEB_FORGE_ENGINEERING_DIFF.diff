@@ -0,0 +1,63 @@
+use axum::{extract::State, Json};
+use crate::api::web_dto::{ActionChange, ActionPreviewRequest, ActionPreviewResponse, ActionRisk};
+use crate::web::{error::WebResult, state::WebState};
+
+pub async fn preview_action(
+    State(_state): State<WebState>,
+    Json(request): Json<ActionPreviewRequest>,
+) -> WebResult<Json<ActionPreviewResponse>> {
+    Ok(Json(ActionPreviewResponse {
+        preview_id: format!("preview_{}", uuid::Uuid::new_v4()),
+        risk: classify_risk(&request.action),
+        required_permission: required_permission(&request.action).into(),
+        summary: format!("Preview {} on {}:{}", request.action, request.resource_kind, request.resource_id),
+        changes: vec![ActionChange { field: "status".into(), before: None, after: Some("pending".into()) }],
+        confirmation_phrase: None,
+    }))
+}
+
+pub async fn execute_action(State(_state): State<WebState>, Json(body): Json<serde_json::Value>) -> WebResult<Json<serde_json::Value>> {
+    Ok(Json(serde_json::json!({ "ok": true, "receipt_id": uuid::Uuid::new_v4().to_string(), "request": body })))
+}
+
+fn classify_risk(action: &str) -> ActionRisk {
+    if action.contains("delete") || action.contains("secret") { ActionRisk::Critical }
+    else if action.contains("merge") || action.contains("approve") || action.contains("settings") { ActionRisk::High }
+    else { ActionRisk::Medium }
+}
+
+fn required_permission(action: &str) -> &'static str {
+    if action.contains("merge") { "mr.merge" }
+    else if action.contains("approve") { "mr.approve" }
+    else if action.contains("settings") { "settings.write" }
+    else { "repo.write" }
+}
