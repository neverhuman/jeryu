@@ -0,0 +1,87 @@
+use axum::{routing::{get, post}, Router};
+use tower_http::{compression::CompressionLayer, cors::CorsLayer, trace::TraceLayer};
+use crate::web::{repo_admin, repo_browser, markdown, ws, actions, settings, state::WebState, static_assets};
+
+pub fn router(state: WebState) -> Router {
+    let api = Router::new()
+        .route("/health", get(health))
+        .route("/bootstrap", get(bootstrap))
+        .route("/ws", get(ws::ws_handler))
+        .route("/repos", get(repo_admin::list_repositories).post(repo_admin::create_repository))
+        .route("/repos/import", post(repo_admin::import_repository))
+        .route("/repos/{repo}", get(repo_admin::get_repository).patch(repo_admin::update_repository))
+        .route("/repos/{repo}/readme/{ref_name}", get(repo_browser::get_readme))
+        .route("/repos/{repo}/tree/{ref_name}/{*path}", get(repo_browser::get_tree))
+        .route("/repos/{repo}/blob/{ref_name}/{*path}", get(repo_browser::get_blob))
+        .route("/repos/{repo}/merge-requests", get(crate::web::merge_requests::list_merge_requests))
+        .route("/repos/{repo}/merge-requests/{iid}", get(crate::web::merge_requests::get_merge_request))
+        .route("/repos/{repo}/settings", get(settings::get_repo_settings).patch(settings::update_repo_settings))
+        .route("/markdown/render", post(markdown::render_markdown_endpoint))
+        .route("/actions/preview", post(actions::preview_action))
+        .route("/actions/execute", post(actions::execute_action))
+        .with_state(state.clone());
+
+    Router::new()
+        .nest("/api/web/v1", api)
+        .fallback_service(static_assets::service(state.config().static_dir.clone()))
+        .layer(CompressionLayer::new())
+        .layer(CorsLayer::permissive())
+        .layer(TraceLayer::new_for_http())
+}
+
+async fn health() -> axum::Json<serde_json::Value> {
+    axum::Json(serde_json::json!({"ok": true, "service": "jeryu-web"}))
+}
+
+async fn bootstrap(axum::extract::State(state): axum::extract::State<WebState>) -> axum::Json<crate::api::web_dto::WebBootstrap> {
+    use crate::api::web_dto::{WebBootstrap, WebUser};
+    let mut feature_flags = std::collections::BTreeMap::new();
+    feature_flags.insert("merge_room".into(), true);
+    feature_flags.insert("settings_studio".into(), true);
+    axum::Json(WebBootstrap {
+        version: env!("CARGO_PKG_VERSION").to_string(),
+        websocket_url: format!("{}/api/web/v1/ws", state.config().public_base_url),
+        feature_flags,
+        permissions: vec!["system.admin".into()],
+        user: WebUser {
+            id: "local-admin".into(),
+            display_name: "Local Admin".into(),
+            avatar_url: None,
+            permissions: vec!["system.admin".into()],
+        },
+    })
+}
