+  kind TEXT NOT NULL,
+  subject_kind TEXT NOT NULL,
+  subject_id TEXT NOT NULL,
+  actor_id TEXT,
+  payload_json TEXT NOT NULL,
+  stale INTEGER NOT NULL DEFAULT 0,
+  occurred_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
