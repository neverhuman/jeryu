new file mode 100644
index 0000000..f29ea40
--- /dev/null
+++ b/src/web/event_hub.rs
@@ -0,0 +1,103 @@
+use serde::{Deserialize, Serialize};
+use std::sync::atomic::{AtomicU64, Ordering};
+use tokio::sync::broadcast;
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct WebEvent {
+    pub r#type: String,
+    pub event_id: u64,
+    pub topic: String,
+    pub occurred_at: chrono::DateTime<chrono::Utc>,
+    pub kind: String,
+    pub subject: EventSubject,
+    pub actor: Option<EventActor>,
+    pub payload: serde_json::Value,
+    pub stale: bool,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct EventSubject {
+    pub r#type: String,
+    pub id: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct EventActor {
+    pub r#type: String,
+    pub id: String,
+    pub display: String,
+}
+
+#[derive(Clone)]
+pub struct EventHub {
+    tx: broadcast::Sender<WebEvent>,
+    next_id: std::sync::Arc<AtomicU64>,
+}
+
+impl EventHub {
+    pub fn new(capacity: usize) -> Self {
+        let (tx, _) = broadcast::channel(capacity);
+        Self { tx, next_id: std::sync::Arc::new(AtomicU64::new(1)) }
+    }
+
+    pub fn subscribe(&self) -> broadcast::Receiver<WebEvent> {
+        self.tx.subscribe()
+    }
+
+    pub fn emit(&self, mut event: WebEvent) {
+        event.event_id = self.next_id.fetch_add(1, Ordering::SeqCst);
+        let _ = self.tx.send(event);
+    }
+}
+
+pub fn event(kind: impl Into<String>, topic: impl Into<String>, subject_type: impl Into<String>, subject_id: impl Into<String>, payload: serde_json::Value) -> WebEvent {
+    WebEvent {
+        r#type: "event".into(),
+        event_id: 0,
+        topic: topic.into(),
+        occurred_at: chrono::Utc::now(),
+        kind: kind.into(),
+        subject: EventSubject { r#type: subject_type.into(), id: subject_id.into() },
+        actor: None,
+        payload,
+        stale: false,
+    }
+}
