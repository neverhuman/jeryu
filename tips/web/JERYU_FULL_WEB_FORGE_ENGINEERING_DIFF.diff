+//! Owner: Web CLI commands
+//! Proof: `cargo check -p jeryu`
+
+use anyhow::Result;
+use crate::cli::WebTokenCommands;
+
+pub async fn execute_web_status(url: &str, json: bool) -> Result<i32> {
+    let health_url = format!("{}/api/web/v1/health", url.trim_end_matches('/'));
+    if json {
+        println!(r#"{{"url":"{}","health":"{}"}}"#, url, health_url);
+    } else {
+        println!("JeRyu Web: {url}");
+        println!("Health: {health_url}");
+    }
+    Ok(0)
+}
+
+pub fn execute_web_open(url: &str) -> Result<()> {
+    println!("Open JeRyu Web in a browser: {url}");
+    Ok(())
+}
+
+pub async fn execute_web_token(command: WebTokenCommands) -> Result<i32> {
+    match command {
+        WebTokenCommands::Create { scope, ttl, json } => {
+            let token = format!("jeryu_dev_{}_{}", scope, ttl);
+            if json {
+                println!(r#"{{"token":"{}","scope":"{}","ttl":"{}"}}"#, token, scope, ttl);
+            } else {
+                println!("{token}");
+            }
+        }
+    }
+    Ok(0)
+}
