+import { useQuery } from '@tanstack/react-query';
+import { Link, useParams } from 'react-router-dom';
+import { webApi } from '../../api/client';
+import { MarkdownHtml } from '../markdown/MarkdownHtml';
+
+export function RepoOverviewPage() {
+  const { owner = '', repo = '' } = useParams();
+  const slug = `${owner}/${repo}`;
+  const readme = useQuery({
+    queryKey: ['readme', slug, 'main'],
+    queryFn: () => webApi.readme(slug, 'main'),
+  });
+
+  return (
+    <section className="page-stack">
+      <header className="repo-header">
+        <div>
+          <h1>{slug}</h1>
+          <p>Code, README, CI, reviews, agents, cache, and settings in one place.</p>
+        </div>
+        <div className="repo-actions">
+          <Link className="button" to={`/${owner}/${repo}/merge-requests`}>Merge requests</Link>
+          <Link className="button" to={`/${owner}/${repo}/settings`}>Settings</Link>
+        </div>
+      </header>
+      <div className="repo-layout">
+        <main className="panel readme-panel">
+          <h2>README</h2>
+          {readme.isLoading ? <p>Rendering README…</p> : null}
+          {readme.error ? <p className="danger">README failed: {String(readme.error)}</p> : null}
+          {readme.data ? <MarkdownHtml html={readme.data.html} warnings={readme.data.warnings} /> : null}
+        </main>
+        <aside className="panel repo-sidecar">
+          <h2>Live repo health</h2>
+          <p>Pipeline, VTI, agent, cache, and approval cards mount here.</p>
+        </aside>
+      </div>
+    </section>
+  );
+}
