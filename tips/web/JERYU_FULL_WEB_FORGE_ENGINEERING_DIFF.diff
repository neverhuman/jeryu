diff --git a/apps/web/src/api/client.ts b/apps/web/src/api/client.ts
new file mode 100644
index 0000000..f69eae7
--- /dev/null
+++ b/apps/web/src/api/client.ts
@@ -0,0 +1,111 @@
+export type WebUser = {
+  id: string;
+  displayName: string;
+  permissions: string[];
+};
+
+export type WebBootstrap = {
+  version: string;
+  user: WebUser;
+  websocketUrl: string;
+  featureFlags: Record<string, boolean>;
+};
+
+export type RepositorySummary = {
+  id: string;
+  provider: 'local' | 'gitlab' | 'github';
+  owner: string;
+  name: string;
+  slug: string;
+  description?: string;
+  family?: string;
+  visibility: 'private' | 'internal' | 'public';
+  defaultBranch: string;
+  lastActivityAt?: string;
+  health: RepoHealth;
+};
+
+export type RepoHealth = {
+  state: 'green' | 'yellow' | 'red' | 'unknown';
+  score: number;
+  failingChecks: number;
+  openMergeRequests: number;
+  pendingApprovals: number;
+  staleAgents: number;
+};
+
+export type ReadmeResponse = {
+  repoId: string;
+  refName: string;
+  path: string;
+  blobSha: string;
+  html: string;
+  toc: Array<{ id: string; level: number; text: string }>;
+  warnings: string[];
+};
+
+export type ApiErrorBody = {
+  error: {
+    code: string;
+    message: string;
+    requestId?: string;
+  };
+};
+
+const API_BASE = '/api/web/v1';
+
+export async function apiFetch<T>(path: string, init: RequestInit = {}): Promise<T> {
+  const response = await fetch(`${API_BASE}${path}`, {
+    credentials: 'same-origin',
+    headers: {
+      Accept: 'application/json',
+      'Content-Type': 'application/json',
+      ...init.headers,
+    },
+    ...init,
+  });
+
+  if (!response.ok) {
+    let body: ApiErrorBody | undefined;
+    try {
+      body = (await response.json()) as ApiErrorBody;
+    } catch {
+      // fall through
+    }
+    throw new Error(body?.error.message ?? `JeRyu API ${response.status}`);
+  }
+
+  return (await response.json()) as T;
+}
+
+export const webApi = {
+  bootstrap: () => apiFetch<WebBootstrap>('/bootstrap'),
+  repos: (query = '') => apiFetch<{ repositories: RepositorySummary[] }>(`/repos${query}`),
+  readme: (repo: string, refName = 'main') =>
+    apiFetch<ReadmeResponse>(`/repos/${encodeURIComponent(repo)}/readme/${encodeURIComponent(refName)}`),
+  createRepo: (body: unknown) =>
+    apiFetch<RepositorySummary>('/repos', { method: 'POST', body: JSON.stringify(body) }),
+};
diff --git a/apps/web/src/app/RealtimeProvider.tsx b/apps/web/src/app/RealtimeProvider.tsx
new file mode 100644
index 0000000..dcfa5ed
--- /dev/null
+++ b/apps/web/src/app/RealtimeProvider.tsx
@@ -0,0 +1,51 @@
+import { createContext, useContext, useEffect, useMemo, useState } from 'react';
+import { queryClient } from '../api/queryClient';
+import { connectRealtime, type WebEvent } from '../realtime/socket';
+
+type RealtimeContextValue = {
+  connected: boolean;
+  lastEvent?: WebEvent;
+};
+
+const RealtimeContext = createContext<RealtimeContextValue>({ connected: false });
+
+export function RealtimeProvider({ children }: { children: React.ReactNode }) {
+  const [connected, setConnected] = useState(false);
+  const [lastEvent, setLastEvent] = useState<WebEvent | undefined>();
+
+  useEffect(() => {
+    const socket = connectRealtime({
+      onOpen: () => setConnected(true),
+      onClose: () => setConnected(false),
+      onEvent: (event) => {
+        setLastEvent(event);
+        if (event.kind.startsWith('repo.')) {
+          queryClient.invalidateQueries({ queryKey: ['repos'] });
+        }
+        if (event.kind.startsWith('mr.')) {
+          queryClient.invalidateQueries({ queryKey: ['merge-request'] });
+        }
+      },
+    });
+    return () => socket.close();
+  }, []);
+
+  const value = useMemo(() => ({ connected, lastEvent }), [connected, lastEvent]);
+
+  return <RealtimeContext.Provider value={value}>{children}</RealtimeContext.Provider>;
+}
+
+export function useRealtime() {
+  return useContext(RealtimeContext);
+}
diff --git a/apps/web/src/realtime/socket.ts b/apps/web/src/realtime/socket.ts
new file mode 100644
index 0000000..91a4540
--- /dev/null
+++ b/apps/web/src/realtime/socket.ts
@@ -0,0 +1,87 @@
+export type WebEvent = {
+  type: 'event';
+  event_id: number;
+  topic: string;
+  occurred_at: string;
+  kind: string;
+  subject: { type: string; id: string };
+  actor?: { type: string; id: string; display: string };
+  payload: unknown;
+  stale?: boolean;
+};
+
+type SocketHandlers = {
+  onOpen?: () => void;
+  onClose?: () => void;
+  onEvent?: (event: WebEvent) => void;
+};
+
+export function connectRealtime(handlers: SocketHandlers) {
+  const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
+  const url = `${protocol}//${window.location.host}/api/web/v1/ws`;
+  const socket = new WebSocket(url);
+
+  socket.addEventListener('open', () => {
+    handlers.onOpen?.();
+    socket.send(JSON.stringify({ type: 'hello', client_id: crypto.randomUUID() }));
+    socket.send(JSON.stringify({ type: 'subscribe', topics: ['global'] }));
+  });
+
+  socket.addEventListener('close', () => handlers.onClose?.());
+  socket.addEventListener('message', (message) => {
+    const frame = JSON.parse(message.data as string) as WebEvent | { type: string };
+    if (frame.type === 'event') {
+      handlers.onEvent?.(frame as WebEvent);
+    }
+  });
+
+  return socket;
+}
