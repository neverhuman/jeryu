+use jeryu::{api::{entity::{EntityRef, EntityKind, Severity}, events::TuiEventKind}, web::activity::ActivityHub};
+
+#[test]
+fn activity_hub_replays_from_sequence() {
+    let hub = ActivityHub::new(4);
+    hub.publish_summary(
+        TuiEventKind::RepositoryCreated,
+        Severity::Info,
+        EntityRef { kind: EntityKind::Repository, id: "r1".into() },
+        "created r1",
+    );
+    hub.publish_summary(
+        TuiEventKind::RepositoryUpdated,
+        Severity::Info,
+        EntityRef { kind: EntityKind::Repository, id: "r1".into() },
+        "updated r1",
+    );
+    let replay = hub.replay_since(2);
+    assert_eq!(replay.len(), 1);
+    assert_eq!(replay[0].seq, 2);
+}
