+) -> WebResult<Json<MergeRequestListResponse>> {
+    Ok(Json(MergeRequestListResponse { items: vec![], total: 0 }))
+}
+
+pub async fn get_merge_request(
+    State(_state): State<WebState>,
+    _user: WebUser,
+    Path((owner, repo, iid)): Path<(String, String, String)>,
+) -> WebResult<Json<MergeRequestDetail>> {
+    Err(WebError::NotFound(format!("merge request {owner}/{repo}!{iid}")))
+}
+
+pub async fn approve_merge_request(
+    State(_state): State<WebState>,
+    user: WebUser,
+    Path((_owner, _repo, _iid)): Path<(String, String, String)>,
+    Json(_request): Json<ApproveMergeRequestRequest>,
+) -> WebResult<Json<serde_json::Value>> {
+    if !user.can_admin() { return Err(WebError::Forbidden("approval permission required".into())); }
+    Ok(Json(serde_json::json!({ "accepted": true })))
+}
+
+pub async fn merge_merge_request(
+    State(_state): State<WebState>,
+    user: WebUser,
+    Path((_owner, _repo, _iid)): Path<(String, String, String)>,
+    Json(_request): Json<MergeRequestMergeRequest>,
+) -> WebResult<Json<serde_json::Value>> {
+    if !user.can_admin() { return Err(WebError::Forbidden("merge permission required".into())); }
+    Ok(Json(serde_json::json!({ "accepted": true })))
+}
