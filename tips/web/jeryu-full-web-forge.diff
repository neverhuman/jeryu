+//! Owner: Web Forge auth/session boundary
+
+use axum::{extract::FromRequestParts, http::request::Parts};
+
+use super::error::{WebError, WebResult};
+
+#[derive(Debug, Clone)]
+pub struct WebUser {
+    pub id: String,
+    pub login: String,
+    pub roles: Vec<String>,
+}
+
+impl WebUser {
+    pub fn can_admin(&self) -> bool { self.roles.iter().any(|r| r == "admin") }
+}
+
+impl<S> FromRequestParts<S> for WebUser
+where
+    S: Send + Sync,
+{
+    type Rejection = WebError;
+
+    async fn from_request_parts(_parts: &mut Parts, _state: &S) -> Result<Self, Self::Rejection> {
+        if !crate::settings::get().web.security.require_auth {
+            return Ok(Self { id: "local".into(), login: "local".into(), roles: vec!["admin".into()] });
+        }
+        Err(WebError::Forbidden("web auth is enabled but no session adapter is configured yet".into()))
+    }
+}
+
+pub fn require_repo_admin(user: &WebUser) -> WebResult<()> {
+    if user.can_admin() { Ok(()) } else { Err(WebError::Forbidden("admin permission required".into())) }
+}
