+import type { TuiEvent } from '@jeryu/contracts';
+import type { ActivityFrame } from './socket';
+
+export type RealtimeState = {
+  status: 'connecting' | 'open' | 'closed' | 'reconnecting';
+  sessionId?: string;
+  lastSeq: number;
+  replayWindowStart: number;
+  gap?: { expected: number; actual: number; replayAvailable: boolean };
+  events: TuiEvent[];
+  byEntity: Record<string, TuiEvent[]>;
+};
+
+export const initialRealtimeState: RealtimeState = {
+  status: 'connecting',
+  lastSeq: 0,
+  replayWindowStart: 0,
+  events: [],
+  byEntity: {},
+};
+
+function entityKey(event: TuiEvent) {
+  return `${event.entity.kind}:${event.entity.id}`;
+}
+
+function appendEvent(state: RealtimeState, event: TuiEvent): RealtimeState {
+  if (event.seq <= state.lastSeq) return state;
+  const key = entityKey(event);
+  const events = [...state.events, event].slice(-500);
+  const entityEvents = [...(state.byEntity[key] ?? []), event].slice(-100);
+  return {
+    ...state,
+    lastSeq: event.seq,
+    events,
+    byEntity: { ...state.byEntity, [key]: entityEvents },
+  };
+}
+
+export function reduceRealtime(state: RealtimeState, frame: ActivityFrame): RealtimeState {
+  switch (frame.type) {
+    case 'hello':
+      return {
+        ...state,
+        sessionId: frame.session_id,
+        lastSeq: Math.max(state.lastSeq, frame.last_seq),
+        replayWindowStart: frame.replay_window_start,
+      };
+    case 'event':
+      if (frame.event.seq !== state.lastSeq + 1 && state.lastSeq !== 0) {
+        return { ...appendEvent(state, frame.event), gap: { expected: state.lastSeq + 1, actual: frame.event.seq, replayAvailable: true } };
+      }
+      return appendEvent(state, frame.event);
+    case 'batch':
+      return frame.events.reduce(appendEvent, state);
+    case 'gap':
+      return {
+        ...state,
+        gap: { expected: frame.expected_seq, actual: frame.actual_seq, replayAvailable: frame.replay_available },
+      };
+    case 'pong':
+      return state;
+    case 'error':
+      console.warn('activity socket error', frame);
+      return state;
+  }
+}
diff --git a/apps/web/src/realtime/ActivitySocketProvider.tsx b/apps/web/src/realtime/ActivitySocketProvider.tsx
new file mode 100644
index 0000000..6eeb8cb
--- /dev/null
+++ b/apps/web/src/realtime/ActivitySocketProvider.tsx
@@ -0,0 +1,66 @@
+import React, { createContext, useContext, useEffect, useMemo, useReducer } from 'react';
+import { useQueryClient } from '@tanstack/react-query';
+
+import { ActivitySocket } from './socket';
+import { initialRealtimeState, reduceRealtime, type RealtimeState } from './reducer';
+
+const ActivityContext = createContext<RealtimeState>(initialRealtimeState);
+
+export function ActivitySocketProvider({ children }: { children: React.ReactNode }) {
+  const queryClient = useQueryClient();
+  const [state, dispatch] = useReducer(reduceRealtime, initialRealtimeState);
+
+  const topics = useMemo(() => ['global.activity', 'user:me:notifications'], []);
+
+  useEffect(() => {
+    const socket = new ActivitySocket({
+      topics,
+      sinceSeq: Number(window.localStorage.getItem('jeryu:lastSeq') ?? '0'),
+      onStatus: (status) => {
+        if (status === 'open') queryClient.invalidateQueries({ queryKey: ['dashboard'] });
+      },
+      onFrame: (frame) => {
+        dispatch(frame);
+        if (frame.type === 'event') {
+          window.localStorage.setItem('jeryu:lastSeq', String(frame.event.seq));
+          queryClient.invalidateQueries({ queryKey: ['entity', frame.event.entity.kind, frame.event.entity.id] });
+        }
+        if (frame.type === 'gap' && !frame.replay_available) {
+          queryClient.invalidateQueries();
+        }
+      },
+    });
+    socket.connect();
+    return () => socket.close();
+  }, [queryClient, topics]);
+
+  return <ActivityContext.Provider value={state}>{children}</ActivityContext.Provider>;
+}
+
+export function useActivity() {
+  return useContext(ActivityContext);
+}
