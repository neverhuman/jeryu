+use jeryu::settings_types::MarkdownSettings;
+use jeryu::web::markdown::MarkdownRenderer;
+
+#[test]
+fn readme_markdown_renders_to_sanitized_html() {
+    let renderer = MarkdownRenderer::from_settings(&MarkdownSettings::default());
+    let rendered = renderer.render_readme(
+        "repo:main:README.md:abc".into(),
+        "repo".into(),
+        "main".into(),
+        "abc".into(),
+        "README.md".into(),
+        "# Hello\n\n<script>alert(1)</script>\n\n- [x] task",
+    );
+    assert!(rendered.html.contains("Hello"));
+    assert!(!rendered.html.contains("<script>"));
+    assert_eq!(rendered.toc[0].text, "Hello");
+}
