+.hero-card, .markdown-card, .empty-card, .skeleton-card, .attention-card, .metric, .repo-card, .settings-section, .diff-file { border: 1px solid var(--line); background: rgba(14,20,36,.78); border-radius: 18px; padding: 1rem; }
+.metric-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-top: 1rem; }
