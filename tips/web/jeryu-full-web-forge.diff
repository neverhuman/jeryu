+import { useMemo, useState } from 'react';
+import { Link } from '@tanstack/react-router';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+
+import { commands, queries } from '@/api/client';
+
+type RepoCard = {
+  owner: string;
+  name: string;
+  description?: string;
+  default_branch: string;
+  visibility: string;
+  health: 'ok' | 'attention' | 'blocked';
+  family?: string;
+  open_merge_requests: number;
+  failing_pipelines: number;
+};
+
+export function ReposPage() {
+  const [q, setQ] = useState('');
+  const queryClient = useQueryClient();
+  const repos = useQuery({ queryKey: ['repos', q], queryFn: () => queries.repositories(q) as Promise<{ items: RepoCard[] }> });
+  const createRepo = useMutation({
+    mutationFn: (payload: unknown) => commands.createRepository(payload),
+    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['repos'] }),
+  });
+  const grouped = useMemo(() => {
+    const groups = new Map<string, RepoCard[]>();
+    for (const repo of repos.data?.items ?? []) {
+      const key = repo.family ?? 'ungrouped';
+      groups.set(key, [...(groups.get(key) ?? []), repo]);
+    }
+    return [...groups.entries()];
+  }, [repos.data]);
+
+  return (
+    <section className="repos-page">
+      <header className="page-header">
+        <div>
+          <h1>Repositories</h1>
+          <p>Every repo, family, review, pipeline, and setting in one fast surface.</p>
+        </div>
+        <button onClick={() => createRepo.mutate({ name: prompt('Repository name?'), visibility: 'private' })}>
+          New repo
+        </button>
+      </header>
+      <input className="search" value={q} onChange={(event) => setQ(event.target.value)} placeholder="Search name, owner, language, health…" />
+      {grouped.map(([family, items]) => (
+        <section className="repo-family" key={family}>
+          <h2>{family}</h2>
+          <div className="repo-grid">
+            {items.map((repo) => (
+              <Link key={`${repo.owner}/${repo.name}`} to="/r/$owner/$repo" params={{ owner: repo.owner, repo: repo.name }} className={`repo-card repo-card--${repo.health}`}>
+                <strong>{repo.owner}/{repo.name}</strong>
+                <p>{repo.description ?? 'No description yet.'}</p>
+                <dl>
+                  <dt>branch</dt><dd>{repo.default_branch}</dd>
+                  <dt>MRs</dt><dd>{repo.open_merge_requests}</dd>
+                  <dt>failing</dt><dd>{repo.failing_pipelines}</dd>
+                </dl>
+              </Link>
+            ))}
+          </div>
+        </section>
+      ))}
+    </section>
+  );
+}
