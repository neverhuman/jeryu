@@ -0,0 +1,76 @@
+//! Owner: Web Forge route assembly
+
+use anyhow::Result;
+use axum::{routing::get, Router};
+use tower_http::{compression::CompressionLayer, services::{ServeDir, ServeFile}, trace::TraceLayer};
+
+use crate::engine::SharedState;
+
+use super::{rest, state::WebState, ws};
+
+pub fn attach(app: Router<SharedState>, engine: SharedState, serve_static: bool) -> Result<Router<SharedState>> {
+    let web_state = WebState::new(engine.clone());
+    let api = Router::new()
+        .route("/dashboard", get(rest::dashboard::get_dashboard))
+        .route("/repos", get(rest::repos::list_repos).post(rest::repos::create_repo))
+        .route("/repos/{owner}/{repo}", get(rest::repos::get_repo))
+        .route("/repos/{owner}/{repo}/readme", get(rest::repo_files::readme))
+        .route("/repos/{owner}/{repo}/tree/{ref_name}", get(rest::repo_files::tree))
+        .route("/repos/{owner}/{repo}/blob/{ref_name}", get(rest::repo_files::blob))
+        .route("/repos/{owner}/{repo}/merge-requests", get(rest::merge_requests::list_merge_requests))
+        .route("/repos/{owner}/{repo}/merge-requests/{iid}", get(rest::merge_requests::get_merge_request))
+        .route("/repos/{owner}/{repo}/merge-requests/{iid}/approve", axum::routing::post(rest::merge_requests::approve_merge_request))
+        .route("/repos/{owner}/{repo}/merge-requests/{iid}/merge", axum::routing::post(rest::merge_requests::merge_merge_request))
+        .route("/repos/{owner}/{repo}/settings", get(rest::settings::get_repo_settings).patch(rest::settings::update_repo_settings))
+        .route("/actions/preview", axum::routing::post(rest::actions::preview_action))
+        .route("/actions/execute", axum::routing::post(rest::actions::execute_action))
+        .with_state(web_state.clone());
+
+    let ws_routes = Router::new()
+        .route("/activity", get(ws::activity_socket))
+        .with_state(web_state);
+
+    let mut out = app
+        .nest("/api/web", api)
+        .nest("/ws", ws_routes)
+        .layer(TraceLayer::new_for_http())
+        .layer(CompressionLayer::new());
+
+    if serve_static {
+        let static_dir = crate::settings::get()
+            .web
+            .static_dir
+            .clone()
+            .unwrap_or_else(|| "apps/web/dist".to_string());
+        let index = format!("{static_dir}/index.html");
+        out = out.fallback_service(ServeDir::new(&static_dir).not_found_service(ServeFile::new(index)));
+    }
+
+    Ok(out)
+}
