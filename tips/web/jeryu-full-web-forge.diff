+import { useParams } from '@tanstack/react-router';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+
+import { commands, queries } from '@/api/client';
+
+type MergeRequestDetail = {
+  iid: string;
+  title: string;
+  state: string;
+  head_sha: string;
+  target_branch: string;
+  author: string;
+  approvals: { required: number; approved: number; current_user_approved: boolean };
+  checks: Array<{ name: string; conclusion: string; details_url?: string }>;
+  files: Array<{ path: string; additions: number; deletions: number; hunks: string[] }>;
+};
+
+export function MergeRequestDetailPage() {
+  const { owner, repo, iid } = useParams({ from: '/r/$owner/$repo/merge-requests/$iid' });
+  const queryClient = useQueryClient();
+  const mr = useQuery({
+    queryKey: ['repo', owner, repo, 'mr', iid],
+    queryFn: () => queries.mergeRequest(owner, repo, iid) as Promise<MergeRequestDetail>,
+  });
+  const approve = useMutation({
+    mutationFn: () => commands.approveMergeRequest(owner, repo, iid, { head_sha: mr.data?.head_sha }),
+    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['repo', owner, repo, 'mr', iid] }),
+  });
+  const merge = useMutation({
+    mutationFn: () => commands.mergeMergeRequest(owner, repo, iid, { head_sha: mr.data?.head_sha, strategy: 'squash' }),
+    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['repo', owner, repo] }),
+  });
+
+  if (mr.isLoading) return <section className="skeleton-card">Loading review room…</section>;
+  if (mr.isError || !mr.data) return <section className="empty-card">Merge request not found.</section>;
+
+  return (
+    <section className="review-room">
+      <header className="review-header">
+        <div>
+          <h1>!{mr.data.iid} {mr.data.title}</h1>
+          <p>{mr.data.author} into {mr.data.target_branch} · {mr.data.head_sha.slice(0, 12)}</p>
+        </div>
+        <div className="review-actions">
+          <button onClick={() => approve.mutate()} disabled={approve.isPending || mr.data.approvals.current_user_approved}>Approve exact SHA</button>
+          <button onClick={() => merge.mutate()} disabled={merge.isPending}>Merge when green</button>
+        </div>
+      </header>
+      <aside className="review-summary">
+        <strong>{mr.data.approvals.approved}/{mr.data.approvals.required} approvals</strong>
+        <ol>{mr.data.checks.map((check) => <li key={check.name}>{check.name}: {check.conclusion}</li>)}</ol>
+      </aside>
+      <div className="diff-list">
+        {mr.data.files.map((file) => (
+          <article className="diff-file" key={file.path}>
+            <header>{file.path} <span>+{file.additions} -{file.deletions}</span></header>
+            <pre>{file.hunks.join('\n')}</pre>
+          </article>
+        ))}
+      </div>
+    </section>
+  );
+}
