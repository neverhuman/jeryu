+import DOMPurify from 'dompurify';
+
+export type MarkdownHtmlProps = {
+  html: string;
+  title?: string;
+  cacheHit?: boolean;
+  sourcePath?: string;
+};
+
+export function MarkdownHtml({ html, title, cacheHit, sourcePath }: MarkdownHtmlProps) {
+  const clean = DOMPurify.sanitize(html, {
+    USE_PROFILES: { html: true, svg: false, svgFilters: false, mathMl: false },
+    ADD_ATTR: ['data-sourcepos', 'data-anchor-id'],
+  });
+  return (
+    <article className="markdown-card" aria-label={title ?? sourcePath ?? 'Rendered Markdown'}>
+      <header className="markdown-card__header">
+        <div>
+          <h2>{title ?? 'README'}</h2>
+          {sourcePath ? <p>{sourcePath}</p> : null}
+        </div>
+        <span className="pill">{cacheHit ? 'cached HTML' : 'fresh render'}</span>
+      </header>
+      <div className="markdown-body" dangerouslySetInnerHTML={{ __html: clean }} />
+    </article>
+  );
+}
