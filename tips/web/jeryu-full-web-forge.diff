@@ -0,0 +1,121 @@
+//! Owner: Web Forge Markdown renderer
+//! Invariants: rendered README HTML is sanitized before leaving the server.
+
+use std::{collections::HashMap, sync::Arc};
+
+use ammonia::Builder;
+use parking_lot::Mutex;
+use pulldown_cmark::{html, Options, Parser};
+
+use crate::{api::repo_browser::{MarkdownHeading, ReadmeRenderResponse}, settings_types::MarkdownSettings};
+
+#[derive(Debug, Clone)]
+pub struct MarkdownRenderer {
+    settings: MarkdownSettings,
+    cache: Arc<Mutex<HashMap<String, ReadmeRenderResponse>>>,
+}
+
+impl MarkdownRenderer {
+    pub fn from_settings(settings: &MarkdownSettings) -> Self {
+        Self { settings: settings.clone(), cache: Arc::new(Mutex::new(HashMap::new())) }
+    }
+
+    pub fn render_readme(
+        &self,
+        cache_key: String,
+        repo_id: String,
+        ref_name: String,
+        commit_sha: String,
+        path: String,
+        markdown: &str,
+    ) -> ReadmeRenderResponse {
+        if let Some(hit) = self.cache.lock().get(&cache_key).cloned() {
+            return ReadmeRenderResponse { cache_hit: true, ..hit };
+        }
+        let mut options = Options::empty();
+        options.insert(Options::ENABLE_TABLES);
+        options.insert(Options::ENABLE_FOOTNOTES);
+        options.insert(Options::ENABLE_STRIKETHROUGH);
+        options.insert(Options::ENABLE_TASKLISTS);
+        options.insert(Options::ENABLE_HEADING_ATTRIBUTES);
+        let parser = Parser::new_ext(markdown, options);
+        let mut raw_html = String::new();
+        html::push_html(&mut raw_html, parser);
+        let clean = if self.settings.allow_html { raw_html } else { Builder::default().clean(&raw_html).to_string() };
+        let response = ReadmeRenderResponse {
+            repo_id,
+            ref_name,
+            commit_sha,
+            path,
+            title: extract_title(markdown),
+            html: clean,
+            toc: extract_headings(markdown),
+            cache_hit: false,
+            rendered_at: chrono::Utc::now(),
+        };
+        let mut cache = self.cache.lock();
+        cache.insert(cache_key, response.clone());
+        if cache.len() > self.settings.cache_entries {
+            if let Some(first) = cache.keys().next().cloned() { cache.remove(&first); }
+        }
+        response
+    }
+}
+
+fn extract_title(markdown: &str) -> Option<String> {
+    markdown.lines().find_map(|line| line.strip_prefix("# ").map(|s| s.trim().to_string()))
+}
+
+fn extract_headings(markdown: &str) -> Vec<MarkdownHeading> {
+    markdown.lines().filter_map(|line| {
+        let hashes = line.chars().take_while(|c| *c == '#').count();
+        if hashes == 0 || hashes > 6 || !line.chars().nth(hashes).is_some_and(|c| c == ' ') {
+            return None;
+        }
+        let text = line[hashes + 1..].trim().to_string();
+        let id = text.to_lowercase().chars().map(|c| if c.is_ascii_alphanumeric() { c } else { '-' }).collect::<String>().trim_matches('-').to_string();
+        Some(MarkdownHeading { level: hashes as u8, id, text })
+    }).collect()
+}
