@@ -0,0 +1,77 @@
+import { useMutation } from '@tanstack/react-query';
+import { commands } from '@/api/client';
+
+export type ActionIntent = {
+  action: string;
+  entity: { kind: string; id: string };
+  payload?: unknown;
+  label: string;
+  risk?: 'low' | 'medium' | 'high' | 'destructive';
+};
+
+export function ActionButton({ intent }: { intent: ActionIntent }) {
+  const preview = useMutation({ mutationFn: () => commands.previewAction(intent) });
+  const execute = useMutation({ mutationFn: () => commands.executeAction(intent) });
+
+  async function onClick() {
+    const plan = await preview.mutateAsync();
+    const risk = (plan as { risk?: string }).risk ?? intent.risk ?? 'low';
+    const allowed = risk === 'low' || window.confirm(`Execute ${intent.label}? Risk: ${risk}`);
+    if (allowed) await execute.mutateAsync();
+  }
+
+  return (
+    <button className={`action action--${intent.risk ?? 'low'}`} disabled={preview.isPending || execute.isPending} onClick={onClick}>
+      {execute.isPending ? 'Working…' : intent.label}
+    </button>
+  );
+}
