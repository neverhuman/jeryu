+import React from 'react';
+import ReactDOM from 'react-dom/client';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { RouterProvider } from '@tanstack/react-router';
+import { ErrorBoundary } from 'react-error-boundary';
+
+import { router } from './router';
+import { ActivitySocketProvider } from './realtime/ActivitySocketProvider';
+import { GlobalCommandPalette } from './shell/GlobalCommandPalette';
+import './styles/global.css';
+
+const queryClient = new QueryClient({
+  defaultOptions: {
+    queries: {
+      staleTime: 10_000,
+      retry: (count, error) => count < 2 && String(error).includes('transient'),
+    },
+  },
+});
+
+ReactDOM.createRoot(document.getElementById('root')!).render(
+  <React.StrictMode>
+    <ErrorBoundary fallback={<main className="panic">JeRyu Forge hit an unrecoverable render error.</main>}>
+      <QueryClientProvider client={queryClient}>
+        <ActivitySocketProvider>
+          <RouterProvider router={router} />
+          <GlobalCommandPalette />
+        </ActivitySocketProvider>
+      </QueryClientProvider>
+    </ErrorBoundary>
+  </React.StrictMode>,
+);
