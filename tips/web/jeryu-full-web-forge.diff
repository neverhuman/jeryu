diff --git a/apps/web/src/pages/repo/RepoSettingsPage.tsx b/apps/web/src/pages/repo/RepoSettingsPage.tsx
new file mode 100644
index 0000000..4f035f0
--- /dev/null
+++ b/apps/web/src/pages/repo/RepoSettingsPage.tsx
@@ -0,0 +1,84 @@
+import { useState } from 'react';
+import { useParams } from '@tanstack/react-router';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { commands, queries } from '@/api/client';
+
+export function RepoSettingsPage() {
+  const { owner, repo } = useParams({ from: '/r/$owner/$repo' });
+  const queryClient = useQueryClient();
+  const settings = useQuery({ queryKey: ['repo', owner, repo, 'settings'], queryFn: () => queries.repoSettings(owner, repo) });
+  const [draft, setDraft] = useState<Record<string, unknown>>({});
+  const save = useMutation({
+    mutationFn: () => commands.updateRepoSettings(owner, repo, draft),
+    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['repo', owner, repo, 'settings'] }),
+  });
+  const current = (settings.data ?? {}) as Record<string, unknown>;
+  return (
+    <section className="settings-grid">
+      <header className="page-header">
+        <h2>Repository settings</h2>
+        <button onClick={() => save.mutate()} disabled={save.isPending}>Preview & save</button>
+      </header>
+      {['general', 'visibility', 'branch_protection', 'merge_policy', 'ci_cd', 'webhooks', 'members', 'agents', 'danger_zone'].map((section) => (
+        <article className="settings-section" key={section}>
+          <h3>{section.replaceAll('_', ' ')}</h3>
+          <textarea
+            value={JSON.stringify(draft[section] ?? current[section] ?? {}, null, 2)}
+            onChange={(event) => {
+              try { setDraft((d) => ({ ...d, [section]: JSON.parse(event.target.value) })); } catch { /* keep editing */ }
+            }}
+          />
+        </article>
+      ))}
+    </section>
+  );
+}
