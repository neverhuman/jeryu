@@ -0,0 +1,120 @@
+//! Owner: Web Forge WebSocket server
+
+use axum::{extract::{Query, State, ws::{Message, WebSocket, WebSocketUpgrade}}, response::IntoResponse};
+use chrono::Utc;
+use futures_util::{SinkExt, StreamExt};
+use serde::Deserialize;
+use uuid::Uuid;
+
+use crate::api::websocket::{BrowserWsCommand, BrowserWsFrame};
+
+use super::state::WebState;
+
+#[derive(Debug, Deserialize)]
+pub struct ActivitySocketQuery {
+    pub since_seq: Option<u64>,
+}
+
+pub async fn activity_socket(
+    State(state): State<WebState>,
+    Query(query): Query<ActivitySocketQuery>,
+    ws: WebSocketUpgrade,
+) -> impl IntoResponse {
+    ws.on_upgrade(move |socket| handle_socket(state, query.since_seq, socket))
+}
+
+async fn send_frame(sender: &mut futures_util::stream::SplitSink<WebSocket, Message>, frame: BrowserWsFrame) -> anyhow::Result<()> {
+    sender.send(Message::Text(serde_json::to_string(&frame)?.into())).await?;
+    Ok(())
+}
+
+async fn handle_socket(state: WebState, since_seq: Option<u64>, socket: WebSocket) {
+    let session_id = Uuid::new_v4().to_string();
+    let (mut sender, mut receiver) = socket.split();
+    let mut events = state.activity_hub.subscribe();
+
+    let hello = BrowserWsFrame::Hello {
+        session_id,
+        server_time: Utc::now().to_rfc3339(),
+        replay_window_start: state.activity_hub.replay_window_start(),
+        last_seq: state.activity_hub.last_seq(),
+    };
+    if send_frame(&mut sender, hello).await.is_err() {
+        return;
+    }
+    if let Some(since) = since_seq {
+        let replay = state.activity_hub.replay_since(since);
+        if !replay.is_empty() {
+            let _ = send_frame(&mut sender, BrowserWsFrame::Batch { events: replay }).await;
+        }
+    }
+
+    loop {
+        tokio::select! {
+            Ok(event) = events.recv() => {
+                if send_frame(&mut sender, BrowserWsFrame::Event { event }).await.is_err() {
+                    break;
+                }
+            }
+            message = receiver.next() => {
+                let Some(Ok(message)) = message else { break; };
+                match message {
+                    Message::Text(text) => {
+                        match serde_json::from_str::<BrowserWsCommand>(&text) {
+                            Ok(BrowserWsCommand::Ping { .. }) => {
+                                let _ = send_frame(&mut sender, BrowserWsFrame::Pong { now: Utc::now().to_rfc3339() }).await;
+                            }
+                            Ok(BrowserWsCommand::Replay { since_seq, .. }) => {
+                                let replay = state.activity_hub.replay_since(since_seq);
+                                let _ = send_frame(&mut sender, BrowserWsFrame::Batch { events: replay }).await;
+                            }
+                            Ok(BrowserWsCommand::Subscribe { since_seq, .. }) => {
+                                if let Some(since) = since_seq {
+                                    let replay = state.activity_hub.replay_since(since);
+                                    let _ = send_frame(&mut sender, BrowserWsFrame::Batch { events: replay }).await;
+                                }
+                            }
+                            Ok(BrowserWsCommand::Unsubscribe { .. }) => {}
+                            Err(e) => {
+                                let _ = send_frame(&mut sender, BrowserWsFrame::Error { code: "bad_command".into(), message: e.to_string(), correlation_id: None }).await;
+                            }
+                        }
+                    }
+                    Message::Close(_) => break,
+                    _ => {}
+                }
+            }
+        }
+    }
+}
