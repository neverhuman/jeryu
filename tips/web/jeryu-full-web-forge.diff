+// Generated by `cargo run -p jeryu -- web export-contracts`.
+// The checked-in fallback keeps TypeScript usable before the first generation.
+export type EntityRef = { kind: string; id: string };
+export type Severity = 'trace' | 'info' | 'success' | 'warning' | 'error' | 'critical';
+export type TuiEventKind = string;
+export type TuiEvent = {
+  seq: number;
+  timestamp: string;
+  kind: TuiEventKind;
+  severity: Severity;
+  entity: EntityRef;
+  parent?: EntityRef | null;
+  summary: string;
+  correlation_id?: string | null;
+  evidence_refs: string[];
+  next_actions: unknown[];
+  stale_after_ms: number;
+};
diff --git a/apps/web/src/realtime/socket.ts b/apps/web/src/realtime/socket.ts
new file mode 100644
index 0000000..4b01a1a
--- /dev/null
+++ b/apps/web/src/realtime/socket.ts
@@ -0,0 +1,115 @@
+import type { TuiEvent } from '@jeryu/contracts';
+
+export type ActivityFrame =
+  | { type: 'hello'; session_id: string; server_time: string; replay_window_start: number; last_seq: number }
+  | { type: 'event'; event: TuiEvent }
+  | { type: 'batch'; events: TuiEvent[] }
+  | { type: 'gap'; expected_seq: number; actual_seq: number; replay_available: boolean }
+  | { type: 'pong'; now: string }
+  | { type: 'error'; code: string; message: string; correlation_id?: string };
+
+export type SocketCommand =
+  | { type: 'subscribe'; topics: string[]; since_seq?: number }
+  | { type: 'unsubscribe'; topics: string[] }
+  | { type: 'replay'; since_seq: number; topics: string[] }
+  | { type: 'ping'; nonce: string };
+
+export type ActivitySocketOptions = {
+  topics: string[];
+  sinceSeq?: number;
+  onFrame: (frame: ActivityFrame) => void;
+  onStatus: (status: 'connecting' | 'open' | 'closed' | 'reconnecting') => void;
+};
+
+export class ActivitySocket {
+  private socket?: WebSocket;
+  private readonly opts: ActivitySocketOptions;
+  private retry = 0;
+  private closedByUser = false;
+  private heartbeat?: number;
+
+  constructor(opts: ActivitySocketOptions) {
+    this.opts = opts;
+  }
+
+  connect() {
+    this.closedByUser = false;
+    this.opts.onStatus(this.retry === 0 ? 'connecting' : 'reconnecting');
+    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
+    const url = new URL(`${protocol}//${window.location.host}/ws/activity`);
+    if (this.opts.sinceSeq) url.searchParams.set('since_seq', String(this.opts.sinceSeq));
+
+    this.socket = new WebSocket(url);
+    this.socket.onopen = () => {
+      this.retry = 0;
+      this.opts.onStatus('open');
+      this.send({ type: 'subscribe', topics: this.opts.topics, since_seq: this.opts.sinceSeq });
+      this.heartbeat = window.setInterval(() => this.send({ type: 'ping', nonce: crypto.randomUUID() }), 15_000);
+    };
+    this.socket.onmessage = (message) => {
+      const frame = JSON.parse(message.data) as ActivityFrame;
+      this.opts.onFrame(frame);
+    };
+    this.socket.onclose = () => {
+      window.clearInterval(this.heartbeat);
+      this.opts.onStatus('closed');
+      if (!this.closedByUser) this.reconnect();
+    };
+    this.socket.onerror = () => {
+      this.socket?.close();
+    };
+  }
+
+  send(command: SocketCommand) {
+    if (this.socket?.readyState === WebSocket.OPEN) {
+      this.socket.send(JSON.stringify(command));
+    }
+  }
+
+  close() {
+    this.closedByUser = true;
+    window.clearInterval(this.heartbeat);
+    this.socket?.close();
+  }
+
+  private reconnect() {
+    const delay = Math.min(15_000, 500 * 2 ** this.retry) + Math.random() * 250;
+    this.retry += 1;
+    window.setTimeout(() => this.connect(), delay);
+  }
+}
