+
+use super::super::{auth::WebUser, error::WebResult, state::WebState};
+
+#[derive(Debug, Deserialize)]
+pub struct RefQuery { pub r#ref: Option<String>, pub path: Option<String> }
+
+pub async fn readme(
+    State(state): State<WebState>,
+    _user: WebUser,
+    Path((owner, repo)): Path<(String, String)>,
+    Query(query): Query<RefQuery>,
+) -> WebResult<Json<ReadmeRenderResponse>> {
+    let ref_name = query.r#ref.unwrap_or_else(|| "HEAD".into());
+    let repo_id = format!("{owner}/{repo}");
+    let markdown = format!("# {repo}\n\nThis README is rendered by JeRyu Forge. Provider blob wiring replaces this fallback.");
+    let rendered = state.markdown.render_readme(
+        format!("{repo_id}:{ref_name}:README.md:fallback"),
+        repo_id,
+        ref_name,
+        "unknown".into(),
+        "README.md".into(),
+        &markdown,
+    );
+    Ok(Json(rendered))
+}
+
+pub async fn tree(
+    State(_state): State<WebState>,
+    _user: WebUser,
+    Path((owner, repo, ref_name)): Path<(String, String, String)>,
+    Query(query): Query<RefQuery>,
+) -> WebResult<Json<TreeResponse>> {
+    Ok(Json(TreeResponse { repo_id: format!("{owner}/{repo}"), ref_name, commit_sha: "unknown".into(), path: query.path.unwrap_or_default(), breadcrumbs: vec![], entries: vec![] }))
+}
+
+pub async fn blob(
+    State(_state): State<WebState>,
+    _user: WebUser,
+    Path((owner, repo, ref_name)): Path<(String, String, String)>,
+    Query(query): Query<RefQuery>,
+) -> WebResult<Json<BlobResponse>> {
+    let path = query.path.unwrap_or_else(|| "README.md".into());
+    Ok(Json(BlobResponse { repo_id: format!("{owner}/{repo}"), ref_name, commit_sha: "unknown".into(), path, oid: "unknown".into(), size: 0, mime: Some("text/plain".into()), language: None, encoding: BlobEncoding::Utf8, content: String::new() }))
+}
