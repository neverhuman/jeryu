@@ -0,0 +1,110 @@
+//! Owner: Web Forge realtime activity hub
+//! Invariants: published events retain monotonic sequence order and bounded replay.
+
+use std::{collections::VecDeque, sync::Arc};
+
+use chrono::Utc;
+use parking_lot::Mutex;
+use tokio::sync::broadcast;
+
+use crate::api::{entity::{EntityRef, Severity}, events::{TuiEvent, TuiEventKind}};
+
+#[derive(Clone)]
+pub struct ActivityHub {
+    inner: Arc<ActivityHubInner>,
+}
+
+struct ActivityHubInner {
+    replay_limit: usize,
+    next_seq: Mutex<u64>,
+    replay: Mutex<VecDeque<TuiEvent>>,
+    tx: broadcast::Sender<TuiEvent>,
+}
+
+impl ActivityHub {
+    pub fn new(replay_limit: usize) -> Self {
+        let (tx, _) = broadcast::channel(4096);
+        Self {
+            inner: Arc::new(ActivityHubInner { replay_limit, next_seq: Mutex::new(1), replay: Mutex::new(VecDeque::new()), tx }),
+        }
+    }
+
+    pub fn publish(&self, mut event: TuiEvent) -> TuiEvent {
+        let mut next = self.inner.next_seq.lock();
+        if event.seq == 0 {
+            event.seq = *next;
+            *next += 1;
+        }
+        drop(next);
+        let mut replay = self.inner.replay.lock();
+        replay.push_back(event.clone());
+        while replay.len() > self.inner.replay_limit {
+            replay.pop_front();
+        }
+        drop(replay);
+        let _ = self.inner.tx.send(event.clone());
+        event
+    }
+
+    pub fn publish_summary(&self, kind: TuiEventKind, severity: Severity, entity: EntityRef, summary: impl Into<String>) -> TuiEvent {
+        self.publish(TuiEvent {
+            seq: 0,
+            timestamp: Utc::now(),
+            kind,
+            severity,
+            entity,
+            parent: None,
+            summary: summary.into(),
+            correlation_id: None,
+            evidence_refs: vec![],
+            next_actions: vec![],
+            stale_after_ms: 30_000,
+        })
+    }
+
+    pub fn subscribe(&self) -> broadcast::Receiver<TuiEvent> {
+        self.inner.tx.subscribe()
+    }
+
+    pub fn replay_since(&self, since_seq: u64) -> Vec<TuiEvent> {
+        self.inner.replay.lock().iter().filter(|event| event.seq >= since_seq).cloned().collect()
+    }
+
+    pub fn replay_window_start(&self) -> u64 {
+        self.inner.replay.lock().front().map(|e| e.seq).unwrap_or(0)
+    }
+
+    pub fn last_seq(&self) -> u64 {
+        self.inner.replay.lock().back().map(|e| e.seq).unwrap_or(0)
+    }
+}
