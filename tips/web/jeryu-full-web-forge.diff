+-- JeRyu Web Forge read-model and audit tables.
+CREATE TABLE IF NOT EXISTS web_repositories (
+  id TEXT PRIMARY KEY,
+  provider TEXT NOT NULL,
+  owner TEXT NOT NULL,
+  name TEXT NOT NULL,
+  full_name TEXT NOT NULL UNIQUE,
+  description TEXT,
+  visibility TEXT NOT NULL,
+  default_branch TEXT NOT NULL,
+  family TEXT,
+  language TEXT,
+  clone_http_url TEXT,
+  clone_ssh_url TEXT,
+  health TEXT NOT NULL DEFAULT 'unknown',
+  open_merge_requests INTEGER NOT NULL DEFAULT 0,
+  failing_pipelines INTEGER NOT NULL DEFAULT 0,
+  active_agents INTEGER NOT NULL DEFAULT 0,
+  provider_payload TEXT NOT NULL DEFAULT '{}',
+  created_at TEXT NOT NULL,
+  updated_at TEXT NOT NULL
+);
+
+CREATE INDEX IF NOT EXISTS idx_web_repositories_owner_name ON web_repositories(owner, name);
+CREATE INDEX IF NOT EXISTS idx_web_repositories_family ON web_repositories(family);
+CREATE INDEX IF NOT EXISTS idx_web_repositories_health ON web_repositories(health);
+
+CREATE TABLE IF NOT EXISTS web_markdown_cache (
+  cache_key TEXT PRIMARY KEY,
+  repo_id TEXT NOT NULL,
+  ref_name TEXT NOT NULL,
+  commit_sha TEXT NOT NULL,
+  path TEXT NOT NULL,
+  source_sha256 TEXT NOT NULL,
+  html TEXT NOT NULL,
+  toc_json TEXT NOT NULL DEFAULT '[]',
+  rendered_at TEXT NOT NULL,
+  FOREIGN KEY(repo_id) REFERENCES web_repositories(id) ON DELETE CASCADE
+);
+
+CREATE TABLE IF NOT EXISTS web_activity_events (
+  seq INTEGER PRIMARY KEY AUTOINCREMENT,
+  event_json TEXT NOT NULL,
+  topic TEXT NOT NULL,
+  entity_kind TEXT NOT NULL,
+  entity_id TEXT NOT NULL,
+  severity TEXT NOT NULL,
+  created_at TEXT NOT NULL
+);
+
+CREATE INDEX IF NOT EXISTS idx_web_activity_topic_seq ON web_activity_events(topic, seq);
+CREATE INDEX IF NOT EXISTS idx_web_activity_entity ON web_activity_events(entity_kind, entity_id, seq);
+
+CREATE TABLE IF NOT EXISTS web_action_audit (
+  id TEXT PRIMARY KEY,
+  actor TEXT NOT NULL,
+  action TEXT NOT NULL,
+  entity_kind TEXT NOT NULL,
+  entity_id TEXT NOT NULL,
+  idempotency_key TEXT,
+  request_json TEXT NOT NULL,
+  preview_json TEXT,
+  result_json TEXT,
+  risk TEXT NOT NULL,
+  status TEXT NOT NULL,
+  correlation_id TEXT,
+  created_at TEXT NOT NULL,
+  finished_at TEXT
+);
+
+CREATE UNIQUE INDEX IF NOT EXISTS idx_web_action_audit_idempotency ON web_action_audit(idempotency_key) WHERE idempotency_key IS NOT NULL;
+
+CREATE TABLE IF NOT EXISTS web_user_preferences (
+  user_id TEXT PRIMARY KEY,
+  theme TEXT NOT NULL DEFAULT 'system',
+  density TEXT NOT NULL DEFAULT 'comfortable',
+  code_font_size INTEGER NOT NULL DEFAULT 13,
+  reduce_motion INTEGER NOT NULL DEFAULT 0,
+  command_history_json TEXT NOT NULL DEFAULT '[]',
+  updated_at TEXT NOT NULL
+);
