-    // Build router
-    let app = Router::new()
-        .route("/health", get(health))
-        .route("/hooks", post(handle_webhook))
-        .route("/cache/summary", get(cache_summary))
-        .with_state(state.clone());
+    // Build router. Keep existing control-plane endpoints stable and mount the
+    // web product API/SPA as additive surfaces. Split operational state and web
+    // state before merge so Axum state types stay explicit.
+    let web_state = crate::web::state::WebState::from_engine(state.clone());
+    let operational = Router::new()
+        .route("/health", get(health))
+        .route("/hooks", post(handle_webhook))
+        .route("/cache/summary", get(cache_summary))
+        .with_state(state.clone());
+    let app = operational
+        .merge(crate::web::router::api_router(web_state.clone()))
+        .merge(crate::web::router::spa_router(web_state));
 
