+}
+
+impl ServerFrame {
+    pub fn hello(cursor: u64, topics: Vec<String>) -> Self { Self::Hello { cursor, topics, heartbeat_ms: 25_000 } }
+    pub fn event(event: WebEvent) -> Self { Self::Event { event } }
