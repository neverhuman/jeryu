+import { createContext, ReactNode, useEffect, useState } from 'react';
+import { connectActivity, WebEvent } from '../../api/websocket';
+
+export const ActivityContext = createContext<WebEvent[]>([]);
+
+export function ActivitySocketProvider({ children }: { children: ReactNode }) {
+  const [events, setEvents] = useState<WebEvent[]>([]);
+  useEffect(() => {
+    const ws = connectActivity((event) => setEvents((old) => [event, ...old].slice(0, 200)));
+    return () => ws.close();
+  }, []);
+  return <ActivityContext.Provider value={events}>{children}</ActivityContext.Provider>;
+}
 
