+export type WebEvent = { seq: number; topic: string; kind: string; summary: string; payload: unknown };
+export type ServerFrame = { type: 'hello'; cursor: number; topics: string[] } | { type: 'event'; event: WebEvent } | { type: 'gap'; from_seq: number; to_seq: number; recovery: string };
+
+export function connectActivity(onEvent: (event: WebEvent) => void): WebSocket {
+  const protocol = location.protocol === 'https:' ? 'wss' : 'ws';
+  const ws = new WebSocket(`${protocol}://${location.host}/api/v1/ws`);
+  ws.addEventListener('open', () => ws.send(JSON.stringify({ type: 'hello', last_seen_seq: Number(localStorage.getItem('jeryu:last-seq') ?? 0), subscriptions: ['repos', 'merge_requests', 'ci', 'agents'] })));
+  ws.addEventListener('message', (ev) => {
+    const frame = JSON.parse(ev.data) as ServerFrame;
+    if (frame.type === 'event') { localStorage.setItem('jeryu:last-seq', String(frame.event.seq)); onEvent(frame.event); }
+  });
+  return ws;
+}
 
