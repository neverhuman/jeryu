+            .route("/repos", get(crate::web::api::repos::list_repos).post(crate::web::api::repos::create_repo))
+            .route("/repos/{owner}/{repo}", get(crate::web::api::repos::get_repo))
+            .route("/repos/{owner}/{repo}/tree/{*path}", get(crate::web::api::repo_files::tree))
+            .route("/repos/{owner}/{repo}/blob/{*path}", get(crate::web::api::repo_files::blob))
+            .route("/repos/{owner}/{repo}/raw/{*path}", get(crate::web::api::repo_files::raw))
+            .route("/repos/{owner}/{repo}/markdown/{*path}", get(crate::web::api::repo_files::render_markdown))
+            .route("/repos/{owner}/{repo}/branches", get(crate::web::api::repos::branches).post(crate::web::api::repos::create_branch))
+            .route("/repos/{owner}/{repo}/tags", get(crate::web::api::repos::tags))
+            .route("/repos/{owner}/{repo}/commits", get(crate::web::api::repos::commits))
+            .route("/repos/{owner}/{repo}/compare", get(crate::web::api::repos::compare))
+            .route("/repos/{owner}/{repo}/merge-requests", get(crate::web::api::merge_requests::list).post(crate::web::api::merge_requests::create))
+            .route("/repos/{owner}/{repo}/merge-requests/{number}", get(crate::web::api::merge_requests::detail))
+            .route("/repos/{owner}/{repo}/merge-requests/{number}/review", post(crate::web::api::merge_requests::submit_review))
+            .route("/repos/{owner}/{repo}/merge-requests/{number}/merge", post(crate::web::api::merge_requests::merge))
+            .route("/repos/{owner}/{repo}/settings", get(crate::web::api::settings::get).put(crate::web::api::settings::update))
+            .route("/repos/{owner}/{repo}/settings/preview", post(crate::web::api::settings::preview_update))
+            .route("/actions/preview", post(crate::web::api::actions::preview))
+            .route("/actions/execute", post(crate::web::api::actions::execute))
+            .route("/ws", get(crate::web::ws::upgrade)))
+        .layer(CompressionLayer::new())
+        .with_state(state)
+}
+
+pub fn spa_router(state: WebState) -> Router {
+    let dir = ServeDir::new(state.static_dir.clone()).append_index_html_on_directories(true);
+    Router::new()
+        .nest_service("/assets", ServeDir::new(state.static_dir.join("assets")))
+        .fallback_service(dir)
+        .layer(SetResponseHeaderLayer::if_not_present(
+            HeaderName::from_static("x-content-type-options"),
+            HeaderValue::from_static("nosniff"),
+        ))
+}
 
