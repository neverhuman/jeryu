+use axum::{http::StatusCode, response::{IntoResponse, Response}, Json};
+use serde::Serialize;
+
+#[derive(Debug, thiserror::Error)]
+pub enum WebError {
+    #[error("not found")]
+    NotFound,
+    #[error("permission denied")]
+    PermissionDenied,
+    #[error("conflict: {0}")]
+    Conflict(String),
+    #[error("bad request: {0}")]
+    BadRequest(String),
+    #[error(transparent)]
+    Anyhow(#[from] anyhow::Error),
+}
+
+#[derive(Serialize)]
+struct ErrorBody { error: &'static str, message: String }
+
+impl IntoResponse for WebError {
+    fn into_response(self) -> Response {
+        let (status, code) = match &self {
+            WebError::NotFound => (StatusCode::NOT_FOUND, "not_found"),
+            WebError::PermissionDenied => (StatusCode::FORBIDDEN, "permission_denied"),
+            WebError::Conflict(_) => (StatusCode::CONFLICT, "conflict"),
+            WebError::BadRequest(_) => (StatusCode::BAD_REQUEST, "bad_request"),
+            WebError::Anyhow(_) => (StatusCode::INTERNAL_SERVER_ERROR, "internal_error"),
+        };
+        (status, Json(ErrorBody { error: code, message: self.to_string() })).into_response()
+    }
+}
+
+pub type WebResult<T> = Result<T, WebError>;
 
