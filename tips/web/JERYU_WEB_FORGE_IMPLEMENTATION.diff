@@
+use ammonia::Builder as HtmlSanitizer;
+use chrono::Utc;
+use comrak::{markdown_to_html, ComrakOptions};
+
+use crate::{api::repo_browser::{MarkdownHeading, RenderedMarkdown}, web::error::{WebError, WebResult}};
+
+pub fn render_markdown(path: &str, markdown: &str, renderer_version: &'static str) -> WebResult<RenderedMarkdown> {
+    let mut opts = ComrakOptions::default();
+    opts.extension.table = true;
+    opts.extension.tasklist = true;
+    opts.extension.strikethrough = true;
+    opts.extension.autolink = true;
+    opts.extension.header_ids = Some("user-content-".into());
+    opts.render.unsafe_ = false;
+
+    let raw_html = markdown_to_html(markdown, &opts);
+    let clean_html = HtmlSanitizer::default()
+        .add_tags(["details", "summary", "kbd"])
+        .add_generic_attributes(["id", "class", "aria-label", "aria-hidden"])
+        .link_rel(Some("nofollow noreferrer noopener"))
+        .clean(&raw_html)
+        .to_string();
+
+    Ok(RenderedMarkdown {
+        html: rewrite_relative_links(path, &clean_html),
+        toc: extract_headings(markdown),
+        source_sha: sha256(markdown),
+        renderer_version: renderer_version.into(),
+        rendered_at: Utc::now(),
+        cache_key: format!("{}:{}:{}", renderer_version, path, sha256(markdown)),
+        warnings: vec![],
+    })
+}
+
+fn rewrite_relative_links(_path: &str, html: &str) -> String { html.to_string() }
+
+fn extract_headings(markdown: &str) -> Vec<MarkdownHeading> {
+    markdown.lines().filter_map(|line| {
+        let hashes = line.chars().take_while(|c| *c == '#').count();
+        if (1..=6).contains(&hashes) && line.chars().nth(hashes) == Some(' ') {
+            let text = line[hashes+1..].trim().to_string();
+            Some(MarkdownHeading { level: hashes as u8, anchor: slug(&text), text })
+        } else { None }
+    }).collect()
+}
+
+fn slug(s: &str) -> String { s.to_lowercase().chars().map(|c| if c.is_ascii_alphanumeric() { c } else { '-' }).collect::<String>().trim_matches('-').to_string() }
+
+fn sha256(s: &str) -> String {
+    use sha2::{Digest, Sha256};
+    format!("{:x}", Sha256::digest(s.as_bytes()))
+}
 
