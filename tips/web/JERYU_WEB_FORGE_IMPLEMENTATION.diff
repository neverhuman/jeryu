+++ b/src/web/ws.rs
@@
+use axum::{extract::{State, WebSocketUpgrade}, response::IntoResponse};
+use axum::extract::ws::{Message, WebSocket};
+use futures::{SinkExt, StreamExt};
+
+use crate::{web::state::WebState, web_events::protocol::{ClientFrame, ServerFrame}};
+
+pub async fn upgrade(State(state): State<WebState>, ws: WebSocketUpgrade) -> impl IntoResponse {
+    ws.on_upgrade(move |socket| run_socket(state, socket))
+}
+
+async fn run_socket(state: WebState, socket: WebSocket) {
+    let (mut tx, mut rx) = socket.split();
+    let mut events = state.events.subscribe();
+    let hello = ServerFrame::hello(state.events.cursor(), vec!["repos".into(), "merge_requests".into(), "ci".into(), "agents".into()]);
+    let _ = tx.send(Message::Text(serde_json::to_string(&hello).unwrap().into())).await;
+
+    loop {
+        tokio::select! {
+            Some(Ok(msg)) = rx.next() => {
+                if let Message::Text(text) = msg {
+                    if let Ok(frame) = serde_json::from_str::<ClientFrame>(&text) {
+                        state.events.handle_client_frame(frame).await;
+                    }
+                }
+            }
+            Ok(event) = events.recv() => {
+                if tx.send(Message::Text(serde_json::to_string(&ServerFrame::event(event)).unwrap().into())).await.is_err() { break; }
+            }
+            else => break,
+        }
+    }
+}
 
