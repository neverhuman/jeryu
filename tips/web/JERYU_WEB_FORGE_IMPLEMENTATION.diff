+use std::{path::PathBuf, sync::Arc};
+
+use crate::{engine::SharedState, web_events::bus::WebEventBus};
+
+#[derive(Clone)]
+pub struct WebState {
+    pub engine: SharedState,
+    pub events: Arc<WebEventBus>,
+    pub static_dir: PathBuf,
+    pub renderer_version: &'static str,
+}
+
+impl WebState {
+    pub fn from_engine(engine: SharedState) -> Self {
+        Self {
+            engine,
+            events: Arc::new(WebEventBus::new(16_384)),
+            static_dir: std::env::var_os("JERYU_WEB_DIST")
+                .map(PathBuf::from)
+                .unwrap_or_else(|| PathBuf::from("apps/web/dist")),
+            renderer_version: "jeryu-md-v1",
+        }
