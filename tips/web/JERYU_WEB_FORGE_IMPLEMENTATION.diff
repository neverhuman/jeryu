+++ b/src/web_events/bus.rs
@@
+use std::sync::{atomic::{AtomicU64, Ordering}, Mutex};
+use std::collections::VecDeque;
+use tokio::sync::broadcast;
+
+use super::protocol::{ClientFrame, WebEvent};
+
+pub struct WebEventBus {
+    tx: broadcast::Sender<WebEvent>,
+    next_seq: AtomicU64,
+    replay: Mutex<VecDeque<WebEvent>>,
+    capacity: usize,
+}
+
+impl WebEventBus {
+    pub fn new(capacity: usize) -> Self {
+        let (tx, _) = broadcast::channel(capacity.min(65_536));
+        Self { tx, next_seq: AtomicU64::new(1), replay: Mutex::new(VecDeque::with_capacity(capacity)), capacity }
+    }
+    pub fn cursor(&self) -> u64 { self.next_seq.load(Ordering::Relaxed).saturating_sub(1) }
+    pub fn subscribe(&self) -> broadcast::Receiver<WebEvent> { self.tx.subscribe() }
+    pub fn publish(&self, mut event: WebEvent) -> u64 {
+        let seq = self.next_seq.fetch_add(1, Ordering::SeqCst);
+        event.seq = seq;
+        let mut replay = self.replay.lock().expect("web event replay lock poisoned");
+        if replay.len() >= self.capacity { replay.pop_front(); }
+        replay.push_back(event.clone());
+        let _ = self.tx.send(event);
+        seq
+    }
+    pub async fn handle_client_frame(&self, _frame: ClientFrame) { /* subscription state is per socket in phase 2 */ }
+}
 
