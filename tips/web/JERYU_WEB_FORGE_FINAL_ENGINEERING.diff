@@ -0,0 +1,47 @@
+import { useQuery } from '@tanstack/react-query';
+import { Link, useParams } from 'react-router-dom';
+import { api } from '../api/client';
+
+export function CodeBrowserPage({ mode }: { mode: 'tree' | 'blob' }) {
+  const { owner, repo, rev, '*': path = '' } = useParams();
+  const repoId = `${owner}/${repo}`;
+  const tree = useQuery({
+    enabled: mode === 'tree',
+    queryKey: ['tree', repoId, rev, path],
+    queryFn: () => api.tree(repoId, rev ?? 'HEAD', path),
+  });
+  const blob = useQuery({
+    enabled: mode === 'blob',
+    queryKey: ['blob', repoId, rev, path],
+    queryFn: () => api.blob(repoId, rev ?? 'HEAD', path),
+  });
+
+  return (
+    <section>
+      <header className="page-header">
+        <div>
+          <h1>{repoId}</h1>
+          <p className="muted">{rev}:{path || '/'}</p>
+        </div>
+        <div className="actions"><button>Branch</button><button>Find file</button><button>Copy path</button></div>
+      </header>
+      {mode === 'tree' ? (
+        <div className="panel file-list">
+          {tree.data?.entries.map((entry) => (
+            <Link key={entry.path} to={`/${owner}/${repo}/${entry.kind === 'tree' ? 'tree' : 'blob'}/${rev}/${entry.path}`}>
+              <span>{entry.kind === 'tree' ? '📁' : '📄'}</span> {entry.name}
+            </Link>
+          ))}
+        </div>
+      ) : (
+        <pre className="code-panel"><code>{blob.data?.text ?? 'Loading...'}</code></pre>
+      )}
+    </section>
+  );
+}
