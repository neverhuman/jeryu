+++ b/apps/web/src/realtime/ActivitySocketProvider.tsx
@@ -0,0 +1,85 @@
+import { createContext, useContext, useEffect, useMemo, useRef, useState, type ReactNode } from 'react';
+import { useQueryClient } from '@tanstack/react-query';
+import type { WebEventFrame } from '../api/types';
+
+interface ActivitySocketContextValue {
+  connected: boolean;
+  lastSequence?: number;
+  recent: WebEventFrame[];
+}
+
+const ActivitySocketContext = createContext<ActivitySocketContextValue>({
+  connected: false,
+  recent: [],
+});
+
+function wsUrl() {
+  const base = import.meta.env.VITE_JERYU_WS_BASE;
+  if (base) return `${base}/api/ws?topics=global,repos,ci,agents`;
+  const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
+  return `${proto}//${window.location.host}/api/ws?topics=global,repos,ci,agents`;
+}
+
+export function ActivitySocketProvider({ children }: { children: ReactNode }) {
+  const queryClient = useQueryClient();
+  const [connected, setConnected] = useState(false);
+  const [lastSequence, setLastSequence] = useState<number | undefined>();
+  const [recent, setRecent] = useState<WebEventFrame[]>([]);
+  const reconnectAttempt = useRef(0);
+
+  useEffect(() => {
+    let closed = false;
+    let socket: WebSocket | undefined;
+    let timer: number | undefined;
+
+    const connect = () => {
+      socket = new WebSocket(wsUrl());
+      socket.addEventListener('open', () => {
+        reconnectAttempt.current = 0;
+        setConnected(true);
+        socket?.send(JSON.stringify({ type: 'hello', clientId: 'browser', lastSeenSequence }));
+      });
+      socket.addEventListener('close', () => {
+        setConnected(false);
+        if (!closed) {
+          const delay = Math.min(15_000, 500 * 2 ** reconnectAttempt.current++);
+          timer = window.setTimeout(connect, delay);
+        }
+      });
+      socket.addEventListener('message', (message) => {
+        const frame = JSON.parse(message.data);
+        if (frame.type !== 'event') return;
+        const eventFrame = frame as WebEventFrame;
+        setLastSequence(eventFrame.sequence);
+        setRecent((items) => [eventFrame, ...items].slice(0, 100));
+        if (eventFrame.event.kind.startsWith('repo.')) queryClient.invalidateQueries({ queryKey: ['repos'] });
+        if (eventFrame.event.kind.startsWith('mr.')) queryClient.invalidateQueries({ queryKey: ['mergeRequests'] });
+      });
+    };
+
+    connect();
+    return () => {
+      closed = true;
+      if (timer) window.clearTimeout(timer);
+      socket?.close();
+    };
+  }, [lastSequence, queryClient]);
+
+  const value = useMemo(() => ({ connected, lastSequence, recent }), [connected, lastSequence, recent]);
+  return <ActivitySocketContext.Provider value={value}>{children}</ActivitySocketContext.Provider>;
+}
+
+export function useActivitySocket() {
+  return useContext(ActivitySocketContext);
+}
