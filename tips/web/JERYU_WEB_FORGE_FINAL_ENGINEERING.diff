+use anyhow::Result;
+use axum::{Json, Router, extract::{Path, Query, State}, routing::{get, post}};
+use serde::Deserialize;
+use std::collections::BTreeMap;
+
+use crate::api::{repository::CreateRepositoryRequestDto, web::{BootstrapDto, CurrentUserDto, ProviderSummaryDto}};
+use crate::cli::{WebAssetsCommand, WebDoctorCommand, WebServeCommand};
+
+use super::{config::WebConfig, errors::WebError, repo_admin, repo_browser, state::WebState, static_assets, ws};
+
+pub async fn serve(cmd: WebServeCommand) -> Result<i32> {
+    let config = WebConfig {
+        bind: cmd.bind.clone(),
+        public_url: cmd.public_url.clone(),
+        static_dir: cmd.static_dir.clone().or_else(|| Some("apps/web/dist".into())),
+        dev_proxy: cmd.dev_proxy,
+        ..WebConfig::default()
+    };
+    let db = crate::state::Db::open().await?;
+    let (gitlab, _) = crate::dispatch::load_client().await?;
+    let docker = crate::docker::DockerCtl::connect().unwrap_or_else(|_| crate::docker::DockerCtl::disconnected());
+    let web_state = WebState::new(db, docker, gitlab, config.clone());
+    let app = Router::new()
+        .nest("/api", api_router(web_state.clone()))
+        .merge(static_assets::router(config.clone()));
+    let listener = tokio::net::TcpListener::bind(&config.bind).await?;
+    tracing::info!(bind = %config.bind, "starting JeRyu web forge");
+    axum::serve(listener, app).await?;
+    Ok(0)
+}
+
+pub async fn doctor(cmd: WebDoctorCommand) -> Result<i32> {
+    if cmd.json {
+        println!("{{\"ok\":true,\"component\":\"jeryu-web\"}}");
+    } else {
+        println!("✅ JeRyu web configuration resolves");
+        println!("   static assets: apps/web/dist");
+        println!("   default bind: 127.0.0.1:9780");
+    }
+    Ok(0)
+}
+
+pub async fn assets(cmd: WebAssetsCommand) -> Result<i32> {
+    if cmd.check {
+        let path = std::path::Path::new("apps/web/dist/index.html");
+        anyhow::ensure!(path.exists(), "apps/web/dist/index.html is missing; run npm run web:build");
+    }
+    Ok(0)
+}
+
+pub fn api_router(state: WebState) -> Router {
+    Router::new()
+        .route("/bootstrap", get(bootstrap))
+        .route("/health", get(|| async { Json(serde_json::json!({ "ok": true })) }))
+        .route("/ws", get(ws::upgrade))
+        .route("/repos", get(repo_browser::list_repositories).post(repo_admin::create_repository))
+        .route("/repos/{repo_id}", get(repo_browser::get_repository))
+        .route("/repos/{repo_id}/tree", get(repo_browser::tree))
+        .route("/repos/{repo_id}/blob", get(repo_browser::blob))
+        .route("/repos/{repo_id}/readme", get(repo_browser::readme))
+        .route("/repos/{repo_id}/merge-requests", get(super::merge_requests::list))
+        .route("/repos/{repo_id}/merge-requests/{mr_id}", get(super::merge_requests::get))
+        .route("/repos/{repo_id}/merge-requests/{mr_id}/approve", post(super::merge_requests::approve))
+        .with_state(state)
+}
+
+async fn bootstrap(State(state): State<WebState>) -> Result<Json<BootstrapDto>, WebError> {
+    let mut features = BTreeMap::new();
+    features.insert("websocket_activity".into(), true);
+    features.insert("server_markdown".into(), true);
+    features.insert("merge_room".into(), true);
+    Ok(Json(BootstrapDto {
+        user: CurrentUserDto {
+            id: "local-admin".into(),
+            login: "local-admin".into(),
+            display_name: "Local Admin".into(),
+            avatar_url: None,
+            permissions: vec!["*".into()],
+        },
+        providers: vec![ProviderSummaryDto { id: "local".into(), kind: "local".into(), display_name: "Local repositories".into(), connected: true, read_only: false }],
+        features,
+        websocket_url: state.config.public_url.clone().unwrap_or_default() + "/api/ws",
+    }))
+}
