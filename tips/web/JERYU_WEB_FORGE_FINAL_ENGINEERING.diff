+        owner: repo_id.split('/').next().unwrap_or("local").into(),
+        name: repo_id.split('/').nth(1).unwrap_or(&repo_id).into(),
+        display_name: repo_id,
+        description: Some("Repository loaded through JeRyu Web".into()),
+        default_branch: "main".into(),
+        visibility: VisibilityDto::Private,
+        archived: false,
+        topics: vec![],
+        repo_family: None,
+        language: None,
+        open_merge_requests: 0,
+        open_issues: 0,
+        failing_checks: 0,
+        last_activity_at: Some(chrono::Utc::now()),
+        permissions: vec!["repository.read".into()],
+    }))
+}
+
+pub async fn tree(
+    Path(repo_id): Path<String>,
+    Query(query): Query<RevPathQuery>,
+    State(_state): State<WebState>,
+) -> Result<Json<TreeResponseDto>, WebError> {
+    let rev = query.rev.unwrap_or_else(|| "HEAD".into());
+    let path = query.path.unwrap_or_default();
+    Ok(Json(TreeResponseDto {
+        repo_id,
+        rev,
+        path: path.clone(),
+        breadcrumbs: breadcrumbs(&path),
+        entries: vec![
+            TreeEntryDto { name: "README.md".into(), path: "README.md".into(), kind: "blob".into(), mode: "100644".into(), size: Some(2048), sha: "demo".into(), language: Some("Markdown".into()) },
+            TreeEntryDto { name: "src".into(), path: "src".into(), kind: "tree".into(), mode: "040000".into(), size: None, sha: "demo".into(), language: None },
+        ],
+    }))
+}
+
+pub async fn blob(
+    Path(repo_id): Path<String>,
+    Query(query): Query<RevPathQuery>,
+    State(_state): State<WebState>,
+) -> Result<Json<BlobResponseDto>, WebError> {
+    let path = query.path.unwrap_or_else(|| "README.md".into());
+    Ok(Json(BlobResponseDto {
+        repo_id,
+        rev: query.rev.unwrap_or_else(|| "HEAD".into()),
+        path,
+        sha: "demo".into(),
+        language: Some("Markdown".into()),
+        encoding: "utf8".into(),
+        size: 128,
+        text: Some("# README\n\nThis blob is served by JeRyu Web.".into()),
+        truncated: false,
+    }))
+}
+
+pub async fn readme(
+    Path(_repo_id): Path<String>,
+    Query(query): Query<RevPathQuery>,
+    State(_state): State<WebState>,
+) -> Result<Json<crate::api::code::RenderedReadmeDto>, WebError> {
+    let rev = query.rev.unwrap_or_else(|| "HEAD".into());
+    Ok(Json(markdown::render_markdown(
+        "README.md",
+        &rev,
+        "demo",
+        "# JeRyu\n\nRendered by the Rust Markdown pipeline.\n\n- Safe HTML\n- GFM tables\n- TOC extraction",
+    )))
+}
+
+fn breadcrumbs(path: &str) -> Vec<BreadcrumbDto> {
+    let mut out = vec![BreadcrumbDto { label: "root".into(), path: "".into() }];
+    let mut current = String::new();
+    for part in path.split('/').filter(|p| !p.is_empty()) {
+        if !current.is_empty() { current.push('/'); }
+        current.push_str(part);
+        out.push(BreadcrumbDto { label: part.into(), path: current.clone() });
+    }
+    out
+}
