+import type { ReactNode } from 'react';
+import { Link } from 'react-router-dom';
+import { Bell, GitPullRequest, Plus, Search, Settings } from 'lucide-react';
+import { useActivitySocket } from '../realtime/ActivitySocketProvider';
+import { CommandPalette } from './CommandPalette';
+
+export function AppShell({ children }: { children: ReactNode }) {
+  const { connected, recent } = useActivitySocket();
+
+  return (
+    <div className="app-shell">
+      <header className="topbar">
+        <Link className="brand" to="/dashboard">JeRyu</Link>
+        <button className="search-button"><Search size={16} /> Search or jump to...</button>
+        <Link className="icon-button" to="/new" title="Create"><Plus size={18} /></Link>
+        <Link className="icon-button" to="/merge-requests" title="Merge requests"><GitPullRequest size={18} /></Link>
+        <Link className="icon-button" to="/settings" title="Settings"><Settings size={18} /></Link>
+        <button className="icon-button" title="Notifications"><Bell size={18} /></button>
+        <span className={connected ? 'live live-on' : 'live'}>{connected ? 'live' : 'offline'}</span>
+      </header>
+      <div className="body-grid">
+        <aside className="sidebar">
+          <Link to="/dashboard">Repositories</Link>
+          <Link to="/activity">Activity</Link>
+          <Link to="/merge-requests">Merge requests</Link>
+          <Link to="/issues">Issues</Link>
+          <Link to="/ci">CI/CD</Link>
+          <Link to="/agents">Agents</Link>
+          <Link to="/settings">Settings</Link>
+        </aside>
+        <main className="main-panel">{children}</main>
+        <aside className="activity-rail">
+          <h2>Live activity</h2>
+          {recent.length === 0 ? <p className="muted">No live events yet.</p> : null}
+          {recent.map((frame) => (
+            <article key={frame.sequence} className="event-card">
+              <strong>{frame.event.kind}</strong>
+              <span>#{frame.sequence}</span>
+            </article>
+          ))}
+        </aside>
+      </div>
+      <CommandPalette />
+    </div>
+  );
+}
