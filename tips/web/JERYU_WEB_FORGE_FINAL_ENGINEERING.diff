--- /dev/null
+++ b/apps/web/src/pages/MergeRequestPage.tsx
@@ -0,0 +1,55 @@
+import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
+import { useParams } from 'react-router-dom';
+import { api } from '../api/client';
+
+export function MergeRequestPage() {
+  const { owner, repo, id = '' } = useParams();
+  const repoId = `${owner}/${repo}`;
+  const queryClient = useQueryClient();
+  const mr = useQuery({ queryKey: ['mergeRequest', repoId, id], queryFn: () => api.mergeRequest(repoId, id) });
+  const approve = useMutation({
+    mutationFn: () => api.approveMergeRequest(repoId, id, mr.data!.headSha),
+    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['mergeRequest', repoId, id] }),
+  });
+  const data = mr.data;
+
+  return (
+    <section>
+      <header className="page-header">
+        <div>
+          <h1>{data?.title ?? `Merge request ${id}`}</h1>
+          <p className="muted">{data?.sourceBranch} → {data?.targetBranch}</p>
+        </div>
+        <div className="actions">
+          <button onClick={() => approve.mutate()} disabled={!data || approve.isPending}>Approve exact SHA</button>
+          <button>Request changes</button>
+          <button className="primary">Merge when ready</button>
+        </div>
+      </header>
+      <div className="merge-room-grid">
+        <aside className="panel">
+          <h2>Files</h2>
+          <p className="muted">Changed files load here with viewed/commented state.</p>
+        </aside>
+        <main className="panel">
+          <h2>Review</h2>
+          <p className="muted">Diff hunks, inline threads, commits, and checks are shown in tabs.</p>
+        </main>
+        <aside className="panel readiness">
+          <h2>Merge readiness</h2>
+          {data?.blockingReasons.length ? data.blockingReasons.map((reason) => <p key={reason}>⛔ {reason}</p>) : <p>Ready.</p>}
+          <p>Approvals: {data?.approvals ?? 0}/{data?.requiredApprovals ?? 0}</p>
+          {data?.checks.map((check) => <p key={check.name}>{check.state} · {check.name}</p>)}
+        </aside>
+      </div>
+    </section>
+  );
+}
