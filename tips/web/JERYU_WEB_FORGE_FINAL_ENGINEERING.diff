@@ -0,0 +1,49 @@
+import { useMemo, useState } from 'react';
+import { useQuery } from '@tanstack/react-query';
+import { Link } from 'react-router-dom';
+import { api } from '../api/client';
+
+export function DashboardPage() {
+  const [filter, setFilter] = useState('');
+  const repos = useQuery({ queryKey: ['repos'], queryFn: () => api.repos() });
+  const visible = useMemo(() => {
+    const q = filter.toLowerCase();
+    return (repos.data ?? []).filter((repo) =>
+      [repo.owner, repo.name, repo.description, repo.language, repo.repoFamily]
+        .filter(Boolean)
+        .some((value) => String(value).toLowerCase().includes(q)),
+    );
+  }, [filter, repos.data]);
+
+  return (
+    <section>
+      <header className="page-header">
+        <div>
+          <h1>All repositories</h1>
+          <p className="muted">Search, group, create, and monitor every repo in real time.</p>
+        </div>
+        <Link className="primary" to="/new">New repository</Link>
+      </header>
+      <div className="toolbar">
+        <input value={filter} onChange={(e) => setFilter(e.target.value)} placeholder="Filter repositories" />
+        <button>Provider</button>
+        <button>Family</button>
+        <button>Status</button>
+        <button>Sort: activity</button>
+      </div>
+      {repos.isLoading ? <p>Loading repositories...</p> : null}
+      {repos.isError ? <p className="error">Could not load repositories.</p> : null}
+      <div className="repo-grid">
+        {visible.map((repo) => (
+          <Link key={repo.id} className="repo-card" to={`/${repo.owner}/${repo.name}`}>
+            <strong>{repo.owner}/{repo.name}</strong>
+            <span>{repo.description ?? 'No description'}</span>
+            <small>{repo.visibility} · {repo.openMergeRequests} MRs · {repo.failingChecks} failing</small>
+          </Link>
+        ))}
+      </div>
+    </section>
+  );
+}
