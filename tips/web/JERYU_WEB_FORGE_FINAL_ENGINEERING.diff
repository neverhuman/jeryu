--- /dev/null
+++ b/src/web/ws.rs
@@ -0,0 +1,55 @@
+use axum::{extract::{State, ws::{Message, WebSocket, WebSocketUpgrade}}, response::IntoResponse};
+use futures_util::{SinkExt, StreamExt};
+use serde_json::json;
+
+use super::state::WebState;
+
+pub async fn upgrade(State(state): State<WebState>, ws: WebSocketUpgrade) -> impl IntoResponse {
+    ws.on_upgrade(move |socket| handle_socket(state, socket))
+}
+
+async fn handle_socket(state: WebState, socket: WebSocket) {
+    let (mut tx, mut rx) = socket.split();
+    let mut events = state.events.subscribe();
+    let _ = tx
+        .send(Message::Text(
+            json!({ "type": "hello", "serverId": "jeryu-web", "heartbeatMs": 20_000, "maxReplay": state.config.websocket_replay_limit }).to_string(),
+        ))
+        .await;
+
+    let mut heartbeat = tokio::time::interval(std::time::Duration::from_secs(20));
+    loop {
+        tokio::select! {
+            Ok(frame) = events.recv() => {
+                if tx.send(Message::Text(serde_json::to_string(&frame).unwrap_or_default())).await.is_err() {
+                    break;
+                }
+            }
+            Some(Ok(Message::Text(text))) = rx.next() => {
+                if text.contains("ping") {
+                    let _ = tx.send(Message::Text(json!({ "type": "pong", "serverTime": chrono::Utc::now() }).to_string())).await;
+                }
+            }
+            _ = heartbeat.tick() => {
+                let _ = tx.send(Message::Text(json!({ "type": "pong", "serverTime": chrono::Utc::now() }).to_string())).await;
+            }
+            else => break,
+        }
+    }
+}
