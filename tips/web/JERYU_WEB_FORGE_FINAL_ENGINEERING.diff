+import type { RenderedReadme } from '../api/types';
+
+export function MarkdownHtml({ readme }: { readme: RenderedReadme }) {
+  return (
+    <section className="markdown-card">
+      <header className="panel-header">
+        <div>
+          <h2>{readme.path}</h2>
+          <p className="muted">Rendered at {new Date(readme.renderedAt).toLocaleString()}</p>
+        </div>
+      </header>
+      {readme.warnings.length > 0 ? (
+        <div className="warning">Sanitized content: {readme.warnings.join(', ')}</div>
+      ) : null}
+      <article
+        className="markdown-body"
+        // HTML is generated and sanitized by Rust. Do not render repo Markdown client-side.
+        dangerouslySetInnerHTML={{ __html: readme.html }}
+      />
+    </section>
+  );
+}
diff --git a/apps/web/src/components/ReadmePanel.tsx b/apps/web/src/components/ReadmePanel.tsx
new file mode 100644
index 0000000..762214f
--- /dev/null
+++ b/apps/web/src/components/ReadmePanel.tsx
@@ -0,0 +1,19 @@
+import { useQuery } from '@tanstack/react-query';
+import { api } from '../api/client';
+import { MarkdownHtml } from './MarkdownHtml';
+
+export function ReadmePanel({ repoId, rev = 'HEAD' }: { repoId: string; rev?: string }) {
+  const query = useQuery({ queryKey: ['readme', repoId, rev], queryFn: () => api.readme(repoId, rev) });
+  if (query.isLoading) return <section className="panel">Loading README...</section>;
+  if (query.isError) return <section className="panel error">README could not be rendered.</section>;
+  if (!query.data) return <section className="panel empty">No README found.</section>;
+  return <MarkdownHtml readme={query.data} />;
+}
