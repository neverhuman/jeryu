--- /dev/null
+++ b/src/web/markdown.rs
@@ -0,0 +1,74 @@
+use pulldown_cmark::{html, Options, Parser};
+
+use crate::api::code::{RenderedReadmeDto, TocItemDto};
+
+pub fn render_markdown(path: &str, rev: &str, source_sha: &str, source: &str) -> RenderedReadmeDto {
+    let mut options = Options::empty();
+    options.insert(Options::ENABLE_TABLES);
+    options.insert(Options::ENABLE_FOOTNOTES);
+    options.insert(Options::ENABLE_STRIKETHROUGH);
+    options.insert(Options::ENABLE_TASKLISTS);
+    let parser = Parser::new_ext(source, options);
+    let mut unsafe_html = String::new();
+    html::push_html(&mut unsafe_html, parser);
+    let clean = ammonia::Builder::default()
+        .add_tags(["details", "summary", "kbd"])
+        .add_generic_attributes(["id", "class"])
+        .clean(&unsafe_html)
+        .to_string();
+    RenderedReadmeDto {
+        path: path.to_string(),
+        rev: rev.to_string(),
+        source_sha: source_sha.to_string(),
+        html: clean,
+        toc: extract_toc(source),
+        warnings: vec![],
+        rendered_at: chrono::Utc::now(),
+    }
+}
+
+fn extract_toc(source: &str) -> Vec<TocItemDto> {
+    source
+        .lines()
+        .filter_map(|line| {
+            let hashes = line.chars().take_while(|c| *c == '#').count();
+            if hashes == 0 || hashes > 6 || !line.chars().nth(hashes).is_some_and(|c| c == ' ') {
+                return None;
+            }
+            let text = line[hashes + 1..].trim().to_string();
+            let id = text.to_lowercase().chars().map(|c| if c.is_ascii_alphanumeric() { c } else { '-' }).collect();
+            Some(TocItemDto { id, depth: hashes as u8, text })
+        })
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn strips_script_tags() {
+        let rendered = render_markdown("README.md", "HEAD", "sha", "# Hi\n<script>alert(1)</script>");
+        assert!(!rendered.html.contains("script"));
+        assert_eq!(rendered.toc[0].text, "Hi");
+    }
+}
