new file mode 100644
index 0000000..e57a817
--- /dev/null
+++ b/src/web/event_hub.rs
@@ -0,0 +1,54 @@
+use async_broadcast::{Receiver, Sender};
+use serde::{Deserialize, Serialize};
+use std::sync::atomic::{AtomicU64, Ordering};
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct WebEventFrame {
+    pub r#type: String,
+    pub sequence: u64,
+    pub topic: String,
+    pub event: serde_json::Value,
+}
+
+pub struct EventHub {
+    sequence: AtomicU64,
+    sender: Sender<WebEventFrame>,
+}
+
+impl EventHub {
+    pub fn new() -> Self {
+        let (sender, _receiver) = async_broadcast::broadcast(1024);
+        sender.set_overflow(true);
+        Self { sequence: AtomicU64::new(1), sender }
+    }
+
+    pub fn subscribe(&self) -> Receiver<WebEventFrame> {
+        self.sender.new_receiver()
+    }
+
+    pub async fn publish(&self, topic: impl Into<String>, event: serde_json::Value) {
+        let frame = WebEventFrame {
+            r#type: "event".into(),
+            sequence: self.sequence.fetch_add(1, Ordering::Relaxed),
+            topic: topic.into(),
+            event,
+        };
+        let _ = self.sender.broadcast(frame).await;
+    }
+}
