+use super::errors::WebError;
+
+#[derive(Debug, Clone)]
+pub struct Principal {
+    pub login: String,
+    pub permissions: Vec<String>,
+}
+
+pub fn require(principal: &Principal, permission: &str) -> Result<(), WebError> {
+    if principal.permissions.iter().any(|p| p == "*" || p == permission) {
+        return Ok(());
+    }
+    Err(WebError::PermissionDenied(permission.to_string()))
+}
