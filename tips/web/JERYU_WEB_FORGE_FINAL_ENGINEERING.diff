+use axum::{Json, extract::State};
+
+use crate::api::repository::{CreateRepositoryRequestDto, RepositorySummaryDto};
+
+use super::{errors::WebError, state::WebState};
+
+pub async fn create_repository(
+    State(state): State<WebState>,
+    Json(input): Json<CreateRepositoryRequestDto>,
+) -> Result<Json<RepositorySummaryDto>, WebError> {
+    validate_repo_name(&input.name)?;
+    let repo = RepositorySummaryDto {
+        id: format!("{}/{}", input.owner, input.name),
+        provider: input.provider,
+        owner: input.owner,
+        name: input.name.clone(),
+        display_name: input.name,
+        description: input.description,
+        default_branch: input.default_branch,
+        visibility: input.visibility,
+        archived: false,
+        topics: vec![],
+        repo_family: None,
+        language: None,
+        open_merge_requests: 0,
+        open_issues: 0,
+        failing_checks: 0,
+        last_activity_at: Some(chrono::Utc::now()),
+        permissions: vec!["repository.read".into(), "repository.write".into()],
+    };
+    state.events.publish("repos", serde_json::json!({ "kind": "repo.created", "repo": repo })).await;
+    Ok(Json(repo))
+}
+
+fn validate_repo_name(name: &str) -> Result<(), WebError> {
+    if name.is_empty() || !name.chars().all(|c| c.is_ascii_alphanumeric() || matches!(c, '-' | '_' | '.')) {
+        return Err(WebError::BadRequest("repository name must be ascii alnum plus - _ .".into()));
+    }
+    Ok(())
+}
