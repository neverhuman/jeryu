+use axum::{Json, extract::{Path, State}};
+
+use crate::api::merge_request::{ApproveMergeRequestDto, CheckSummaryDto, MergeRequestSummaryDto};
+
+use super::{errors::WebError, state::WebState};
+
+pub async fn list(Path(repo_id): Path<String>, State(_state): State<WebState>) -> Result<Json<Vec<MergeRequestSummaryDto>>, WebError> {
+    Ok(Json(vec![demo_mr(&repo_id, "1")]))
+}
+
+pub async fn get(Path((repo_id, mr_id)): Path<(String, String)>, State(_state): State<WebState>) -> Result<Json<MergeRequestSummaryDto>, WebError> {
+    Ok(Json(demo_mr(&repo_id, &mr_id)))
+}
+
+pub async fn approve(
+    Path((repo_id, mr_id)): Path<(String, String)>,
+    State(state): State<WebState>,
+    Json(input): Json<ApproveMergeRequestDto>,
+) -> Result<Json<serde_json::Value>, WebError> {
+    if input.head_sha.trim().is_empty() {
+        return Err(WebError::BadRequest("head_sha is required for exact-SHA approval".into()));
+    }
+    state.events.publish(
+        format!("mr:{mr_id}"),
+        serde_json::json!({ "kind": "mr.updated", "repoId": repo_id, "mrId": mr_id, "patch": { "approvals": 1 } }),
+    ).await;
+    Ok(Json(serde_json::json!({ "receipt": "sha256:demo", "approvedHeadSha": input.head_sha })))
+}
+
+fn demo_mr(repo_id: &str, mr_id: &str) -> MergeRequestSummaryDto {
+    MergeRequestSummaryDto {
+        id: mr_id.into(),
+        repo_id: repo_id.into(),
+        iid: mr_id.into(),
+        title: "Wire JeRyu Web Forge".into(),
+        state: "open".into(),
+        draft: false,
+        author: "local-admin".into(),
+        source_branch: "web-forge".into(),
+        target_branch: "main".into(),
+        head_sha: "demo-head-sha".into(),
+        labels: vec!["web".into(), "forge".into()],
+        approvals: 0,
+        required_approvals: 1,
+        checks: vec![CheckSummaryDto { name: "jeryu/web-proof".into(), state: "running".into(), description: Some("Web proof lane".into()), details_url: None, updated_at: Some(chrono::Utc::now()) }],
+        unread_threads: 0,
+        mergeable: false,
+        blocking_reasons: vec!["required approval missing".into(), "checks still running".into()],
+        updated_at: chrono::Utc::now(),
+    }
+}
