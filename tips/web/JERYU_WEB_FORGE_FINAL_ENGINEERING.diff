@@ -0,0 +1,36 @@
+import { useEffect, useState } from 'react';
+
+const commands = [
+  'Create repository',
+  'Import repository',
+  'Open merge requests',
+  'Open failing pipelines',
+  'Open global settings',
+  'Toggle activity rail',
+];
+
+export function CommandPalette() {
+  const [open, setOpen] = useState(false);
+  useEffect(() => {
+    const onKey = (event: KeyboardEvent) => {
+      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
+        event.preventDefault();
+        setOpen((value) => !value);
+      }
+      if (event.key === 'Escape') setOpen(false);
+    };
+    window.addEventListener('keydown', onKey);
+    return () => window.removeEventListener('keydown', onKey);
+  }, []);
+
+  if (!open) return null;
+  return (
+    <div className="palette-backdrop" role="dialog" aria-modal="true">
+      <div className="palette">
+        <input autoFocus placeholder="Run command..." aria-label="Run command" />
+        {commands.map((command) => <button key={command}>{command}</button>)}
+      </div>
+    </div>
+  );
+}
