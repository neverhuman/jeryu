+export type Visibility = 'private' | 'internal' | 'public';
+export type CheckState = 'queued' | 'running' | 'success' | 'failed' | 'blocked' | 'skipped';
+
+export interface ApiEnvelope<T> {
+  data: T;
+  meta?: {
+    requestId?: string;
+    freshness?: 'live' | 'cached' | 'stale';
+    servedAt?: string;
+  };
+}
+
+export interface CurrentUser {
+  id: string;
+  login: string;
+  displayName: string;
+  avatarUrl?: string;
+  permissions: string[];
+}
+
+export interface BootstrapResponse {
+  user: CurrentUser;
+  providers: ProviderSummary[];
+  features: Record<string, boolean>;
+  websocketUrl: string;
+}
+
+export interface ProviderSummary {
+  id: string;
+  kind: 'local' | 'gitlab' | 'github';
+  displayName: string;
+  connected: boolean;
+  readOnly: boolean;
+}
+
+export interface RepositorySummary {
+  id: string;
+  provider: string;
+  owner: string;
+  name: string;
+  displayName: string;
+  description?: string;
+  defaultBranch: string;
+  visibility: Visibility;
+  archived: boolean;
+  topics: string[];
+  repoFamily?: string;
+  language?: string;
+  openMergeRequests: number;
+  openIssues: number;
+  failingChecks: number;
+  lastActivityAt?: string;
+  permissions: string[];
+}
+
+export interface CreateRepositoryRequest {
+  provider: string;
+  owner: string;
+  name: string;
+  description?: string;
+  visibility: Visibility;
+  initializeReadme: boolean;
+  defaultBranch: string;
+}
+
+export interface TreeEntry {
+  name: string;
+  path: string;
+  kind: 'tree' | 'blob' | 'submodule';
+  mode: string;
+  size?: number;
+  sha: string;
+  language?: string;
+}
+
+export interface TreeResponse {
+  repoId: string;
+  rev: string;
+  path: string;
+  entries: TreeEntry[];
+  breadcrumbs: Array<{ label: string; path: string }>;
+}
+
+export interface BlobResponse {
+  repoId: string;
+  rev: string;
+  path: string;
+  sha: string;
+  language?: string;
+  encoding: 'utf8' | 'base64' | 'binary';
+  size: number;
+  text?: string;
+  truncated: boolean;
+}
+
+export interface RenderedReadme {
+  path: string;
+  rev: string;
+  sourceSha: string;
+  html: string;
+  toc: Array<{ id: string; depth: number; text: string }>;
+  warnings: string[];
+  renderedAt: string;
+}
+
+export interface CheckSummary {
+  name: string;
+  state: CheckState;
+  description?: string;
+  detailsUrl?: string;
+  updatedAt?: string;
+}
+
+export interface MergeRequestSummary {
+  id: string;
+  repoId: string;
+  iid: string;
+  title: string;
+  state: 'open' | 'merged' | 'closed';
+  draft: boolean;
+  author: string;
+  sourceBranch: string;
+  targetBranch: string;
+  headSha: string;
+  labels: string[];
+  approvals: number;
+  requiredApprovals: number;
+  checks: CheckSummary[];
+  unreadThreads: number;
+  mergeable: boolean;
+  blockingReasons: string[];
+  updatedAt: string;
+}
+
+export interface WebEventFrame {
+  type: 'event';
+  sequence: number;
+  topic: string;
+  event: WebEvent;
+}
+
+export type WebEvent =
+  | { kind: 'repo.created'; repo: RepositorySummary }
+  | { kind: 'repo.updated'; repoId: string; patch: Partial<RepositorySummary> }
+  | { kind: 'mr.updated'; repoId: string; mrId: string; patch: Partial<MergeRequestSummary> }
+  | { kind: 'pipeline.updated'; repoId: string; pipelineId: string; state: CheckState }
+  | { kind: 'job.log.appended'; jobId: string; offset: number; text: string }
+  | { kind: 'settings.updated'; scope: string; key: string; actor: string }
+  | { kind: 'notification.created'; id: string; title: string; href?: string };
diff --git a/apps/web/src/api/client.ts b/apps/web/src/api/client.ts
new file mode 100644
index 0000000..33a24cd
--- /dev/null
+++ b/apps/web/src/api/client.ts
@@ -0,0 +1,86 @@
+import type {
+  ApiEnvelope,
+  BlobResponse,
+  BootstrapResponse,
+  CreateRepositoryRequest,
+  MergeRequestSummary,
+  RenderedReadme,
+  RepositorySummary,
+  TreeResponse,
+} from './types';
+
+export class ApiError extends Error {
+  constructor(
+    message: string,
+    public readonly status: number,
+    public readonly code?: string,
+    public readonly details?: unknown,
+  ) {
+    super(message);
+  }
+}
+
+const API_BASE = import.meta.env.VITE_JERYU_API_BASE ?? '';
+
+async function request<T>(path: string, init: RequestInit = {}): Promise<T> {
+  const response = await fetch(`${API_BASE}${path}`, {
+    credentials: 'include',
+    headers: {
+      'content-type': 'application/json',
+      ...(init.headers ?? {}),
+    },
+    ...init,
+  });
+
+  const text = await response.text();
+  const json = text ? JSON.parse(text) : undefined;
+
+  if (!response.ok) {
+    const err = json?.error ?? {};
+    throw new ApiError(err.message ?? response.statusText, response.status, err.code, err.details);
+  }
+
+  return (json?.data ?? json) as T;
+}
+
+export const api = {
+  bootstrap: () => request<BootstrapResponse>('/api/bootstrap'),
+  repos: (search = '') => request<RepositorySummary[]>(`/api/repos${search}`),
+  createRepo: (input: CreateRepositoryRequest) =>
+    request<RepositorySummary>('/api/repos', { method: 'POST', body: JSON.stringify(input) }),
+  repo: (repoId: string) => request<RepositorySummary>(`/api/repos/${repoId}`),
+  readme: (repoId: string, rev = 'HEAD') =>
+    request<RenderedReadme>(`/api/repos/${repoId}/readme?rev=${encodeURIComponent(rev)}`),
+  tree: (repoId: string, rev: string, path: string) =>
+    request<TreeResponse>(
+      `/api/repos/${repoId}/tree?rev=${encodeURIComponent(rev)}&path=${encodeURIComponent(path)}`,
+    ),
+  blob: (repoId: string, rev: string, path: string) =>
+    request<BlobResponse>(
+      `/api/repos/${repoId}/blob?rev=${encodeURIComponent(rev)}&path=${encodeURIComponent(path)}`,
+    ),
+  mergeRequests: (repoId: string) =>
+    request<MergeRequestSummary[]>(`/api/repos/${repoId}/merge-requests`),
+  mergeRequest: (repoId: string, id: string) =>
+    request<MergeRequestSummary>(`/api/repos/${repoId}/merge-requests/${id}`),
+  approveMergeRequest: (repoId: string, id: string, headSha: string) =>
+    request(`/api/repos/${repoId}/merge-requests/${id}/approve`, {
+      method: 'POST',
+      body: JSON.stringify({ headSha }),
+    }),
+};
