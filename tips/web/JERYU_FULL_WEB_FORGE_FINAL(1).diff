new file mode 100644
--- /dev/null
+++ b/src/web/ws.rs
@@
+use axum::{extract::{State, WebSocketUpgrade}, response::IntoResponse};
+use axum::extract::ws::{Message, WebSocket};
+use futures_util::{SinkExt, StreamExt};
+
+use crate::web::state::WebAppState;
+use crate::web_events::protocol::{ClientMessage, ServerFrame};
+
+pub async fn ws_handler(State(state): State<WebAppState>, ws: WebSocketUpgrade) -> impl IntoResponse {
+    ws.on_upgrade(move |socket| handle_socket(state, socket))
+}
+
+async fn handle_socket(state: WebAppState, socket: WebSocket) {
+    let (mut sender, mut receiver) = socket.split();
+    let hello = ServerFrame::HelloAck { server_version: env!("CARGO_PKG_VERSION").into(), cursor: state.events.cursor(), heartbeat_ms: 20_000 };
+    let _ = sender.send(Message::Text(serde_json::to_string(&hello).unwrap().into())).await;
+    while let Some(Ok(message)) = receiver.next().await {
+        if let Message::Text(text) = message {
+            match serde_json::from_str::<ClientMessage>(&text) {
+                Ok(ClientMessage::Ping { nonce }) => {
+                    let frame = ServerFrame::Pong { nonce };
+                    let _ = sender.send(Message::Text(serde_json::to_string(&frame).unwrap().into())).await;
+                }
+                Ok(_) => {}
+                Err(err) => {
+                    let frame = ServerFrame::Error { code: "bad_message".into(), message: err.to_string() };
+                    let _ = sender.send(Message::Text(serde_json::to_string(&frame).unwrap().into())).await;
+                }
+            }
+        }
+    }
+}

