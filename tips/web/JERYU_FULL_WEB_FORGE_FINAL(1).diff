+++ b/src/web_events/bus.rs
@@
+use std::sync::atomic::{AtomicU64, Ordering};
+use tokio::sync::broadcast;
+
+use crate::web_events::protocol::EventEnvelope;
+
+pub struct WebEventBus { cursor: AtomicU64, tx: broadcast::Sender<EventEnvelope> }
+
+impl Default for WebEventBus {
+    fn default() -> Self {
+        let (tx, _rx) = broadcast::channel(4096);
+        Self { cursor: AtomicU64::new(0), tx }
+    }
+}
+
+impl WebEventBus {
+    pub fn cursor(&self) -> u64 { self.cursor.load(Ordering::Relaxed) }
+    pub fn subscribe(&self) -> broadcast::Receiver<EventEnvelope> { self.tx.subscribe() }
+    pub fn publish(&self, mut event: EventEnvelope) {
+        event.cursor = self.cursor.fetch_add(1, Ordering::SeqCst) + 1;
+        let _ = self.tx.send(event);
+    }
+}

