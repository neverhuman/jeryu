+  ci_json TEXT NOT NULL DEFAULT '{}',
+  agents_json TEXT NOT NULL DEFAULT '{}',
+  security_json TEXT NOT NULL DEFAULT '{}',
+  updated_at TEXT NOT NULL
+);

