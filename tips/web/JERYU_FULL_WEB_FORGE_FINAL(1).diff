+++ b/apps/web/src/realtime/ActivitySocketProvider.tsx
@@
+import React from 'react';
+
+type ActivitySocketContextValue = {
+  connected: boolean;
+  subscribe: (topics: string[]) => void;
+  unsubscribe: (topics: string[]) => void;
+};
+
+const ActivitySocketContext = React.createContext<ActivitySocketContextValue | null>(null);
+
+export function ActivitySocketProvider({ children }: { children: React.ReactNode }) {
+  const wsRef = React.useRef<WebSocket | null>(null);
+  const [connected, setConnected] = React.useState(false);
+
+  React.useEffect(() => {
+    const scheme = window.location.protocol === 'https:' ? 'wss' : 'ws';
+    const socket = new WebSocket(`${scheme}://${window.location.host}/api/ws`);
+    wsRef.current = socket;
+    socket.onopen = () => {
+      setConnected(true);
+      socket.send(JSON.stringify({ type: 'hello', client_id: crypto.randomUUID(), last_cursor: 0 }));
+    };
+    socket.onclose = () => setConnected(false);
+    socket.onmessage = (event) => {
+      // Phase 0 stores events in React Query invalidations; Phase 1 adds reducer by entity/topic.
+      console.debug('jeryu event', event.data);
+    };
+    return () => socket.close();
+  }, []);
+
+  const value = React.useMemo<ActivitySocketContextValue>(() => ({
+    connected,
+    subscribe: (topics) => wsRef.current?.send(JSON.stringify({ type: 'subscribe', topics })),
+    unsubscribe: (topics) => wsRef.current?.send(JSON.stringify({ type: 'unsubscribe', topics })),
+  }), [connected]);
+
+  return <ActivitySocketContext.Provider value={value}>{children}</ActivitySocketContext.Provider>;
+}
+
+export function useActivitySocket() {
+  const value = React.useContext(ActivitySocketContext);
+  if (!value) throw new Error('useActivitySocket must be used inside ActivitySocketProvider');
+  return value;
+}

