+export class ApiError extends Error {
+  constructor(
+    message: string,
+    public readonly status: number,
+    public readonly code?: string,
+    public readonly details?: unknown,
+  ) {
+    super(message);
+  }
+}
+
+type ApiOptions = RequestInit & { signal?: AbortSignal };
+
+async function request<T>(path: string, options: ApiOptions = {}): Promise<T> {
+  const response = await fetch(path, {
+    credentials: 'same-origin',
+    headers: {
+      'content-type': 'application/json',
+      ...(options.headers ?? {}),
+    },
+    ...options,
+  });
+
+  if (!response.ok) {
+    const body = await response.json().catch(() => ({}));
+    throw new ApiError(body.message ?? response.statusText, response.status, body.code, body.details);
+  }
+
+  if (response.status === 204) return undefined as T;
+  return (await response.json()) as T;
+}
+
+export const api = {
+  bootstrap: () => request<BootstrapView>('/api/bootstrap'),
+  repos: (query = '') => request<RepositoryListView>(`/api/repos${query}`),
+  repo: (owner: string, repo: string) => request<RepositoryOverview>(`/api/repos/${owner}/${repo}`),
+  readme: (owner: string, repo: string, ref = 'HEAD') => request<MarkdownView>(`/api/repos/${owner}/${repo}/readme/${encodeURIComponent(ref)}`),
+  tree: (owner: string, repo: string, ref: string, path = '') => request<TreeView>(`/api/repos/${owner}/${repo}/tree/${encodeURIComponent(ref)}/${path}`),
+  blob: (owner: string, repo: string, ref: string, path: string) => request<BlobView>(`/api/repos/${owner}/${repo}/blob/${encodeURIComponent(ref)}/${path}`),
+  previewAction: (input: ActionRequest) => request<ActionPreview>('/api/actions/preview', { method: 'POST', body: JSON.stringify(input) }),
+  executeAction: (input: ActionExecuteRequest) => request<ActionReceipt>('/api/actions/execute', { method: 'POST', body: JSON.stringify(input) }),
+};
+
+// Replaced by generated Rust-owned TS in Phase 0. Kept here so the first Vite shell compiles.
+export type EntityRef = { kind: string; id: string; label?: string; href?: string };
+export type BootstrapView = { user: { id: string; username: string }; capabilities: string[]; event_cursor: number; pinned_repos: RepositorySummary[] };
+export type RepositorySummary = { id: string; owner: string; name: string; slug: string; visibility: string; provider: string; default_branch: string; health: 'ok' | 'warning' | 'failing'; last_activity_at?: string };
+export type RepositoryListView = { repos: RepositorySummary[]; total: number; next_cursor?: string };
+export type RepositoryOverview = RepositorySummary & { description?: string; readme?: MarkdownView; stats: Record<string, number> };
+export type TreeView = { repo: EntityRef; ref_name: string; path: string; entries: TreeEntry[] };
+export type TreeEntry = { name: string; path: string; kind: 'tree' | 'blob' | 'submodule'; size?: number; sha: string };
+export type BlobView = { path: string; sha: string; mime: string; size: number; is_binary: boolean; content_base64?: string; text?: string };
+export type MarkdownView = { path: string; blob_sha: string; html: string; toc: { id: string; text: string; level: number }[]; warnings: string[] };
+export type ActionRequest = { kind: string; entity?: EntityRef; input: unknown };
+export type ActionPreview = { preview_id: string; kind: string; risk: 'low' | 'medium' | 'high' | 'destructive'; allowed: boolean; confirmation?: string; side_effects: string[] };
+export type ActionExecuteRequest = { preview_id: string; idempotency_key: string; confirmation?: string };
+export type ActionReceipt = { action_id: string; status: 'queued' | 'running' | 'succeeded' | 'failed'; evidence_ref?: string };

