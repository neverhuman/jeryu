+use ammonia::Builder;
+use pulldown_cmark::{html, Options, Parser};
+
+use crate::api::repo_browser::{MarkdownView, TocEntry};
+
+#[derive(Default)]
+pub struct MarkdownRenderer;
+
+impl MarkdownRenderer {
+    pub fn render(&self, path: &str, markdown: &str, blob_sha: &str) -> anyhow::Result<MarkdownView> {
+        let mut options = Options::empty();
+        options.insert(Options::ENABLE_TABLES);
+        options.insert(Options::ENABLE_TASKLISTS);
+        options.insert(Options::ENABLE_STRIKETHROUGH);
+        options.insert(Options::ENABLE_FOOTNOTES);
+
+        let parser = Parser::new_ext(markdown, options);
+        let mut unsafe_html = String::new();
+        html::push_html(&mut unsafe_html, parser);
+
+        let safe_html = Builder::default()
+            .add_tags(["input", "section", "article", "nav", "span"])
+            .add_generic_attributes(["class", "id", "data-line", "aria-label"])
+            .clean(&unsafe_html)
+            .to_string();
+
+        Ok(MarkdownView { path: path.to_string(), blob_sha: blob_sha.to_string(), html: safe_html, toc: extract_toc(markdown), warnings: vec![], asset_refs: vec![] })
+    }
+}
+
+fn extract_toc(markdown: &str) -> Vec<TocEntry> {
+    markdown.lines().filter_map(|line| {
+        let level = line.chars().take_while(|c| *c == '#').count();
+        if level == 0 || level > 6 || !line.chars().nth(level).is_some_and(|c| c == ' ') { return None; }
+        let text = line[level + 1..].trim().to_string();
+        let id = text.to_lowercase().chars().map(|c| if c.is_ascii_alphanumeric() { c } else { '-' }).collect::<String>();
+        Some(TocEntry { id, text, level: level as u8 })
+    }).collect()
+}

