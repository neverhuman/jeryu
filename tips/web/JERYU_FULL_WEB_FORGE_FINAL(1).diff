+use anyhow::{Context, Result};
+use tokio::net::TcpListener;
+
+use crate::cli::ServeOptions;
+use crate::web::{router, state::WebAppState};
+
+pub async fn serve(options: ServeOptions) -> Result<()> {
+    let state = WebAppState::from_options(&options).await?;
+    let app = router::build_router(state, &options);
+    let listener = TcpListener::bind(&options.bind).await.with_context(|| format!("bind {}", options.bind))?;
+    tracing::info!(bind = %options.bind, "starting JeRyu web forge");
+    axum::serve(listener, app).await.context("serve web router")
+}

