+.repo-card, .empty-card, .markdown-body { border: 1px solid var(--border); background: var(--surface); border-radius: 14px; padding: 16px; }
+.repo-card { display: flex; flex-direction: column; gap: 8px; }
+.repo-card span { color: var(--muted); font-size: 14px; }
+.code-layout { display: grid; grid-template-columns: 320px minmax(0, 1fr); gap: 16px; }
+.file-tree { display: flex; flex-direction: column; gap: 4px; border: 1px solid var(--border); border-radius: 14px; padding: 8px; }
+.file-viewer { border: 1px solid var(--border); border-radius: 14px; min-height: 60vh; padding: 16px; }
+.merge-room { display: grid; grid-template-columns: 260px minmax(0, 1fr) 320px; gap: 16px; }
+.merge-room h1 { grid-column: 1 / 4; }
+
+@media (max-width: 1100px) {
+  .app-shell { grid-template-columns: 72px minmax(0, 1fr); }
+  .activity-rail { display: none; }
+  .topbar { grid-column: 1 / 3; }
