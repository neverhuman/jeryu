+import { DashboardPage } from '../pages/DashboardPage';
+import { RepositoriesPage } from '../pages/RepositoriesPage';
+import { RepoOverviewPage } from '../pages/RepoOverviewPage';
+import { RepoCodePage } from '../pages/RepoCodePage';
+import { MergeRequestPage } from '../pages/MergeRequestPage';
+import { SettingsPage } from '../pages/SettingsPage';
+
+export function Router() {
+  const path = window.location.pathname;
+  const parts = path.split('/').filter(Boolean);
+  if (path === '/' || path === '/dashboard') return <DashboardPage />;
+  if (path === '/repos') return <RepositoriesPage />;
+  if (parts[0] === 'r' && parts[3] === 'code') return <RepoCodePage owner={parts[1]} repo={parts[2]} />;
+  if (parts[0] === 'r' && parts[3] === 'merge-requests') return <MergeRequestPage owner={parts[1]} repo={parts[2]} number={Number(parts[4])} />;
+  if (parts[0] === 'r' && parts[3] === 'settings') return <SettingsPage owner={parts[1]} repo={parts[2]} />;
+  if (parts[0] === 'r') return <RepoOverviewPage owner={parts[1]} repo={parts[2]} />;
+  return <DashboardPage />;
+}

