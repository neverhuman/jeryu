@@ -0,0 +1,95 @@
+
+//! Owner: Web Forge Markdown rendering and sanitization
+
+use ammonia::Builder as HtmlSanitizer;
+use comrak::{markdown_to_html, Options};
+use serde::Serialize;
+use sha2::{Digest, Sha256};
+
+#[derive(Debug, Clone, Serialize)]
+pub struct RenderedMarkdown {
+    pub source_sha256: String,
+    pub html: String,
+    pub headings: Vec<MarkdownHeading>,
+    pub links: Vec<MarkdownLink>,
+    pub warnings: Vec<String>,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct MarkdownHeading {
+    pub level: u8,
+    pub text: String,
+    pub anchor: String,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct MarkdownLink {
+    pub href: String,
+    pub rewritten_href: String,
+    pub external: bool,
+}
+
+#[derive(Debug, Default)]
+pub struct MarkdownRenderer;
+
+impl MarkdownRenderer {
+    pub fn render(&self, source: &str, base_href: Option<&str>) -> RenderedMarkdown {
+        let mut options = Options::default();
+        options.extension.table = true;
+        options.extension.tasklist = true;
+        options.extension.strikethrough = true;
+        options.extension.autolink = true;
+        options.extension.footnotes = true;
+        options.render.unsafe_ = true;
+
+        let raw_html = markdown_to_html(source, &options);
+        let sanitized = HtmlSanitizer::default()
+            .add_tags(["details", "summary", "kbd"])
+            .add_generic_attributes(["class", "id"])
+            .link_rel(Some("nofollow noopener noreferrer"))
+            .clean(&raw_html)
+            .to_string();
+
+        let html = rewrite_relative_links(&sanitized, base_href);
+        RenderedMarkdown {
+            source_sha256: format!("sha256:{:x}", Sha256::digest(source.as_bytes())),
+            headings: collect_headings(source),
+            links: collect_links(&html),
+            html,
+            warnings: Vec::new(),
+        }
+    }
+}
+
+fn rewrite_relative_links(html: &str, base_href: Option<&str>) -> String {
+    let Some(base) = base_href else { return html.to_string(); };
+    // Follow-up implementation should use an HTML5 parser. This placeholder keeps
+    // the behavior centralized and testable while avoiding regex in handlers.
+    html.replace("href=\"./", &format!("href=\"{base}/"))
+        .replace("src=\"./", &format!("src=\"{base}/"))
+}
+
+fn collect_headings(source: &str) -> Vec<MarkdownHeading> {
+    source.lines()
+        .filter_map(|line| {
+            let hashes = line.chars().take_while(|c| *c == '#').count();
+            if hashes == 0 || hashes > 6 || !line.chars().nth(hashes).is_some_and(|c| c == ' ') {
+                return None;
+            }
+            let text = line[hashes + 1..].trim().to_string();
+            let anchor = text.to_lowercase()
+                .chars()
+                .map(|c| if c.is_ascii_alphanumeric() { c } else { '-' })
+                .collect::<String>()
+                .split('-')
+                .filter(|s| !s.is_empty())
+                .collect::<Vec<_>>()
+                .join("-");
+            Some(MarkdownHeading { level: hashes as u8, text, anchor })
+        })
+        .collect()
+}
+
+fn collect_links(_html: &str) -> Vec<MarkdownLink> {
+    Vec::new()
+}

