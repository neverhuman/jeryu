+++ b/src/web_events/bus.rs
@@ -0,0 +1,113 @@
+
+//! Owner: Web Forge realtime event bus implementation
+
+use std::{collections::VecDeque, sync::Arc};
+
+use chrono::Utc;
+use serde_json::Value;
+use tokio::sync::{broadcast, RwLock};
+
+use super::protocol::{ServerWsMessage, WebEventPayload, WebEventTopic};
+
+#[derive(Debug, Clone)]
+pub struct WebEventRecord {
+    pub cursor: u64,
+    pub topic: WebEventTopic,
+    pub payload: WebEventPayload,
+}
+
+#[derive(Clone)]
+pub struct WebEventBus {
+    inner: Arc<RwLock<BusState>>,
+    tx: broadcast::Sender<WebEventRecord>,
+}
+
+struct BusState {
+    next_cursor: u64,
+    ring: VecDeque<WebEventRecord>,
+    capacity: usize,
+}
+
+impl WebEventBus {
+    pub fn new(capacity: usize) -> Self {
+        let (tx, _) = broadcast::channel(capacity.max(16));
+        Self {
+            inner: Arc::new(RwLock::new(BusState {
+                next_cursor: 1,
+                ring: VecDeque::with_capacity(capacity),
+                capacity,
+            })),
+            tx,
+        }
+    }
+
+    pub fn subscribe(&self) -> broadcast::Receiver<WebEventRecord> {
+        self.tx.subscribe()
+    }
+
+    pub async fn cursor(&self) -> u64 {
+        let inner = self.inner.read().await;
+        inner.next_cursor.saturating_sub(1)
+    }
+
+    pub async fn publish(&self, topic: WebEventTopic, mut payload: WebEventPayload) -> u64 {
+        if payload.occurred_at.timestamp() == 0 {
+            payload.occurred_at = Utc::now();
+        }
+        let mut inner = self.inner.write().await;
+        let cursor = inner.next_cursor;
+        inner.next_cursor += 1;
+        let record = WebEventRecord { cursor, topic, payload };
+        if inner.ring.len() >= inner.capacity {
+            inner.ring.pop_front();
+        }
+        inner.ring.push_back(record.clone());
+        drop(inner);
+        let _ = self.tx.send(record);
+        cursor
+    }
+
+    pub async fn replay_since(&self, cursor: u64, topics: &[WebEventTopic]) -> Option<Vec<WebEventRecord>> {
+        let inner = self.inner.read().await;
+        if let Some(front) = inner.ring.front() {
+            if cursor > 0 && cursor < front.cursor.saturating_sub(1) {
+                return None;
+            }
+        }
+        Some(
+            inner.ring
+                .iter()
+                .filter(|record| record.cursor > cursor && (topics.is_empty() || topics.contains(&record.topic)))
+                .cloned()
+                .collect(),
+        )
+    }
+}
+
+impl Default for WebEventBus {
+    fn default() -> Self {
+        Self::new(10_000)
+    }
+}
+
+impl From<WebEventRecord> for ServerWsMessage {
+    fn from(record: WebEventRecord) -> Self {
+        ServerWsMessage::Event {
+            cursor: record.cursor,
+            topic: record.topic,
+            event: record.payload,
+        }
+    }
+}
+
+pub fn synthetic_event(kind: &str, summary: &str) -> WebEventPayload {
+    WebEventPayload {
+        kind: kind.into(),
+        actor: None,
+        entity: None,
+        severity: "info".into(),
+        summary: summary.into(),
+        data: Value::Null,
+        occurred_at: Utc::now(),
+    }
+}

