--- /dev/null
+++ b/apps/web/src/api/websocket.ts
@@ -0,0 +1,29 @@
+
+import type { ServerWsMessage } from './types';
+
+export interface WebSocketClientOptions {
+  topics: string[];
+  lastCursor?: number;
+  onMessage: (message: ServerWsMessage) => void;
+  onGap?: (from: number, to: number) => void;
+}
+
+export function connectEvents(options: WebSocketClientOptions): WebSocket {
+  const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
+  const ws = new WebSocket(`${protocol}//${window.location.host}/ws`);
+  ws.addEventListener('open', () => {
+    ws.send(JSON.stringify({
+      type: 'hello',
+      client_id: crypto.randomUUID(),
+      last_cursor: options.lastCursor ?? null,
+      topics: options.topics,
+      accept_snapshot: true,
+    }));
+  });
+  ws.addEventListener('message', (event) => {
+    const message = JSON.parse(event.data) as ServerWsMessage;
+    if (message.type === 'gap') options.onGap?.(message.from, message.to);
+    options.onMessage(message);
+  });
+  return ws;
+}

