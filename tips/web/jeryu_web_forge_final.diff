+pub mod markdown;
+pub mod rest;
+pub mod router;
+pub mod state;
+pub mod ws;
+
+pub use state::{WebConfig, WebState};
+
+use anyhow::Result;
+use std::sync::Arc;
+
+pub async fn serve(config: WebConfig, db: Option<crate::state::Db>) -> Result<()> {
+    let state = Arc::new(WebState::new(config.clone(), db));
+    let app = router::build_router(state);
+    let listener = tokio::net::TcpListener::bind(config.bind).await?;
+    tracing::info!(bind = %config.bind, "starting JeRyu web forge");
+    axum::serve(listener, app.into_make_service()).await?;
+    Ok(())
+}

