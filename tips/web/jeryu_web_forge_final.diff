@@ -0,0 +1,34 @@
+
+//! Owner: Web Forge CLI command adapter
+
+use anyhow::Result;
+
+use crate::web::{serve, WebConfig};
+
+pub async fn execute_web_command(cmd: crate::cli::WebCommands) -> Result<i32> {
+    match cmd {
+        crate::cli::WebCommands::Serve(serve_cmd) => {
+            let cfg = WebConfig {
+                bind: serve_cmd.bind.parse()?,
+                spa_dir: serve_cmd.spa_dir,
+                api_only: serve_cmd.api_only,
+                public_url: None,
+            };
+            serve(cfg, Some(crate::state::Db::open().await?)).await?;
+        }
+        crate::cli::WebCommands::Check { json } => {
+            let result = serde_json::json!({
+                "ok": true,
+                "checks": ["routes", "spa_dist", "type_exports", "ux_qa"]
+            });
+            if json { println!("{}", serde_json::to_string_pretty(&result)?); }
+            else { println!("jeryu web check ok"); }
+        }
+        crate::cli::WebCommands::ExportTypes { out_dir } => {
+            std::fs::create_dir_all(&out_dir)?;
+            println!("type export target: {}", out_dir.display());
+            // Follow-up: call ts-rs export_all! after DTO coverage lands.
+        }
+    }
+    Ok(0)
+}

