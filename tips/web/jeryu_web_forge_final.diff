@@ -0,0 +1,72 @@
+
+//! Owner: Web Forge websocket handler
+
+use std::{collections::HashSet, sync::Arc, time::Duration};
+
+use axum::{extract::{ws::{Message, WebSocket}, State, WebSocketUpgrade}, response::IntoResponse};
+use chrono::Utc;
+use futures_util::{SinkExt, StreamExt};
+use tokio::time::interval;
+
+use crate::web_events::{ClientWsMessage, ServerWsMessage, WebEventTopic};
+
+use super::state::WebState;
+
+pub async fn handler(State(state): State<Arc<WebState>>, ws: WebSocketUpgrade) -> impl IntoResponse {
+    ws.on_upgrade(move |socket| run_socket(state, socket))
+}
+
+async fn run_socket(state: Arc<WebState>, socket: WebSocket) {
+    let (mut sender, mut receiver) = socket.split();
+    let mut rx = state.events.subscribe();
+    let mut topics: HashSet<WebEventTopic> = HashSet::new();
+    topics.insert(WebEventTopic::global());
+    let mut heartbeat = interval(Duration::from_secs(15));
+
+    loop {
+        tokio::select! {
+            Some(Ok(msg)) = receiver.next() => {
+                if let Message::Text(text) = msg {
+                    match serde_json::from_str::<ClientWsMessage>(&text) {
+                        Ok(ClientWsMessage::Hello { last_cursor, topics: new_topics, .. }) => {
+                            topics.extend(new_topics.clone());
+                            let replay_topics = topics.iter().cloned().collect::<Vec<_>>();
+                            match state.events.replay_since(last_cursor.unwrap_or_default(), &replay_topics).await {
+                                Some(records) => {
+                                    let ack = ServerWsMessage::HelloAck { server_time: Utc::now(), cursor: state.events.cursor().await, replayed: records.len() };
+                                    if send_json(&mut sender, &ack).await.is_err() { break; }
+                                    for record in records {
+                                        if send_json(&mut sender, &ServerWsMessage::from(record)).await.is_err() { break; }
+                                    }
+                                }
+                                None => {
+                                    let gap = ServerWsMessage::Gap { from: last_cursor.unwrap_or_default(), to: state.events.cursor().await, reason: "cursor_evicted".into() };
+                                    if send_json(&mut sender, &gap).await.is_err() { break; }
+                                }
+                            }
+                        }
+                        Ok(ClientWsMessage::Subscribe { topics: new_topics }) => { topics.extend(new_topics); }
+                        Ok(ClientWsMessage::Unsubscribe { topics: old_topics }) => { for topic in old_topics { topics.remove(&topic); } }
+                        Ok(ClientWsMessage::Ping { nonce }) => { if send_json(&mut sender, &ServerWsMessage::Pong { nonce }).await.is_err() { break; } }
+                        Err(err) => {
+                            let _ = send_json(&mut sender, &ServerWsMessage::Error { code: "bad_message".into(), message: err.to_string() }).await;
+                        }
+                    }
+                }
+            }
+            Ok(record) = rx.recv() => {
+                if topics.contains(&record.topic) || topics.contains(&WebEventTopic::global()) {
+                    if send_json(&mut sender, &ServerWsMessage::from(record)).await.is_err() { break; }
+                }
+            }
+            _ = heartbeat.tick() => {
+                let msg = ServerWsMessage::Heartbeat { cursor: state.events.cursor().await, server_time: Utc::now() };
+                if send_json(&mut sender, &msg).await.is_err() { break; }
+            }
+        }
+    }
+}
+
+async fn send_json(sender: &mut futures_util::stream::SplitSink<WebSocket, Message>, msg: &ServerWsMessage) -> Result<(), axum::Error> {
+    sender.send(Message::Text(serde_json::to_string(msg).unwrap_or_else(|_| "{\"type\":\"error\"}".into()))).await
+}

