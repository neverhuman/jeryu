+export type RepositoryProvider = 'local' | 'gitlab' | 'github' | 'mirror';
+export type RepositoryVisibility = 'private' | 'internal' | 'public';
+
+export interface RepositorySummary {
+  id: string;
+  provider: RepositoryProvider;
+  owner: string;
+  name: string;
+  slug: string;
+  family?: string | null;
+  description?: string | null;
+  visibility: RepositoryVisibility;
+  defaultBranch: string;
+  localPath?: string | null;
+  remoteUrl?: string | null;
+  avatarUrl?: string | null;
+  archived: boolean;
+  topics: string[];
+  openMergeRequests: number;
+  openIssues: number;
+  failingChecks: number;
+  activeAgents: number;
+  latestActivityAt?: string | null;
+}
+
+export interface WebBootstrap {
+  schemaVersion: string;
+  generatedAt: string;
+  eventCursor: number;
+  actor: { id: string; login: string; displayName: string; avatarUrl?: string | null };
+  capabilities: string[];
+  settings: { theme: string; density: string; activityRailDefaultOpen: boolean };
+  dashboard: {
+    repos: RepositorySummary[];
+    attentionCount: number;
+    mergeRequestsNeedingReview: number;
+    failingPipelines: number;
+    activeAgents: number;
+  };
+}
+
+export interface WebEventPayload {
+  kind: string;
+  actor?: string | null;
+  entity?: string | null;
+  severity: string;
+  summary: string;
+  data: unknown;
+  occurredAt: string;
+}
+
+export type ServerWsMessage =
+  | { type: 'hello_ack'; server_time: string; cursor: number; replayed: number }
+  | { type: 'event'; cursor: number; topic: string; event: WebEventPayload }
+  | { type: 'snapshot'; topic: string; reason: string; value: unknown }
+  | { type: 'gap'; from: number; to: number; reason: string }
+  | { type: 'heartbeat'; cursor: number; server_time: string }
+  | { type: 'error'; code: string; message: string }
+  | { type: 'pong'; nonce: string };

