@@ -0,0 +1,26 @@
+
+import type { RepositorySummary, WebBootstrap } from './types';
+
+const API_PREFIX = '/api/v1';
+
+async function request<T>(path: string, init?: RequestInit): Promise<T> {
+  const response = await fetch(`${API_PREFIX}${path}`, {
+    headers: { 'content-type': 'application/json', ...(init?.headers ?? {}) },
+    ...init,
+  });
+  if (!response.ok) {
+    const body = await response.text();
+    throw new Error(`${response.status} ${response.statusText}: ${body}`);
+  }
+  return response.json() as Promise<T>;
+}
+
+export const api = {
+  bootstrap: () => request<WebBootstrap>('/bootstrap'),
+  repos: () => request<RepositorySummary[]>('/repos'),
+  renderMarkdown: (source: string, baseHref?: string) =>
+    request<{ html: string; headings: unknown[]; warnings: string[] }>('/markdown/render', {
+      method: 'POST',
+      body: JSON.stringify({ source, base_href: baseHref }),
+    }),
+};

