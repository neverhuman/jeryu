+import { useEffect, useState } from 'react';
+import { connectEvents } from '../../api/websocket';
+import type { ServerWsMessage } from '../../api/types';
+
+export function ActivityRail() {
+  const [events, setEvents] = useState<ServerWsMessage[]>([]);
+  useEffect(() => {
+    const ws = connectEvents({
+      topics: ['global'],
+      onMessage: (message) => setEvents((current) => [message, ...current].slice(0, 50)),
+    });
+    return () => ws.close();
+  }, []);
+
+  return (
+    <aside className="activity-rail" aria-label="Live activity">
+      <h2>Live</h2>
+      {events.map((event, index) => (
+        <pre key={index}>{JSON.stringify(event, null, 2)}</pre>
+      ))}
+    </aside>
+  );
+}

