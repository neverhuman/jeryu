@@ -0,0 +1,34 @@
+
+//! Owner: Web Forge Axum router
+
+use std::sync::Arc;
+
+use axum::{routing::get, Json, Router};
+use tower_http::{compression::CompressionLayer, services::{ServeDir, ServeFile}, trace::TraceLayer};
+
+use super::{rest, state::WebState, ws};
+
+pub fn build_router(state: Arc<WebState>) -> Router {
+    let api = rest::router(state.clone());
+    let mut app = Router::new()
+        .route("/healthz", get(healthz))
+        .route("/ws", get(ws::handler))
+        .nest("/api/v1", api)
+        .with_state(state.clone())
+        .layer(CompressionLayer::new())
+        .layer(TraceLayer::new_for_http());
+
+    if !state.config.api_only {
+        let index = state.config.spa_dir.join("index.html");
+        app = app.fallback_service(
+            ServeDir::new(&state.config.spa_dir)
+                .not_found_service(ServeFile::new(index)),
+        );
+    }
+
+    app
+}
+
+async fn healthz() -> Json<serde_json::Value> {
+    Json(serde_json::json!({ "ok": true, "service": "jeryu-web" }))
+}

