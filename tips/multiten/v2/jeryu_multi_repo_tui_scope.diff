+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum FleetScopeItem {
+    All,
+    Family {
+        label: String,
+        prefix: String,
+        repo_indexes: Vec<usize>,
+    },
+    Repo {
+        repo_index: usize,
+    },
+}
+
+impl FleetScopeItem {
+    pub fn label<'a>(&'a self, snapshot: &'a FleetSnapshot) -> String {
+        match self {
+            Self::All => "All".into(),
+            Self::Family { label, .. } => label.clone(),
+            Self::Repo { repo_index } => snapshot
+                .repos
+                .get(*repo_index)
+                .map(|repo| repo.alias.clone())
+                .unwrap_or_else(|| "?".into()),
+        }
+    }
+
+    pub fn repo_indexes(&self) -> Vec<usize> {
+        match self {
+            Self::All => Vec::new(),
+            Self::Family { repo_indexes, .. } => repo_indexes.clone(),
+            Self::Repo { repo_index } => vec![*repo_index],
+        }
+    }
+}
+
+fn scope_sort_key(snapshot: &FleetSnapshot, item: &FleetScopeItem) -> (u32, u32, String) {
+    let indexes = item.repo_indexes();
+    let running: u32 = indexes.iter().map(|idx| snapshot.repos[*idx].running_count).sum();
+    let failed: u32 = indexes.iter().map(|idx| snapshot.repos[*idx].failed_count).sum();
+    let most_recent = indexes
+        .iter()
+        .filter_map(|idx| snapshot.repos[*idx].latest_run.as_ref())
+        .filter_map(|run| run.updated_at.clone())
+        .max()
+        .unwrap_or_default();
+    (running, failed, most_recent)
+}
+
+pub fn repo_family_prefix(repo: &FleetRepoSnapshot) -> Option<String> {
+    repo_family_prefix_from(&repo.alias, &repo.slug)
+}
+
+pub fn repo_family_prefix_from(alias: &str, slug: &str) -> Option<String> {
+    let basename = slug.rsplit('/').next().unwrap_or(slug);
+    let candidate = if basename.contains('-') { basename } else { alias };
+    candidate
+        .split_once('-')
+        .and_then(|(prefix, rest)| (!prefix.is_empty() && !rest.is_empty()).then(|| prefix.to_string()))
+}
