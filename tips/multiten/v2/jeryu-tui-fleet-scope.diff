+
+pub fn family_label(family: &str) -> String {
+    format!("{family}-*")
+}
+
+pub fn family_key_for_repo(repo: &FleetRepoSnapshot) -> Option<String> {
+    family_key_from_alias_slug(&repo.alias, &repo.slug)
+}
+
+pub fn family_key_from_alias_slug(alias: &str, slug: &str) -> Option<String> {
+    dashed_prefix(alias).or_else(|| slug.rsplit('/').next().and_then(dashed_prefix))
+}
+
+pub fn matches_repo_family(family: &str, item_alias: Option<&str>, item_slug: Option<&str>) -> bool {
+    item_alias
+        .and_then(dashed_prefix)
+        .or_else(|| item_slug.and_then(|slug| slug.rsplit('/').next()).and_then(dashed_prefix))
+        .as_deref()
+        == Some(family)
+}
+
+fn dashed_prefix(value: &str) -> Option<String> {
+    let (prefix, rest) = value.split_once('-')?;
+    if prefix.is_empty() || rest.is_empty() {
+        None
+    } else {
+        Some(prefix.to_string())
+    }
+}
+
+fn repo_activity_rank(repo: &FleetRepoSnapshot) -> (u8, String, String) {
+    let status_rank = match repo.status.as_str() {
+        "running" => 6,
+        "failed" => 5,
+        "dirty" => 4,
+        "green" | "success" => 3,
+        "local" => 2,
+        "missing" => 0,
+        _ => 1,
+    };
+    let updated_at = repo
+        .latest_run
+        .as_ref()
+        .and_then(|run| run.updated_at.clone())
+        .unwrap_or_default();
+    (status_rank, updated_at, repo.alias.clone())
+}
+
+fn family_activity_rank(family: &FleetFamily) -> (u32, u32, u32, String) {
+    (
+        family.metrics.running_count,
+        family.metrics.failed_count,
+        family.metrics.repo_count as u32,
+        family.family.clone(),
+    )
+}
