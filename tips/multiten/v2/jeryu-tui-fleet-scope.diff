+
+    pub fn metrics_for_indexes(&self, indexes: &[usize]) -> FleetScopeMetrics {
+        let mut metrics = FleetScopeMetrics::default();
+        metrics.repo_count = indexes.len();
+        for idx in indexes {
+            if let Some(repo) = self.repos.get(*idx) {
+                metrics.running_count += repo.running_count;
+                metrics.failed_count += repo.failed_count;
+                metrics.stale_count += u32::from(repo.stale);
+            }
+        }
+        metrics
+    }
+
+    pub fn all_metrics(&self) -> FleetScopeMetrics {
+        let indexes: Vec<usize> = (0..self.repos.len()).collect();
+        self.metrics_for_indexes(&indexes)
+    }
+
+    /// Auto-group repos into families by dashed prefix. Alias wins; if the
+    /// alias is short/non-dashed, fall back to the slug tail. This supports
+    /// registries that alias `neverhuman/veox-shared` as just `shared` while
+    /// still showing it under `veox-*`.
+    pub fn family_groups(&self) -> Vec<FleetFamily> {
+        let mut grouped: BTreeMap<String, Vec<usize>> = BTreeMap::new();
+        for (idx, repo) in self.repos.iter().enumerate() {
+            if let Some(family) = family_key_for_repo(repo) {
+                grouped.entry(family).or_default().push(idx);
+            }
+        }
+
+        let mut families: Vec<FleetFamily> = grouped
+            .into_iter()
+            .map(|(family, mut repo_indexes)| {
+                repo_indexes.sort_by(|a, b| repo_activity_rank(&self.repos[*b]).cmp(&repo_activity_rank(&self.repos[*a])));
+                let metrics = self.metrics_for_indexes(&repo_indexes);
+                FleetFamily {
+                    family,
+                    repo_indexes,
+                    metrics,
+                }
+            })
+            .collect();
+        families.sort_by(|a, b| family_activity_rank(b).cmp(&family_activity_rank(a)));
+        families
+    }
+
+    pub fn root_scope_items(&self) -> Vec<FleetScopeItem<'_>> {
+        let families = self.family_groups();
+        let grouped_indexes: BTreeSet<usize> = families
+            .iter()
+            .flat_map(|family| family.repo_indexes.iter().copied())
+            .collect();
+
+        let mut items = vec![FleetScopeItem::All {
+            metrics: self.all_metrics(),
+        }];
+        for family in &families {
+            items.push(FleetScopeItem::Family {
+                family: family.family.clone(),
+                metrics: family.metrics,
+            });
+        }
+
+        let mut ungrouped: Vec<&FleetRepoSnapshot> = self
+            .repos
+            .iter()
+            .enumerate()
+            .filter(|(idx, _)| !grouped_indexes.contains(idx))
+            .map(|(_, repo)| repo)
+            .collect();
+        ungrouped.sort_by(|a, b| repo_activity_rank(b).cmp(&repo_activity_rank(a)));
+        items.extend(ungrouped.into_iter().map(FleetScopeItem::Repo));
+        items
+    }
+
+    pub fn family_scope_items(&self, family: &str) -> Vec<FleetScopeItem<'_>> {
+        let mut repos: Vec<&FleetRepoSnapshot> = self
+            .repos
+            .iter()
+            .filter(|repo| family_key_for_repo(repo).as_deref() == Some(family))
+            .collect();
+        repos.sort_by(|a, b| repo_activity_rank(b).cmp(&repo_activity_rank(a)));
+        let indexes: Vec<usize> = self
+            .repos
+            .iter()
+            .enumerate()
+            .filter(|(_, repo)| family_key_for_repo(repo).as_deref() == Some(family))
+            .map(|(idx, _)| idx)
+            .collect();
+        let mut items = vec![FleetScopeItem::Family {
+            family: family.to_string(),
+            metrics: self.metrics_for_indexes(&indexes),
+        }];
+        items.extend(repos.into_iter().map(FleetScopeItem::Repo));
+        items
+    }
+
+    pub fn scope_items(&self, selected_family: Option<&str>) -> Vec<FleetScopeItem<'_>> {
+        match selected_family {
+            Some(family) => self.family_scope_items(family),
+            None => self.root_scope_items(),
+        }
+    }
 }
