+    /// Root-level scope list for the fleet rail. The first item is always
+    /// `All`; remaining items are auto-family rollups and standalone repos,
+    /// sorted by operational urgency and recency instead of registry order.
+    pub fn root_scope_items(&self) -> Vec<FleetScopeItem> {
+        let mut scopes = vec![self.all_scope_item()];
+        if self.repos.is_empty() {
+            return scopes;
+        }
