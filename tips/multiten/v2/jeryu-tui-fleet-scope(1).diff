+
+fn repo_family_prefix(repo: &FleetRepoSnapshot) -> Option<String> {
+    repo_family_prefix_from_parts(Some(&repo.alias), Some(&repo.slug))
+}
+
+pub fn repo_family_prefix_from_parts(alias: Option<&str>, slug: Option<&str>) -> Option<String> {
+    if let Some(slug) = slug {
+        if let Some(name) = slug.rsplit('/').next() {
+            if let Some(prefix) = dash_prefix(name) {
+                return Some(prefix);
+            }
+        }
+    }
+    alias.and_then(dash_prefix)
+}
+
+fn dash_prefix(name: &str) -> Option<String> {
+    let (prefix, suffix) = name.split_once('-')?;
+    if prefix.is_empty() || suffix.is_empty() {
+        return None;
+    }
+    Some(prefix.to_string())
+}
+
+fn repo_family_label(prefix: &str) -> String {
+    format!("{prefix}-*")
+}
+
+fn repo_latest_observed_at(repo: &FleetRepoSnapshot) -> Option<&str> {
+    repo.latest_run.as_ref()?.updated_at.as_deref()
+}
+
+fn rollup_status(running: u32, failed: u32, stale: u32) -> String {
+    if failed > 0 {
+        "failed".into()
+    } else if running > 0 {
+        "running".into()
+    } else if stale > 0 {
+        "aged".into()
+    } else {
+        "green".into()
+    }
+}
+
+fn compare_repo_priority(a: &FleetRepoSnapshot, b: &FleetRepoSnapshot) -> Ordering {
+    b.failed_count
+        .cmp(&a.failed_count)
+        .then_with(|| b.running_count.cmp(&a.running_count))
+        .then_with(|| repo_latest_observed_at(b).cmp(&repo_latest_observed_at(a)))
+        .then_with(|| a.alias.cmp(&b.alias))
+}
+
+fn compare_scope_priority(a: &FleetScopeItem, b: &FleetScopeItem) -> Ordering {
+    b.failed_count
+        .cmp(&a.failed_count)
+        .then_with(|| b.running_count.cmp(&a.running_count))
+        .then_with(|| b.latest_observed_at.cmp(&a.latest_observed_at))
+        .then_with(|| match (a.kind, b.kind) {
+            (FleetScopeKind::Family, FleetScopeKind::Repo) => Ordering::Less,
+            (FleetScopeKind::Repo, FleetScopeKind::Family) => Ordering::Greater,
+            _ => Ordering::Equal,
+        })
+        .then_with(|| a.label.cmp(&b.label))
+}
 
