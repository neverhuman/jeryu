+        let mut families: BTreeMap<String, Vec<usize>> = BTreeMap::new();
+        for (idx, repo) in self.repos.iter().enumerate() {
+            if let Some(prefix) = repo_family_prefix(repo) {
+                families.entry(prefix).or_default().push(idx);
+            }
+        }
+
+        let mut family_members = BTreeSet::new();
+        let mut grouped = Vec::new();
+        for (prefix, indices) in families {
+            if indices.len() < 2 {
+                continue;
