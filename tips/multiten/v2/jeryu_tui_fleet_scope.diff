+        let mut scopes = Vec::with_capacity(indices.len() + 1);
+        scopes.push(FleetScope::family(self, prefix.to_string(), indices.clone()));
+        scopes.extend(indices.into_iter().map(|idx| FleetScope::repo(self, idx)));
+        scopes
+    }
