+    pub fn root_scopes(&self) -> Vec<FleetScope> {
+        let mut scopes = vec![FleetScope::all(self)];
+        let families = self.family_members();
+        let mut grouped = std::collections::BTreeSet::new();
+        let mut dynamic = Vec::new();
