+    /// Build the child list for a family. Index 0 is the family aggregate;
+    /// subsequent entries are child repos, ranked by current heat and recency.
+    pub fn family_scopes(&self, prefix: &str) -> Vec<FleetScope> {
+        let mut indices = self
