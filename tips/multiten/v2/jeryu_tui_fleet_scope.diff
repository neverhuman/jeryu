+#[derive(Debug, Clone, Copy, Default, Serialize, PartialEq, Eq)]
+pub struct FleetCounts {
+    pub running: u32,
+    pub failed: u32,
+    pub aged: u32,
+}
+
+impl FleetCounts {
+    fn from_repos<'a, I>(repos: I) -> Self
+    where
+        I: IntoIterator<Item = &'a FleetRepoSnapshot>,
+    {
+        let mut counts = FleetCounts::default();
+        for repo in repos {
+            counts.running += repo.running_count;
+            counts.failed += repo.failed_count;
+            counts.aged += u32::from(repo.stale);
+        }
+        counts
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum FleetScopeKind {
+    All,
+    Family {
+        prefix: String,
+        repo_indices: Vec<usize>,
+    },
+    Repo {
+        index: usize,
+    },
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct FleetScope {
+    pub label: String,
+    pub kind: FleetScopeKind,
+    pub repo_count: usize,
+    pub counts: FleetCounts,
+    pub latest_observed_at: Option<String>,
+}
+
+impl FleetScope {
+    pub fn all(snapshot: &FleetSnapshot) -> Self {
+        FleetScope {
+            label: "All".into(),
+            kind: FleetScopeKind::All,
+            repo_count: snapshot.repos.len(),
+            counts: snapshot.counts(),
+            latest_observed_at: latest_for_indices(snapshot, 0..snapshot.repos.len()),
+        }
+    }
+
+    pub fn family(snapshot: &FleetSnapshot, prefix: String, repo_indices: Vec<usize>) -> Self {
+        FleetScope {
+            label: format!("{}-*", prefix),
+            counts: FleetCounts::from_repos(
+                repo_indices.iter().filter_map(|idx| snapshot.repos.get(*idx)),
+            ),
+            latest_observed_at: latest_for_indices(snapshot, repo_indices.iter().copied()),
+            repo_count: repo_indices.len(),
+            kind: FleetScopeKind::Family {
+                prefix,
+                repo_indices,
+            },
+        }
+    }
+
+    pub fn repo(snapshot: &FleetSnapshot, index: usize) -> Self {
+        let repo = &snapshot.repos[index];
+        FleetScope {
+            label: repo.alias.clone(),
+            kind: FleetScopeKind::Repo { index },
+            repo_count: 1,
+            counts: FleetCounts {
+                running: repo.running_count,
+                failed: repo.failed_count,
+                aged: u32::from(repo.stale),
+            },
+            latest_observed_at: repo.latest_run.as_ref().and_then(|run| run.updated_at.clone()),
+        }
+    }
+}
