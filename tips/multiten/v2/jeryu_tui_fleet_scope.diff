+fn repo_identity_name(repo: &FleetRepoSnapshot) -> &str {
+    if repo.alias.contains('-') {
+        repo.alias.as_str()
+    } else {
+        repo.slug.rsplit('/').next().unwrap_or(repo.alias.as_str())
+    }
+}
+
+fn family_prefix(repo: &FleetRepoSnapshot) -> Option<String> {
+    repo_identity_name(repo)
+        .split_once('-')
+        .map(|(prefix, _)| prefix)
+        .filter(|prefix| !prefix.is_empty())
+        .map(str::to_string)
+}
+
+fn repo_matches_family(repo: &FleetRepoSnapshot, prefix: &str) -> bool {
+    alias_matches_family(&repo.alias, prefix) || slug_matches_family(&repo.slug, prefix)
+}
+
+fn alias_matches_family(alias: &str, prefix: &str) -> bool {
+    alias
+        .strip_prefix(prefix)
+        .is_some_and(|rest| rest.starts_with('-'))
+}
+
+fn slug_matches_family(slug: &str, prefix: &str) -> bool {
+    slug.rsplit('/')
+        .next()
+        .is_some_and(|name| alias_matches_family(name, prefix))
+}
+
+fn latest_for_indices<I>(snapshot: &FleetSnapshot, indices: I) -> Option<String>
+where
+    I: IntoIterator<Item = usize>,
+{
+    indices
+        .into_iter()
+        .filter_map(|idx| snapshot.repos.get(idx))
+        .filter_map(|repo| repo.latest_run.as_ref())
+        .filter_map(|run| run.updated_at.clone())
+        .max()
+}
+
+fn scope_cmp(left: &FleetScope, right: &FleetScope) -> std::cmp::Ordering {
+    right
+        .counts
+        .running
+        .cmp(&left.counts.running)
+        .then_with(|| right.counts.failed.cmp(&left.counts.failed))
+        .then_with(|| right.latest_observed_at.cmp(&left.latest_observed_at))
+        .then_with(|| left.label.cmp(&right.label))
+}
+
+fn repo_cmp(left: &FleetRepoSnapshot, right: &FleetRepoSnapshot) -> std::cmp::Ordering {
+    right
+        .running_count
+        .cmp(&left.running_count)
+        .then_with(|| right.failed_count.cmp(&left.failed_count))
+        .then_with(|| {
+            right
+                .latest_run
+                .as_ref()
+                .and_then(|run| run.updated_at.as_ref())
+                .cmp(&left.latest_run.as_ref().and_then(|run| run.updated_at.as_ref()))
+        })
+        .then_with(|| left.alias.cmp(&right.alias))
+}
