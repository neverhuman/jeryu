+fn scope_segment(scope: &FleetScope, selected: bool) -> Span<'static> {
+    let status = if scope.counts.failed > 0 {
+        "failed"
+    } else if scope.counts.running > 0 {
+        "running"
+    } else if scope.counts.aged > 0 {
+        "aged"
+    } else {
+        "green"
+    };
+    let label = match &scope.kind {
+        FleetScopeKind::All => {
+            if scope.repo_count == 0 {
+                " All: none ".to_string()
+            } else {
+                format!(
+                    " All repos:{} run:{} fail:{} aged:{} ",
+                    scope.repo_count, scope.counts.running, scope.counts.failed, scope.counts.aged
+                )
+            }
+        }
+        FleetScopeKind::Family { .. } => format!(
+            " {} repos:{} r{} f{} ",
+            scope.label, scope.repo_count, scope.counts.running, scope.counts.failed
+        ),
+        FleetScopeKind::Repo { .. } => {
+            format!(" {} r{} f{} ", scope.label, scope.counts.running, scope.counts.failed)
+        }
+    };
+    segment(label, selected, status)
