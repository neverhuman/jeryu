+/// Registry project identifiers appear in the wild as either GitLab numeric
+/// IDs (`48`) or stable human strings (`"veox-shared"`).  Keep both forms so
+/// the UI can filter GitLab jobs by numeric `project_id` without rejecting old
+/// registries that use string labels only.
+#[derive(Debug, Clone, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(untagged)]
+pub enum ProjectRef {
+    Int(i64),
+    String(String),
+}
+
+impl ProjectRef {
+    fn as_i64(&self) -> Option<i64> {
+        match self {
+            ProjectRef::Int(value) => Some(*value),
+            ProjectRef::String(value) => value.parse::<i64>().ok(),
+        }
+    }
+
+    fn into_string(self) -> String {
+        match self {
+            ProjectRef::Int(value) => value.to_string(),
+            ProjectRef::String(value) => value,
+        }
+    }
+}
