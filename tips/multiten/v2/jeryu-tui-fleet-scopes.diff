+fn scope_sort(left: &FleetScopeSummary, right: &FleetScopeSummary) -> std::cmp::Ordering {
+    right
+        .latest_activity_at
+        .cmp(&left.latest_activity_at)
+        .then_with(|| status_rank(&right.status).cmp(&status_rank(&left.status)))
+        .then_with(|| left.label.cmp(&right.label))
+}
+
+fn repo_sort(left: &FleetRepoSnapshot, right: &FleetRepoSnapshot) -> std::cmp::Ordering {
+    repo_latest_at(right)
+        .cmp(&repo_latest_at(left))
+        .then_with(|| status_rank(&right.status).cmp(&status_rank(&left.status)))
+        .then_with(|| left.alias.cmp(&right.alias))
+}
+
+fn status_rank(status: &str) -> u8 {
+    match status {
+        "running" => 5,
+        "failed" => 4,
+        "dirty" => 3,
+        "aged" => 2,
+        "green" => 1,
+        _ => 0,
+    }
+}
+
+fn repo_latest_at(repo: &FleetRepoSnapshot) -> Option<String> {
+    repo.latest_run.as_ref().and_then(|run| run.updated_at.clone())
+}
+
+fn max_opt_string(left: Option<String>, right: Option<String>) -> Option<String> {
+    match (left, right) {
+        (Some(left), Some(right)) => Some(left.max(right)),
+        (Some(left), None) => Some(left),
+        (None, Some(right)) => Some(right),
+        (None, None) => None,
+    }
+}
+
+fn max_score_badge(left: Option<String>, right: Option<String>) -> Option<String> {
+    match (left.and_then(|s| s.parse::<i64>().ok()), right.and_then(|s| s.parse::<i64>().ok())) {
+        (Some(left), Some(right)) => Some(left.max(right).to_string()),
+        (Some(left), None) => Some(left.to_string()),
+        (None, Some(right)) => Some(right.to_string()),
+        (None, None) => None,
+    }
+}
+
+fn family_prefix(value: &str) -> Option<&str> {
+    let leaf = value.rsplit('/').next().unwrap_or(value);
+    let (prefix, suffix) = leaf.split_once('-')?;
+    if prefix.is_empty() || suffix.is_empty() { None } else { Some(prefix) }
+}
+
+pub fn repo_family_prefix(repo: &FleetRepoSnapshot) -> Option<&str> {
+    family_prefix(&repo.alias).or_else(|| family_prefix(&repo.slug))
+}
+
+pub fn repo_matches_family(repo: &FleetRepoSnapshot, prefix: &str) -> bool {
+    matches_family(prefix, Some(&repo.alias), Some(&repo.slug))
+}
+
+pub fn matches_family(prefix: &str, alias: Option<&str>, slug: Option<&str>) -> bool {
+    [alias, slug]
+        .into_iter()
+        .flatten()
+        .any(|value| family_prefix(value) == Some(prefix))
+}
 
