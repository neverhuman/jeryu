+    pub fn scope_entries(&self, drilled_family: Option<&str>) -> Vec<FleetScopeSummary> {
+        if let Some(prefix) = drilled_family {
+            return self.family_scope_entries(prefix);
+        }
+
+        let mut grouped: BTreeMap<String, Vec<usize>> = BTreeMap::new();
+        let mut grouped_indices: BTreeSet<usize> = BTreeSet::new();
+        for (idx, repo) in self.repos.iter().enumerate() {
+            if let Some(prefix) = family_prefix(&repo.alias).or_else(|| family_prefix(&repo.slug)) {
+                grouped.entry(prefix.to_string()).or_default().push(idx);
+            }
+        }
+
+        let mut scopes = vec![self.aggregate_scope(FleetScopeKind::All, "all", "All", 0..self.repos.len())];
+
+        for (prefix, indices) in grouped {
+            if indices.len() < 2 {
+                continue;
+            }
+            grouped_indices.extend(indices.iter().copied());
+            scopes.push(self.scope_from_indices(
+                FleetScopeKind::Family,
+                &prefix,
+                &format!("{}-*", prefix),
+                indices,
+            ));
+        }
+
+        for (idx, repo) in self.repos.iter().enumerate() {
+            if !grouped_indices.contains(&idx) {
+                scopes.push(self.scope_from_indices(
+                    FleetScopeKind::Repo,
+                    &repo.alias,
+                    &repo.alias,
+                    vec![idx],
+                ));
+            }
+        }
+
+        scopes[1..].sort_by(scope_sort);
+        scopes
+    }
+
+    fn family_scope_entries(&self, prefix: &str) -> Vec<FleetScopeSummary> {
+        let mut indices = self
+            .repos
+            .iter()
+            .enumerate()
+            .filter_map(|(idx, repo)| {
+                if repo_matches_family(repo, prefix) {
+                    Some(idx)
+                } else {
+                    None
+                }
+            })
+            .collect::<Vec<_>>();
+
+        indices.sort_by(|left, right| repo_sort(&self.repos[*left], &self.repos[*right]));
+
+        let mut scopes = vec![self.scope_from_indices(
+            FleetScopeKind::Family,
+            prefix,
+            &format!("{}-*", prefix),
+            indices.clone(),
+        )];
+        for idx in indices {
+            let repo = &self.repos[idx];
+            scopes.push(self.scope_from_indices(
+                FleetScopeKind::Repo,
+                &repo.alias,
+                &repo.alias,
+                vec![idx],
+            ));
+        }
+        scopes
+    }
+
+    pub fn scope_count(&self, drilled_family: Option<&str>) -> usize {
+        self.scope_entries(drilled_family).len()
+    }
+
+    fn aggregate_scope(
+        &self,
+        kind: FleetScopeKind,
+        key: &str,
+        label: &str,
+        indices: std::ops::Range<usize>,
+    ) -> FleetScopeSummary {
+        self.scope_from_indices(kind, key, label, indices.collect())
+    }
+
+    fn scope_from_indices(
+        &self,
+        kind: FleetScopeKind,
+        key: &str,
+        label: &str,
+        repo_indices: Vec<usize>,
+    ) -> FleetScopeSummary {
+        let mut running = 0;
+        let mut failed = 0;
+        let mut aged = 0;
+        let mut latest_activity_at = None;
+        let mut score_badge = None;
+
+        for idx in &repo_indices {
+            let repo = &self.repos[*idx];
+            running += repo.running_count;
+            failed += repo.failed_count;
+            aged += u32::from(repo.stale);
+            latest_activity_at = max_opt_string(latest_activity_at, repo_latest_at(repo));
+            score_badge = max_score_badge(score_badge, repo.score_badge.clone());
+        }
+
+        let status = if failed > 0 {
+            "failed"
+        } else if running > 0 {
+            "running"
+        } else if aged > 0 {
+            "aged"
+        } else if repo_indices
+            .iter()
+            .any(|idx| self.repos[*idx].status.as_str() == "dirty")
+        {
+            "dirty"
+        } else if repo_indices
+            .iter()
+            .all(|idx| self.repos[*idx].status.as_str() == "green")
+        {
+            "green"
+        } else {
+            "local"
+        }
+        .to_string();
+
+        FleetScopeSummary {
+            kind,
+            key: key.to_string(),
+            label: label.to_string(),
+            repo_indices,
+            running_count: running,
+            failed_count: failed,
+            aged_count: aged,
+            status,
+            score_badge,
+            latest_activity_at,
+        }
+    }
 }
 
