+fn repo_sort_key(repo: &FleetRepoSnapshot) -> (u8, String) {
+    // Live or broken work first, then newest observed run. This gives the TUI a
+    // stable "what changed most recently / what needs attention" ordering.
+    let urgency = match repo.status.as_str() {
+        "failed" => 5,
+        "running" => 4,
+        "dirty" => 3,
+        "green" | "success" => 2,
+        "local" => 1,
+        _ => 0,
+    };
+    (
+        urgency,
+        repo.last_observed_at.clone().unwrap_or_else(|| "".into()),
+    )
+}
+
+pub fn repo_family_key_from_alias_slug(alias: &str, slug: &str) -> Option<String> {
+    family_key_from_name(alias).or_else(|| {
+        slug.rsplit('/')
+            .next()
+            .and_then(family_key_from_name)
+    })
+}
+
+fn family_key_from_name(name: &str) -> Option<String> {
+    let (prefix, suffix) = name.split_once('-')?;
+    if prefix.is_empty() || suffix.is_empty() {
+        return None;
+    }
+    Some(format!("{prefix}-*"))
+}
+
+fn build_family_snapshots(repos: &[FleetRepoSnapshot]) -> Vec<RepoFamilySnapshot> {
+    let mut grouped: std::collections::BTreeMap<String, Vec<usize>> = std::collections::BTreeMap::new();
+    for (idx, repo) in repos.iter().enumerate() {
+        if let Some(key) = repo.family_key.as_ref() {
+            grouped.entry(key.clone()).or_default().push(idx);
+        }
+    }
+
+    let mut families = grouped
+        .into_iter()
+        .filter(|(_, indices)| indices.len() > 1)
+        .map(|(key, indices)| {
+            let running_count = indices
+                .iter()
+                .filter_map(|idx| repos.get(*idx))
+                .map(|repo| repo.running_count)
+                .sum();
+            let failed_count = indices
+                .iter()
+                .filter_map(|idx| repos.get(*idx))
+                .map(|repo| repo.failed_count)
+                .sum();
+            let stale_count = indices
+                .iter()
+                .filter_map(|idx| repos.get(*idx))
+                .filter(|repo| repo.stale)
+                .count() as u32;
+            let last_observed_at = indices
+                .iter()
+                .filter_map(|idx| repos.get(*idx))
+                .filter_map(|repo| repo.last_observed_at.clone())
+                .max();
+            RepoFamilySnapshot {
+                label: key.clone(),
+                key,
+                repo_indices: indices,
+                running_count,
+                failed_count,
+                stale_count,
+                last_observed_at,
+            }
+        })
+        .collect::<Vec<_>>();
+    families.sort_by(|left, right| {
+        right
+            .last_observed_at
+            .cmp(&left.last_observed_at)
+            .then_with(|| right.failed_count.cmp(&left.failed_count))
+            .then_with(|| right.running_count.cmp(&left.running_count))
+            .then_with(|| left.key.cmp(&right.key))
+    });
+    families
+}
+
+fn deserialize_project_id<'de, D>(deserializer: D) -> std::result::Result<Option<String>, D::Error>
+where
+    D: Deserializer<'de>,
+{
+    let value: Option<toml::Value> = Option::deserialize(deserializer)?;
+    Ok(value.and_then(|value| match value {
+        toml::Value::String(s) => Some(s),
+        toml::Value::Integer(i) => Some(i.to_string()),
+        _ => None,
+    }))
+}
 
