+    /// Top-level navigator: ALL, family groups (`veox-*`), then standalone
+    /// repos.  Everything after ALL is sorted by recent activity and pressure
+    /// so the hottest work is easiest to arrow into.
+    pub fn top_level_scopes(&self) -> Vec<FleetScopeItem> {
+        let mut items = vec![FleetScopeItem::all(self)];
+        let mut families: std::collections::BTreeMap<String, Vec<usize>> = Default::default();
+        let mut standalone = Vec::new();
+
+        for (idx, repo) in self.repos.iter().enumerate() {
+            match repo.family.as_deref() {
+                Some(family) => families.entry(family.to_string()).or_default().push(idx),
+                None => standalone.push(idx),
+            }
+        }
+
+        for (family, indices) in families {
+            let rollup = self.rollup_for_indices(&indices);
+            items.push(FleetScopeItem {
+                kind: FleetScopeKind::Family,
+                label: family.clone(),
+                family: Some(family),
+                repo_index: None,
+                status: scope_status(&rollup),
+                rollup,
+                cache_namespace: None,
+                data_namespace: None,
+            });
+        }
+
+        for idx in standalone {
+            items.push(self.repo_scope(idx));
+        }
+
+        items[1..].sort_by(|a, b| scope_order_key(b).cmp(&scope_order_key(a)));
+        items
+    }
+
+    /// Family drilldown navigator: first row watches the whole family, then
+    /// individual repos sorted by most recent activity.
+    pub fn drilldown_scopes(&self, family: &str) -> Vec<FleetScopeItem> {
+        let mut indices = self
+            .repos
+            .iter()
+            .enumerate()
+            .filter_map(|(idx, repo)| (repo.family.as_deref() == Some(family)).then_some(idx))
+            .collect::<Vec<_>>();
+        let rollup = self.rollup_for_indices(&indices);
+        let mut items = vec![FleetScopeItem {
+            kind: FleetScopeKind::Family,
+            label: format!("{family} · ALL"),
+            family: Some(family.to_string()),
+            repo_index: None,
+            status: scope_status(&rollup),
+            rollup,
+            cache_namespace: None,
+            data_namespace: None,
+        }];
+        indices.sort_by(|a, b| repo_order_key(&self.repos[*b]).cmp(&repo_order_key(&self.repos[*a])));
+        items.extend(indices.into_iter().map(|idx| self.repo_scope(idx)));
+        items
+    }
+
+    pub fn scope_items(&self, family_drill: Option<&str>) -> Vec<FleetScopeItem> {
+        match family_drill {
+            Some(family) => self.drilldown_scopes(family),
+            None => self.top_level_scopes(),
+        }
+    }
+
+    pub fn scope_count(&self, family_drill: Option<&str>) -> usize {
+        self.scope_items(family_drill).len()
+    }
+
+    pub fn scope_at(&self, family_drill: Option<&str>, index: usize) -> Option<FleetScopeItem> {
+        self.scope_items(family_drill).into_iter().nth(index)
+    }
+
+    pub fn repo_scope(&self, idx: usize) -> FleetScopeItem {
+        let repo = &self.repos[idx];
+        let rollup = FleetScopeRollup {
+            repo_count: 1,
+            running_count: repo.running_count,
+            failed_count: repo.failed_count,
+            aged_count: u32::from(repo.stale),
+            latest_activity_at: repo.last_activity_at.clone(),
+            utilization_pressure: repo.utilization_pressure,
+        };
+        FleetScopeItem {
+            kind: FleetScopeKind::Repo,
+            label: repo.alias.clone(),
+            family: repo.family.clone(),
+            repo_index: Some(idx),
+            status: repo.status.clone(),
+            rollup,
+            cache_namespace: Some(repo.cache_namespace.clone()),
+            data_namespace: Some(repo.data_namespace.clone()),
+        }
+    }
+
+    fn rollup_for_indices(&self, indices: &[usize]) -> FleetScopeRollup {
+        let mut rollup = FleetScopeRollup::default();
+        rollup.repo_count = indices.len();
+        for idx in indices {
+            let repo = &self.repos[*idx];
+            rollup.running_count += repo.running_count;
+            rollup.failed_count += repo.failed_count;
+            rollup.aged_count += u32::from(repo.stale);
+            rollup.utilization_pressure = rollup.utilization_pressure.max(repo.utilization_pressure);
+            if repo.last_activity_at > rollup.latest_activity_at {
+                rollup.latest_activity_at = repo.last_activity_at.clone();
+            }
+        }
+        rollup
+    }
 }
